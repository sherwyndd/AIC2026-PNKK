# ============================================================
# AIC_2026 — .gitignore
# ============================================================

# ---------- Python Bytecode & Cache ----------
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
*.egg-info/
*.egg
.eggs/

# ---------- Python Virtual Environments ----------
.venv/
.venv
venv/
env/
.python-version

# ---------- Testing & LSP Cache ----------
.pytest_cache/
.coverage
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# ---------- Node / Frontend Build ----------
node_modules/
dist/
build/
.next/
.vite/

# ---------- Model Weights & Heavy Assets ----------
*.pt
*.pth
*.ckpt
*.safetensors
*.bin
*.onnx
*.engine
*.weights

# ---------- Large Datasets & Media ----------
dataset/
data/
keyframes/
videos/
outputs/
results/
tmp/
temp/

# Binary data & Embeddings
*.npy
*.npz
*.parquet
*.mp4
*.avi
*.mkv
*.jpg
*.jpeg
*.png
*.webp

# ---------- Logs & Databases ----------
logs/
*.log
*.sqlite
*.sqlite3
.qdrant/
storage/

# ---------- Environment & Secrets ----------
.env
.env.*
!.env.example
secrets/
*.pem

# ---------- IDE & OS ----------
.vscode/
.idea/
.DS_Store
Thumbs.db

# ---------- Exceptions ----------
!configs/*.yaml
!configs/*.yml
!configs/*.json
!*.md
!environment.yml
