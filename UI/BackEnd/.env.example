# DRES (Distributed Retrieval Evaluation Server) Configuration
DRES_BASE_URL=http://192.168.28.151:5000
DRES_USERNAME=your_team_username
DRES_PASSWORD=your_team_password
DRES_TIMEOUT=10.0
DRES_RETRY_COUNT=1

# Explicit run selection (optional). Priority: DRES_RUN_ID > DRES_RUN_NAME > auto.
# Leave empty for auto-selection (backward-compatible).
#
# Examples:
#   DRES_RUN_ID=b369af71-b8e6-42af-99c1-448fb5884b29   # exact UUID match
#   DRES_RUN_NAME=system_test                            # exact name match
DRES_RUN_ID=
DRES_RUN_NAME=
