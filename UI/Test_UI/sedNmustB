    /**
     * 3.2. FrameChainThumbnail:
     * Thumbnail đơn lẻ trong frame_chain.
     * Xử lý trường hợp missing frame (khung xám ?, disabled click).
     */
    function FrameChainThumbnail({
      frame,
      stageIndex,
      onSelectFrame,
      rankingKeyframeIds = new Set(),
      notedKeyframeIds = new Set(),
      kisKeyframeIds = new Set(),
      qaKeyframeIds = new Set(),
      onAddToKisRanking,
      onAddToQaRanking,
      showToast
    }) {
      const isMissing = frame.frame_idx === null || frame.timestamp === null;
      const [showVqa, setShowVqa] = React.useState(false);
      const [vqaAnswer, setVqaAnswer] = React.useState('');
      const [vqaStatus, setVqaStatus] = React.useState('idle');

      // Missing frame placeholder
      if (isMissing) {
        return (
          <div className="shrink-0 flex flex-col items-center">
            <div
              className="w-32 md:w-36 aspect-video rounded-xl bg-slate-100 border-2 border-dashed border-slate-300 flex flex-col items-center justify-center text-slate-400 select-none cursor-not-allowed shadow-inner"
              title={`Stage ${stageIndex + 1} bị missing (không tìm thấy candidate thỏa thứ tự thời gian)`}
            >
              <span className="absolute top-1 left-1 w-4 h-4 rounded bg-amber-500 text-white text-[9px] font-bold flex items-center justify-center">{stageIndex + 1}</span>
              <Icon name="help-circle" className="w-6 h-6 text-slate-300 mb-0.5" />
              <span className="text-[10px] font-bold text-slate-500">Không tìm thấy</span>
              <span className="text-[9px] text-slate-400 font-mono">-0.30</span>
            </div>
          </div>
        );
      }

      // Valid frame thumbnail
      const rawImgUrl = frame.image_url || (frame.image_path ? `/images/${frame.image_path}` : '');
      const fullImgUrl = rawImgUrl.startsWith('http')
        ? rawImgUrl
        : `http://${window.location.hostname}:8888${rawImgUrl.startsWith('/') ? '' : '/'}${rawImgUrl}`;

      const formattedTs = frame.timestamp !== null && frame.timestamp !== undefined
        ? `${frame.timestamp.toFixed(1)}s`
        : '0.0s';

      const isRanked = frame.keyframe_id && rankingKeyframeIds.has(frame.keyframe_id);
      const isNoted = frame.keyframe_id && notedKeyframeIds.has(frame.keyframe_id);
      const isKisRanked = frame.keyframe_id && kisKeyframeIds.has(frame.keyframe_id);
      const isQaRanked = frame.keyframe_id && qaKeyframeIds.has(frame.keyframe_id);

      const frameItem = {
        id: frame.keyframe_id || `${frame.video_id}_${frame.frame_idx}`,
        keyframe_id: frame.keyframe_id,
        videoId: frame.video_id,
        videoTitle: frame.video_id,
        frameId: frame.frame_idx,
        timestamp: Math.round((Number(frame.timestamp) || 0) * 1000),
        pts_time: Number(frame.timestamp) || 0,
        thumbnailUrl: fullImgUrl,
        score: frame.score || 0,
        rank: stageIndex + 1,
        matchedSources: ['temporal', `Stage ${stageIndex + 1}`],
        caption: `${frame.video_id} - Frame ${frame.frame_idx} (Stage ${stageIndex + 1})`,
      };

      const submitStageVqa = async (e) => {
        e.stopPropagation();
        if (!vqaAnswer.trim() || vqaStatus === 'submitting') return;
        setVqaStatus('submitting');
        try {
          const res = await fetch(`${window.location.protocol}//${window.location.hostname}:8888/api/dres/submit`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              video_id: String(frame.video_id),
              timestamp: frameItem.timestamp,
              timestamp_ms: frameItem.timestamp,
              answer: vqaAnswer.trim(),
              mode: 'vqa',
            }),
          });
          const data = await res.json();
          if (!res.ok || data.status === false) throw new Error(data.detail || data.description || 'VQA submit failed');
          setVqaStatus('success');
          if (showToast) showToast(`Đã submit VQA cho Stage ${stageIndex + 1}`, 'success');
        } catch (err) {
          setVqaStatus('error');
          if (showToast) showToast(err.message || 'VQA submit failed', 'error');
        }
      };

      return (
        <div className="shrink-0 flex flex-col items-center">
          <div
            onClick={(e) => { e.stopPropagation(); onSelectFrame(frame); }}
