      { id: "res-3", rank: 3, videoId: "L02_V001", videoTitle: "Ẩm thực đường phố", frameId: "500", timestamp: "00:20:00", score: 0.85, matchedType: "asr", caption: "Người phụ nữ đang chuẩn bị nguyên liệu nấu ăn", thumbnailUrl: "https://images.unsplash.com/photo-1556910103-1c02745aae4d?w=600&auto=format&fit=crop&q=80" },
