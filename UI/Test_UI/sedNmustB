          // Evict least recently used (first key in map)
          const oldestKey = this.cache.keys().next().value;
          const oldestVal = this.cache.get(oldestKey);
          if (oldestVal && oldestVal.blobUrl) {
            try { URL.revokeObjectURL(oldestVal.blobUrl); } catch (e) { }
          }
          this.cache.delete(oldestKey);
        }
        this.cache.set(key, { ...value, timestamp: Date.now() });
      }

      clear() {
        for (const [k, v] of this.cache.entries()) {
          if (v && v.blobUrl) {
            try { URL.revokeObjectURL(v.blobUrl); } catch (e) { }
          }
