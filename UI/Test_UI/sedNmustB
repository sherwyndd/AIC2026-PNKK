                  <span className="text-[10px] bg-white/20 px-1.5 py-0.5 rounded font-mono font-normal">Enter</span>
                </>
              )}
            </button>
          </div>
        </aside>
      );
    }

    // Helper to get color classes for events (E1, E2, E3...)
    function getEventColor(eventId, type = 'badge') {
      const idx = parseInt(String(eventId).replace(/\D/g, '') || '1', 10) - 1;
      const palette = [
        { badge: 'bg-indigo-600 text-white', ring: 'ring-indigo-500', text: 'text-indigo-600', border: 'border-indigo-300', bg: 'bg-indigo-50', dot: '#4f46e5' },
        { badge: 'bg-emerald-600 text-white', ring: 'ring-emerald-500', text: 'text-emerald-600', border: 'border-emerald-300', bg: 'bg-emerald-50', dot: '#059669' },
        { badge: 'bg-amber-500 text-white', ring: 'ring-amber-500', text: 'text-amber-600', border: 'border-amber-300', bg: 'bg-amber-50', dot: '#d97706' },
        { badge: 'bg-purple-600 text-white', ring: 'ring-purple-500', text: 'text-purple-600', border: 'border-purple-300', bg: 'bg-purple-50', dot: '#9333ea' },
        { badge: 'bg-rose-600 text-white', ring: 'ring-rose-500', text: 'text-rose-600', border: 'border-rose-300', bg: 'bg-rose-50', dot: '#e11d48' },
        { badge: 'bg-cyan-600 text-white', ring: 'ring-cyan-500', text: 'text-cyan-600', border: 'border-cyan-300', bg: 'bg-cyan-50', dot: '#0891b2' },
      ];
      return palette[idx % palette.length];
    }

    function TrakeResultGrid({ results, isSearching, error, onClearError, onSelectVideo, onSelectKeyframe, rankingKeyframeIds = new Set(), notedKeyframeIds = new Set(), trakeVideoIds = new Set(), onAddToRanking, onNoteImage, showToast }) {
      const handleAddVideoToRanking = (vidResult, e) => {
        if (e) e.stopPropagation();
        if (!onAddToRanking || !vidResult) return;
        onAddToRanking(vidResult);
        if (showToast) showToast(`Đã thêm chuỗi sự kiện của video ${vidResult.video_id} vào TRAKE Ranking!`, 'success');
      };

      const handleAddVideoToNote = (vidResult, e) => {
        if (e) e.stopPropagation();
        if (!onNoteImage || !vidResult || !vidResult.timeline) return;
        let count = 0;
        vidResult.timeline.forEach((f, idx) => {
          onNoteImage({
            id: f.keyframe_id || `${vidResult.video_id}_${f.frame_idx}`,
            keyframe_id: f.keyframe_id,
            videoId: vidResult.video_id,
            videoTitle: vidResult.video_id,
            frameId: f.frame_idx,
            timestamp: f.timestamp,
            pts_time: (f.timestamp || 0) / 1000,
            thumbnailUrl: `http://${window.location.hostname}:8888/images/${f.image_path}`,
            score: f.score || vidResult.global_score || 0,
            rank: idx + 1,
            matchedSources: ['trake', f.event_id],
            caption: `${vidResult.video_id} • ${f.event_id} (F#${f.frame_idx})`,
          });
          count++;
        });
        if (showToast) showToast(`Đã lưu ${count} mốc của video ${vidResult.video_id} vào Note!`, 'success');
      };

      const handleAddAllToRanking = () => {
        if (!onAddToRanking || !results || results.length === 0) return;
        results.forEach((vidResult) => {
          onAddToRanking(vidResult);
