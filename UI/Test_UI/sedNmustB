     * 3 Tabs [Text] [OCR] [ASR] phong cách DevTools.
     * Lưu trữ đồng thời cả 3 modality, hiển thị dot indicator khi có text.
     * Enter -> trigger search, Shift+Enter -> xuống dòng.
     */
    function StageTabInput({ stage, onUpdateField, onSearch }) {
      const tabs = [
        { id: 'text', label: 'Text', field: 'text_query', placeholder: 'Mô tả nội dung hình ảnh (semantic SigLIP)...', color: 'sky', icon: 'type' },
        { id: 'ocr', label: 'OCR', field: 'ocr_query', placeholder: 'Chữ / text xuất hiện trong khung hình...', color: 'amber', icon: 'scan-text' },
        { id: 'asr', label: 'ASR', field: 'asr_query', placeholder: 'Lời thoại / âm thanh cần tìm...', color: 'purple', icon: 'mic' },
      ];

      const activeTab = stage.activeTab || 'text';
      const currentTab = tabs.find(t => t.id === activeTab) || tabs[0];
      const currentValue = stage[currentTab.field] || '';

      return (
        <div className="space-y-1.5">
          {/* Horizontal DevTools-style Tabs */}
          <div className="flex items-center gap-1 bg-slate-100/90 p-1 rounded-xl border border-slate-200/80">
            {tabs.map(tab => {
              const isActive = activeTab === tab.id;
              const hasContent = Boolean(stage[tab.field] && stage[tab.field].trim().length > 0);

              let activeClasses = 'text-slate-500 hover:text-slate-700 hover:bg-slate-200/60';
              if (isActive) {
                if (tab.id === 'text') activeClasses = 'bg-white text-sky-700 border-sky-200 shadow-xs font-bold ring-1 ring-sky-300';
                else if (tab.id === 'ocr') activeClasses = 'bg-white text-amber-700 border-amber-200 shadow-xs font-bold ring-1 ring-amber-300';
                else if (tab.id === 'asr') activeClasses = 'bg-white text-purple-700 border-purple-200 shadow-xs font-bold ring-1 ring-purple-300';
              }

              return (
                <button
                  key={tab.id}
                  type="button"
                  onClick={() => onUpdateField('activeTab', tab.id)}
                  className={`flex-1 flex items-center justify-center gap-1.5 py-1 px-1.5 rounded-lg text-xs font-medium transition-all relative border border-transparent ${activeClasses}`}
                >
                  <Icon name={tab.icon} className="w-3 h-3 shrink-0" />
                  <span>{tab.label}</span>
                  {/* Dot Indicator for filled query */}
                  {hasContent && (
                    <span
                      className={`w-1.5 h-1.5 rounded-full shrink-0 shadow-xs ${tab.id === 'text' ? 'bg-sky-500' : tab.id === 'ocr' ? 'bg-amber-500' : 'bg-purple-500'
