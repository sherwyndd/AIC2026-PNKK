            <button type="button" onClick={() => setShowVqa(v => !v)} className={`w-full px-1.5 py-1 rounded-md text-[9px] font-bold border transition-all ${showVqa ? 'bg-purple-600 text-white border-purple-700' : 'bg-purple-50 text-purple-700 border-purple-200 hover:bg-purple-600 hover:text-white'}`}>
