    function loadClipboard() {
      try {
        const raw = localStorage.getItem(CLIPBOARD_KEY);
        if (!raw) return { kisRanking: [], qaRanking: [], trakeRanking: [], savedImages: [], queryHistory: [], noteText: '' };
        const data = JSON.parse(raw);
        let kis = Array.isArray(data.kisRanking) ? data.kisRanking.slice(0, 100) : [];
        let qa = Array.isArray(data.qaRanking) ? data.qaRanking.slice(0, 100) : [];
        let trake = Array.isArray(data.trakeRanking) ? data.trakeRanking.slice(0, 100).map(item => {
          if (!item || typeof item !== 'object') return null;
          return {
            ...item,
            video_id: item.video_id || item.videoId,
            timeline: Array.isArray(item.timeline) ? item.timeline : (item.frameId !== undefined ? [{ event_id: 'E1', frame_idx: Number(item.frameId), timestamp: item.timestamp || 0 }] : [])
          };
        }).filter(Boolean) : [];
        // Migration from old single rankingList
        if (kis.length === 0 && qa.length === 0 && trake.length === 0 && Array.isArray(data.rankingList)) {
          data.rankingList.forEach(item => {
            if (!item || typeof item !== 'object') return;
            if (item.timeline || (item.matchedSources && item.matchedSources.includes('trake'))) {
              trake.push(item);
            } else if (item.answer) {
              qa.push(item);
            } else {
              kis.push(item);
            }
          });
        }
        return {
          kisRanking: kis.slice(0, 100),
          qaRanking: qa.slice(0, 100),
          trakeRanking: trake.slice(0, 100),
          savedImages: Array.isArray(data.savedImages) ? data.savedImages.slice(-MAX_SAVED_IMAGES) : [],
          queryHistory: Array.isArray(data.queryHistory) ? data.queryHistory.slice(0, MAX_QUERY_HISTORY) : [],
          noteText: typeof data.noteText === 'string' ? data.noteText : '',
        };
      } catch {
        return { kisRanking: [], qaRanking: [], trakeRanking: [], savedImages: [], queryHistory: [], noteText: '' };
      }
    }

    function persistClipboard(data) {
      try {
        localStorage.setItem(CLIPBOARD_KEY, JSON.stringify(data));
      } catch (e) {
        console.warn('Không thể lưu Clipboard:', e);
      }
    }

    function makeClipboardId() {
      return `${Date.now()}-${Math.random().toString(36).slice(2, 8)}`;
    }

    function historyFingerprint(entry) {
      return JSON.stringify({ topK: entry.topK, panels: entry.panels });
    }

    function pushQueryHistory(clipboard, entry) {
      const fp = historyFingerprint(entry);
      const history = [entry, ...(clipboard.queryHistory || []).filter((h) => historyFingerprint(h) !== fp)].slice(0, MAX_QUERY_HISTORY);
      return { ...clipboard, queryHistory: history };
    }

    function pushSavedImage(clipboard, image) {
      const kid = image.keyframe_id || image.id;
      if ((clipboard.savedImages || []).some((img) => (img.keyframe_id || img.id) === kid)) {
        return { data: clipboard, added: false };
      }
      let saved = [...(clipboard.savedImages || []), image];
      if (saved.length > MAX_SAVED_IMAGES) saved = saved.slice(-MAX_SAVED_IMAGES);
      return { data: { ...clipboard, savedImages: saved }, added: true };
    }

    function pushKisRanking(clipboard, item) {
      const kid = item.keyframe_id || item.id;
      if (!kid) return { data: clipboard, added: false };
      if ((clipboard.kisRanking || []).some((r) => (r.keyframe_id || r.id) === kid)) {
        return { data: clipboard, added: false };
      }
      let ranked = [...(clipboard.kisRanking || []), { ...item }];
      if (ranked.length > 100) ranked = ranked.slice(0, 100);
      return { data: { ...clipboard, kisRanking: ranked }, added: true };
    }

    function pushQaRanking(clipboard, item) {
      const kid = item.keyframe_id || item.id;
      if (!kid) return { data: clipboard, added: false, updated: false };
      const existingIdx = (clipboard.qaRanking || []).findIndex((r) => (r.keyframe_id || r.id) === kid);
      if (existingIdx >= 0) {
        if (item.answer !== undefined && item.answer !== null) {
          const updated = [...clipboard.qaRanking];
          updated[existingIdx] = { ...updated[existingIdx], ...item, answer: item.answer };
          return { data: { ...clipboard, qaRanking: updated }, added: false, updated: true };
        }
        return { data: clipboard, added: false, updated: false };
      }
      let ranked = [...(clipboard.qaRanking || []), { ...item }];
      if (ranked.length > 100) ranked = ranked.slice(0, 100);
      return { data: { ...clipboard, qaRanking: ranked }, added: true, updated: false };
    }

    function pushTrakeRanking(clipboard, vidResult) {
      const vid = vidResult.video_id || vidResult.videoId;
      if (!vid) return { data: clipboard, added: false, updated: false };
      const existingIdx = (clipboard.trakeRanking || []).findIndex((r) => (r.video_id || r.videoId) === vid);

      const newEntry = {
        ...vidResult,
        video_id: vid,
        timeline: Array.isArray(vidResult.timeline) ? vidResult.timeline : [],
      };

      if (existingIdx >= 0) {
        const updated = [...clipboard.trakeRanking];
        updated[existingIdx] = { ...updated[existingIdx], ...newEntry };
        return { data: { ...clipboard, trakeRanking: updated }, added: false, updated: true };
      }
      let ranked = [...(clipboard.trakeRanking || []), newEntry];
      if (ranked.length > 100) ranked = ranked.slice(0, 100);
      return { data: { ...clipboard, trakeRanking: ranked }, added: true, updated: false };
    }

    function downloadCsvFile(content, filename) {
      const blob = new Blob([content], { type: 'text/csv;charset=utf-8;' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = filename;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
    }

    function buildKisCsv(list) {
      return (list || []).slice(0, 100).map(item => {
        const vid = String(item.videoId || item.video_id || '').replace(/\.mp4$/i, '').trim();
        const fid = parseInt(item.frameId !== undefined ? item.frameId : item.frame_idx, 10) || 0;
        return `${vid},${fid}`;
      }).join('\n');
    }

    function buildQaCsv(list) {
      return (list || []).slice(0, 100).map(item => {
        const vid = String(item.videoId || item.video_id || '').replace(/\.mp4$/i, '').trim();
        const fid = parseInt(item.frameId !== undefined ? item.frameId : item.frame_idx, 10) || 0;
        let ans = String(item.answer || '').trim();
        if (ans.length > 100) ans = ans.slice(0, 100);
        const escaped = ans.replace(/"/g, '""');
        return `${vid},${fid},"${escaped}"`;
      }).join('\n');
    }

    function buildTrakeCsv(list) {
      return (list || []).slice(0, 100).map(item => {
        const vid = String(item.video_id || item.videoId || '').replace(/\.mp4$/i, '').trim();
        let fids = [];
        if (Array.isArray(item.timeline) && item.timeline.length > 0) {
          fids = item.timeline.map(f => parseInt(f.frame_idx !== undefined ? f.frame_idx : (f.frameId || 0), 10));
        } else if (item.frameId !== undefined || item.frame_idx !== undefined) {
          fids = [parseInt(item.frameId !== undefined ? item.frameId : item.frame_idx, 10)];
        }
        return [vid, ...fids].join(',');
      }).join('\n');
    }

    function extractRankingFileName(item) {
      if (!item) return 'Unknown';
      if (item.keyframe_id) return item.keyframe_id;
      if (item.videoId && (item.frameId !== undefined && item.frameId !== '')) return `${item.videoId}_F${item.frameId}`;
      if (item.videoId) return item.videoId;
      if (item.id) return item.id;
      return 'Unknown';
    }

    function formatRelativeTime(iso) {
      if (!iso) return '';
      const t = new Date(iso).getTime();
      if (isNaN(t)) return '';
      const diff = Date.now() - t;
      const sec = Math.floor(diff / 1000);
      if (sec < 45) return 'Vừa xong';
      const min = Math.floor(sec / 60);
      if (min < 60) return `${min} phút trước`;
      const hr = Math.floor(min / 60);
      if (hr < 24) return `${hr} giờ trước`;
      return new Date(iso).toLocaleString('vi-VN', { day: '2-digit', month: '2-digit', hour: '2-digit', minute: '2-digit' });
    }

    function Toast({ message, tone, onClose }) {
      useEffect(() => {
        const t = setTimeout(onClose, 2800);
        return () => clearTimeout(t);
      }, [onClose]);
      const tones = {
        success: 'bg-slate-900 text-white border-slate-700',
        info: 'bg-amber-600 text-white border-amber-500',
        error: 'bg-rose-600 text-white border-rose-500',
      };
      return (
        <div className={`fixed bottom-6 right-6 z-[100] px-4 py-3 rounded-xl shadow-2xl border text-sm font-semibold animate-toast-in flex items-center gap-2 ${tones[tone] || tones.success}`}>
          <Icon name={tone === 'success' ? 'check-circle' : tone === 'error' ? 'x-circle' : 'bookmark'} className="w-4 h-4 shrink-0" />
          <span>{message}</span>
        </div>
      );
    }

