  </div>
  <script>
    window.addEventListener('error', function (e) {
      var box = document.getElementById('global-error-banner');
      if (box) {
        box.style.display = 'block';
        box.textContent = '❌ Lỗi JavaScript / Babel:\n' + (e.message || e.error || e) + '\n\nFile: ' + e.filename + ' (Dòng: ' + e.lineno + ', Cột: ' + e.colno + ')\n\n' + (e.error && e.error.stack ? e.error.stack : '');
      }
    });
    window.addEventListener('unhandledrejection', function (e) {
      var box = document.getElementById('global-error-banner');
      if (box) {
        box.style.display = 'block';
        box.textContent = '❌ Lỗi Promise Rejection:\n' + (e.reason ? (e.reason.stack || e.reason.message || e.reason) : e);
      }
    });
