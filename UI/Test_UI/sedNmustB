            <textarea
              rows={2}
              value={currentValue}
              onChange={(e) => onUpdateField(currentTab.field, e.target.value)}
              onKeyDown={(e) => {
                if (e.key === 'Enter' && !e.shiftKey) {
                  e.preventDefault();
                  onSearch();
                }
              }}
              placeholder={currentTab.placeholder}
              className="w-full text-xs font-medium text-slate-800 bg-white border border-slate-200 rounded-xl p-2.5 outline-none focus:border-emerald-500 focus:ring-2 focus:ring-emerald-100 transition-all resize-none placeholder:text-slate-400 placeholder:font-normal leading-relaxed"
            />
            {currentValue && (
              <button
                type="button"
                onClick={() => onUpdateField(currentTab.field, '')}
                className="absolute top-2 right-2 text-slate-400 hover:text-slate-600 p-0.5 rounded-md hover:bg-slate-100"
                title="Xóa nội dung tab này"
              >
                <Icon name="x" className="w-3 h-3" />
              </button>
            )}
          </div>
        </div>
      );
    }

    /**
     * 1.1. & 1.3. StageCard:
     * Header đánh số tự động "Stage X", nút xóa, click collapse/expand.
     * Section Advanced: slider trọng số cho tab có query, input max gap.
     */
    function StageCard({
      stage,
      stageIndex,
      totalStages,
      onUpdateStage,
      onRemoveStage,
      onSearch
    }) {
      const [showAdvanced, setShowAdvanced] = React.useState(false);
      const isCollapsed = Boolean(stage.collapsed);

      const hasText = Boolean(stage.text_query && stage.text_query.trim().length > 0);
      const hasOcr = Boolean(stage.ocr_query && stage.ocr_query.trim().length > 0);
      const hasAsr = Boolean(stage.asr_query && stage.asr_query.trim().length > 0);
      const isLastStage = stageIndex === totalStages - 1;

      const handleFieldChange = (field, value) => {
        onUpdateStage(stage.id, { ...stage, [field]: value });
      };

      return (
        <div
          id={`stage-card-${stage.id}`}
          className={`bg-white border rounded-2xl transition-all shadow-xs overflow-hidden ${isCollapsed
            ? 'border-slate-200 hover:border-slate-300'
            : 'border-slate-300 ring-1 ring-emerald-500/20 shadow-sm'
            }`}
        >
          {/* Card Header */}
          <div
            onClick={() => handleFieldChange('collapsed', !isCollapsed)}
            className="flex items-center justify-between px-3.5 py-2.5 bg-slate-50/90 hover:bg-slate-100/80 cursor-pointer select-none transition-colors border-b border-slate-100"
          >
            <div className="flex items-center gap-2">
              <span className="w-6 h-6 rounded-lg bg-emerald-600 text-white text-xs font-bold flex items-center justify-center shadow-xs">
                {stageIndex + 1}
              </span>
              <span className="font-bold text-xs text-slate-800 tracking-tight">
                Stage {stageIndex + 1}
              </span>

              {/* Modality Filled Badges */}
              <div className="flex items-center gap-1 ml-1">
                {hasText && (
                  <span className="px-1.5 py-0.5 rounded-md bg-sky-100 text-sky-800 text-[10px] font-bold border border-sky-200">
                    Text
                  </span>
                )}
                {hasOcr && (
                  <span className="px-1.5 py-0.5 rounded-md bg-amber-100 text-amber-800 text-[10px] font-bold border border-amber-200">
                    OCR
                  </span>
                )}
                {hasAsr && (
                  <span className="px-1.5 py-0.5 rounded-md bg-purple-100 text-purple-800 text-[10px] font-bold border border-purple-200">
                    ASR
                  </span>
                )}
                {!hasText && !hasOcr && !hasAsr && (
                  <span className="text-[10px] text-slate-400 italic">Chưa nhập query</span>
                )}
              </div>
            </div>

            <div className="flex items-center gap-1">
              {/* Collapse/Expand Toggle Icon */}
              <div className="p-1 text-slate-400 hover:text-slate-600 rounded-md">
                <Icon name={isCollapsed ? 'chevron-down' : 'chevron-up'} className="w-3.5 h-3.5" />
              </div>

              {/* Delete Stage Button */}
              <button
                type="button"
                onClick={(e) => {
                  e.stopPropagation();
                  onRemoveStage(stage.id);
                }}
                className="p-1 text-slate-400 hover:text-rose-600 hover:bg-rose-50 rounded-lg transition-colors"
                title="Xóa stage này"
              >
                <Icon name="x" className="w-3.5 h-3.5" />
              </button>
            </div>
          </div>

          {/* Card Body */}
          {!isCollapsed && (
            <div className="p-3 space-y-3">
              {/* 3 Modality Tabs + Active Textarea */}
              <StageTabInput
                stage={stage}
                onUpdateField={handleFieldChange}
                onSearch={onSearch}
              />

              {/* Advanced Collapsible Section */}
              <div className="border-t border-slate-100 pt-2">
                <button
                  type="button"
                  onClick={() => setShowAdvanced(prev => !prev)}
                  className="flex items-center justify-between w-full text-[11px] font-semibold text-slate-500 hover:text-slate-700 py-1"
                >
                  <span className="flex items-center gap-1">
                    <Icon name="sliders" className="w-3 h-3 text-slate-400" />
                    <span>Advanced (Trọng số &amp; Ràng buộc)</span>
                  </span>
                  <Icon name={showAdvanced ? 'chevron-up' : 'chevron-down'} className="w-3 h-3" />
                </button>

                {showAdvanced && (
                  <div className="space-y-2.5 pt-2 pb-1 bg-slate-50/70 rounded-xl p-2.5 mt-1 border border-slate-200/60 animate-fade-in">
                    {/* Weights (ONLY render for tabs with non-empty query) */}
                    {hasText && (
                      <div className="space-y-1">
                        <div className="flex items-center justify-between text-[11px] font-medium text-slate-700">
                          <span className="text-sky-700 font-semibold flex items-center gap-1">
                            <span className="w-1.5 h-1.5 rounded-full bg-sky-500"></span>
                            Trọng số Text:
                          </span>
                          <span className="font-mono font-bold bg-white px-1.5 py-0.5 rounded border text-[10px]">
                            {Number(stage.weight_text ?? 1.0).toFixed(1)}
                          </span>
                        </div>
                        <input
                          type="range"
                          min="0"
                          max="3"
                          step="0.1"
                          value={stage.weight_text ?? 1.0}
                          onChange={(e) => handleFieldChange('weight_text', parseFloat(e.target.value))}
                          className="w-full h-1.5 bg-slate-200 rounded-lg appearance-none cursor-pointer accent-sky-600"
                        />
                      </div>
                    )}

                    {hasOcr && (
                      <div className="space-y-1">
                        <div className="flex items-center justify-between text-[11px] font-medium text-slate-700">
                          <span className="text-amber-700 font-semibold flex items-center gap-1">
                            <span className="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
                            Trọng số OCR:
                          </span>
                          <span className="font-mono font-bold bg-white px-1.5 py-0.5 rounded border text-[10px]">
                            {Number(stage.weight_ocr ?? 1.0).toFixed(1)}
                          </span>
                        </div>
                        <input
                          type="range"
                          min="0"
                          max="3"
                          step="0.1"
                          value={stage.weight_ocr ?? 1.0}
                          onChange={(e) => handleFieldChange('weight_ocr', parseFloat(e.target.value))}
                          className="w-full h-1.5 bg-slate-200 rounded-lg appearance-none cursor-pointer accent-amber-600"
                        />
                      </div>
                    )}

                    {hasAsr && (
                      <div className="space-y-1">
                        <div className="flex items-center justify-between text-[11px] font-medium text-slate-700">
                          <span className="text-purple-700 font-semibold flex items-center gap-1">
                            <span className="w-1.5 h-1.5 rounded-full bg-purple-500"></span>
                            Trọng số ASR:
                          </span>
                          <span className="font-mono font-bold bg-white px-1.5 py-0.5 rounded border text-[10px]">
                            {Number(stage.weight_asr ?? 1.0).toFixed(1)}
                          </span>
                        </div>
                        <input
                          type="range"
                          min="0"
                          max="3"
                          step="0.1"
                          value={stage.weight_asr ?? 1.0}
                          onChange={(e) => handleFieldChange('weight_asr', parseFloat(e.target.value))}
                          className="w-full h-1.5 bg-slate-200 rounded-lg appearance-none cursor-pointer accent-purple-600"
                        />
                      </div>
                    )}

                    {!hasText && !hasOcr && !hasAsr && (
                      <p className="text-[10px] text-slate-400 italic">
                        Điền ít nhất 1 tab Text / OCR / ASR để chỉnh trọng số.
                      </p>
                    )}

                    {/* Max gap to next stage (ONLY visible if NOT last stage) */}
                    {!isLastStage && (
                      <div className="pt-2 border-t border-slate-200/60 space-y-1">
                        <label className="text-[11px] font-semibold text-slate-700 flex items-center justify-between">
                          <span>Khoảng cách tối đa tới Stage {stageIndex + 2} (giây):</span>
                        </label>
                        <input
                          type="number"
                          min="1"
                          step="5"
                          value={stage.max_gap_seconds ?? ''}
                          onChange={(e) => {
                            const val = e.target.value === '' ? null : Math.max(1, parseFloat(e.target.value));
                            handleFieldChange('max_gap_seconds', val);
                          }}
                          placeholder="Không giới hạn (vd: 120)"
                          className="w-full text-xs bg-white border border-slate-200 rounded-lg px-2.5 py-1.5 outline-none focus:border-emerald-500 focus:ring-1 focus:ring-emerald-200"
                        />
                      </div>
                    )}
                  </div>
                )}
              </div>
            </div>
          )}
        </div>
      );
    }

    /**
     * 1.4. GlobalContextInput:
     * Ô bối cảnh chung toàn video đặt trên cùng, style riêng biệt.
     */
    function GlobalContextInput({
