        >
          {/* Row Header: Rank, Video ID, Global Score, Context Bonus, Missing Stats, Open Inspector Button */}
          <div className="flex flex-wrap items-center justify-between gap-2 pb-2.5 border-b border-slate-100">
            <div className="flex flex-wrap items-center gap-2">
              <span className="w-7 h-7 rounded-xl bg-gradient-to-br from-emerald-600 to-teal-700 text-white font-bold text-xs flex items-center justify-center shadow-xs">
                #{rankIndex + 1}
              </span>
              <span className="text-xs font-bold text-slate-900 font-mono bg-slate-100 border border-slate-200 px-2.5 py-1 rounded-lg">
                {vidResult.video_id}
              </span>

              {/* Global Score (4 decimal places) */}
              <span className="text-xs font-bold text-emerald-800 bg-emerald-50 border border-emerald-200 px-2.5 py-1 rounded-lg flex items-center gap-1 shadow-xs">
                <Icon name="sparkles" className="w-3.5 h-3.5 text-emerald-600" />
                <span>Score: <strong className="font-mono">{vidResult.global_score.toFixed(4)}</strong></span>
              </span>

              {/* Context Bonus (if > 0) */}
              {vidResult.context_bonus > 0 && (
                <span className="text-[10px] font-bold text-teal-800 bg-teal-50 border border-teal-200 px-2 py-0.5 rounded-lg flex items-center gap-1">
                  <span>Bonus:</span>
                  <strong className="font-mono">{vidResult.context_bonus.toFixed(4)}</strong>
