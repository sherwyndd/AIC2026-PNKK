      { id: 'ocr', label: 'OCR', iconName: 'scan-text', placeholder: 'Tìm theo văn bản trong ảnh...' },
    ];

    const CLIPBOARD_KEY = 'aic2026_clipboard';
    const MAX_QUERY_HISTORY = 15;
    const MAX_SAVED_IMAGES = 30;
