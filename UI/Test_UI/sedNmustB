        if (this.cache.has(key)) {
          const old = this.cache.get(key);
          if (old.blobUrl && old.blobUrl !== value.blobUrl) {
            try { URL.revokeObjectURL(old.blobUrl); } catch (e) { }
          }
          this.cache.delete(key);
