        const activeCard = stripRef.current?.querySelector(`[data-keyframe-index="${currentIndex}"]`);
        activeCard?.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
      }, [currentIndex, startIdx, endIdx]);

      // Manual retry handler for failed image cards
      const handleRetryCard = (e, cardKey, cardUrl, cardOffset) => {
        e.stopPropagation();
        window.__keyframeLRUCache.cache.delete(cardKey);
        const priority = 10 - Math.abs(cardOffset);
        window.__keyframeImagePool.loadKeyframe(cardKey, cardUrl, priority);
      };

      return (
        <div className="bg-slate-900/95 rounded-2xl p-2 sm:p-2.5 border border-slate-800 shadow-2xl space-y-1.5 select-none w-full">
          <div className="flex items-center justify-between text-xs text-slate-300 gap-2 flex-wrap">
            <div className="flex items-center gap-1.5 font-semibold min-w-0">
              <Icon name="film" className="w-3.5 h-3.5 text-sky-400 shrink-0" />
              <span className="shrink-0">Dải Keyframe Ngữ Cảnh</span>
              <span className="text-[11px] text-slate-400 font-normal hidden sm:inline shrink-0">
                (±{radius} frames)
              </span>
              {currentAsrInfo ? (
                <span
                  className={`inline-flex items-center gap-1 px-1.5 py-0.5 rounded text-[10px] ${currentAsrInfo.theme.badgeBg} ${currentAsrInfo.theme.badgeText} shadow-xs truncate max-w-[200px] sm:max-w-[320px]`}
                  title={`Lời thoại ASR: "${currentAsrInfo.text}"`}
                >
                  <Icon name="message-square" className="w-3 h-3 shrink-0" />
                  <span className="font-bold shrink-0">ASR #{currentAsrInfo.groupId}:</span>
                  <span className="font-normal truncate">"{currentAsrInfo.text}"</span>
                </span>
              ) : (
                <span className="text-[10px] text-slate-500 italic hidden md:inline shrink-0">
                  (Không có ASR)
                </span>
              )}
            </div>
            <div className="flex items-center gap-2 text-[11px] text-slate-400 font-mono shrink-0">
              <span className="bg-slate-800 px-2 py-0.5 rounded border border-slate-700 text-sky-300 font-bold">
                Frame #{keyframes[currentIndex]?.frame_idx ?? currentIndex}
              </span>
              <span>({currentIndex + 1} / {total})</span>
            </div>
          </div>

          {/* Responsive Horizontal Strip: all cards fit smoothly */}
          <div ref={stripRef} className="flex items-stretch justify-center gap-1 sm:gap-1.5 md:gap-2 w-full overflow-x-auto pb-1 pt-0.5 scrollbar-thin scrollbar-thumb-slate-700 scroll-smooth">
            {windowFrames.map(({ index, kf, key, url, offset, isCurrent, asrInfo }) => {
              const cached = window.__keyframeLRUCache.get(key);
              const isLoaded = cached && cached.status === 'loaded';
              const isLoading = !cached || cached.status === 'loading';
              const isError = cached && cached.status === 'error';
              const imgSrc = isLoaded ? cached.blobUrl : url;

              return (
                <div
                  key={key}
                  onClick={() => onSelectIndex(index)}
                  data-keyframe-index={index}
                  className={`relative flex-1 min-w-[65px] max-w-[115px] cursor-pointer rounded-lg overflow-hidden border transition-all duration-150 flex flex-col group ${
                    isCurrent
                      ? `ring-2 ring-sky-400 ${asrInfo ? asrInfo.theme.border : 'border-sky-400'} bg-sky-950/60 shadow-xl scale-[1.04] z-10`
                      : asrInfo
                        ? `${asrInfo.theme.border} ${asrInfo.theme.bg} hover:border-sky-400 hover:scale-[1.02] opacity-95 hover:opacity-100 shadow-sm`
                        : 'border-slate-700/80 hover:border-sky-400 hover:scale-[1.02] bg-slate-950/60 opacity-75 hover:opacity-100'
                  }`}
                  title={`Click để chuyển sang Frame #${kf.frame_idx} (${kf.keyframe_id || ''})${asrInfo ? ` • [ASR #${asrInfo.groupId}] "${asrInfo.text}"` : ' • Không có ASR'}`}
                >
                  {/* Thumbnail Container */}
                  <div className="aspect-video bg-slate-950 relative overflow-hidden flex items-center justify-center">
                    {isLoaded && (
                      <img
                        src={imgSrc}
                        alt={`Frame ${kf.frame_idx}`}
                        className="w-full h-full object-cover transition-transform group-hover:scale-105 duration-200"
                        loading="eager"
                      />
                    )}
                    {isLoading && (
                      <div className="absolute inset-0 bg-slate-800 flex items-center justify-center animate-pulse">
                        <div className="w-3.5 h-3.5 border-2 border-sky-400 border-t-transparent rounded-full animate-spin"></div>
                      </div>
                    )}
                    {isError && (
                      <div
                        onClick={(e) => handleRetryCard(e, key, url, offset)}
                        className="absolute inset-0 bg-slate-900/95 flex flex-col items-center justify-center text-rose-400 text-[10px] p-1 cursor-pointer hover:bg-slate-800 transition-colors"
                        title="Bấm để thử tải lại ảnh này"
                      >
                        <Icon name="rotate-ccw" className="w-3.5 h-3.5 mb-0.5 text-rose-400" />
                        <span className="font-semibold text-[9px]">Thử lại</span>
                      </div>
                    )}

                    {/* Active Frame Indicator Overlay */}
                    {isCurrent && (
                      <div className="absolute top-1 left-1 bg-sky-500 text-white text-[9px] font-bold px-1.5 py-0.2 rounded shadow z-20 flex items-center gap-0.5">
                        <span>Current</span>
                      </div>
                    )}

                    {/* Offset badge */}
                    {!isCurrent && (
                      <div className="absolute top-1 left-1 bg-black/60 backdrop-blur text-slate-300 text-[9px] font-mono px-1 py-0.2 rounded z-20">
                        {offset > 0 ? `+${offset}` : offset}
                      </div>
                    )}

                    {/* ASR Group Badge (Same number & color for same ASR, different for different ASR) */}
                    {asrInfo ? (
                      <div
                        className={`absolute top-1 right-1 ${asrInfo.theme.badgeBg} ${asrInfo.theme.badgeText} text-[8.5px] font-black px-1 py-0.2 rounded shadow-md z-20 flex items-center gap-0.5 border border-black/20 leading-none`}
                        title={`Cùng nhóm ASR #${asrInfo.groupId}: "${asrInfo.text}"`}
                      >
                        <span>A{asrInfo.groupId}</span>
                      </div>
                    ) : (
                      <div
                        className="absolute top-1 right-1 bg-black/40 text-slate-400 text-[7.5px] font-mono px-0.5 py-0.2 rounded z-20 opacity-40 group-hover:opacity-80"
                        title="Không có lời thoại ASR"
                      >
                        -
                      </div>
                    )}
                  </div>

                  {/* Card Bottom Meta */}
                  <div
                    className={`px-1 py-0.5 text-[10px] font-mono flex items-center justify-between transition-colors ${
                      isCurrent
                        ? 'bg-sky-900/90 text-sky-200 font-bold'
                        : asrInfo
                          ? 'bg-slate-900/95 text-slate-300'
                          : 'bg-slate-950 text-slate-400'
                    }`}
                  >
                    <div className="flex items-center gap-1 min-w-0 truncate">
                      {asrInfo && (
                        <span
                          className={`w-1.5 h-1.5 rounded-full shrink-0 ${asrInfo.theme.dot}`}
                          title={`ASR Nhóm #${asrInfo.groupId}`}
                        />
                      )}
                      <span className="truncate text-[10px]">#{kf.frame_idx}</span>
                    </div>
                    <div className="flex items-center gap-1 shrink-0 text-[9px]">
                      {asrInfo && (
                        <span className={`font-black ${asrInfo.theme.text}`} title={`ASR Nhóm #${asrInfo.groupId}`}>
                          A{asrInfo.groupId}
                        </span>
                      )}
                      <span className="opacity-80">
                        {kf.pts_time !== undefined ? `${kf.pts_time.toFixed(1)}s` : ''}
                      </span>
                    </div>
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      );
    }

    function formatMilliseconds(ms) {
      if (ms === null || ms === undefined || ms === '' || isNaN(ms)) return '00:00:00.000';
      const numMs = parseInt(ms, 10);
      const totalSec = Math.floor(numMs / 1000);
      const msec = String(numMs % 1000).padStart(3, '0');
      const hrs = String(Math.floor(totalSec / 3600)).padStart(2, '0');
      const mins = String(Math.floor((totalSec % 3600) / 60)).padStart(2, '0');
      const secs = String(totalSec % 60).padStart(2, '0');
      return `${hrs}:${mins}:${secs}.${msec}`;
    }

    function ResultDetailModal({ item, onClose, onNote, notedKeyframeIds, onAddToKisRanking, onAddToQaRanking, kisKeyframeIds = new Set(), qaKeyframeIds = new Set(), onOpenCheckVideo }) {
      if (!item) return null;

      const videoId = item.videoId;
      const [keyframes, setKeyframes] = React.useState(window.__videoKeyframesCache[videoId] || []);
      const [currentIndex, setCurrentIndex] = React.useState(0);
      const [loadingList, setLoadingList] = React.useState(!window.__videoKeyframesCache[videoId]);

      const [mediaMode, setMediaMode] = React.useState(item.initialMediaMode || 'image'); // 'image' | 'video'
      const videoRef = React.useRef(null);
      const [videoStreamFailed, setVideoStreamFailed] = React.useState(false);

      const [imgState, setImgState] = React.useState('loading');
      const [curSrc, setCurSrc] = React.useState(item.thumbnailUrl);
      const [retryCount, setRetryCount] = React.useState(0);

      const [showAsr, setShowAsr] = React.useState(false);
      const [asrText, setAsrText] = React.useState('');
      const [asrFullText, setAsrFullText] = React.useState('');
      const [asrLoading, setAsrLoading] = React.useState(false);

      // Mode selection: 'semantic' | 'vqa' (persisted across modal opens)
      window.__currentDetailMode = window.__currentDetailMode || 'semantic';
      const [mode, setModeState] = React.useState(window.__currentDetailMode);
      const setMode = (newMode) => {
        window.__currentDetailMode = newMode;
        setModeState(newMode);
      };

      const [vqaAnswer, setVqaAnswer] = React.useState('');
      const [vqaSubmitStatus, setVqaSubmitStatus] = React.useState('idle'); // 'idle' | 'submitting' | 'success' | 'error'
      const [vqaSubmitResult, setVqaSubmitResult] = React.useState(null);

      const [submitStatus, setSubmitStatus] = React.useState('idle'); // 'idle' | 'submitting' | 'success' | 'error'
      const [submitResult, setSubmitResult] = React.useState(null);

      const BACKEND_BASE = `${window.location.protocol}//${window.location.hostname}:8888`;

      // Preload neighboring keyframe images
      const preloadNeighbors = React.useCallback((list, activeIdx) => {
        if (!list || list.length === 0) return;
        const offsets = [-3, -2, -1, 1, 2, 3];
        offsets.forEach((offset) => {
          const targetIdx = activeIdx + offset;
          if (targetIdx >= 0 && targetIdx < list.length) {
            const kf = list[targetIdx];
            const rawUrl = kf.image_url || '';
            const fullUrl = rawUrl.startsWith('http')
              ? rawUrl
              : rawUrl.startsWith('/')
                ? `${window.location.origin}${rawUrl}`
                : `${window.location.origin}/${rawUrl}`;
            const img = new Image();
            img.src = fullUrl;
          }
        });
      }, []);

      // Resolve starting index in keyframes list
      const resolveStartIdx = (list) => {
        if (!list || list.length === 0) return 0;
        const targetKid = item.keyframe_id || item.id || '';
        if (targetKid) {
          const idx = list.findIndex((k) => k.keyframe_id === targetKid);
          if (idx >= 0) return idx;
        }
        if (item.thumbnailUrl) {
          const filename = item.thumbnailUrl.split('/').pop().split('?')[0];
          if (filename) {
            const idx = list.findIndex((k) => k.image_path && (k.image_path.endsWith(filename) || k.keyframe_id + '.jpg' === filename));
            if (idx >= 0) return idx;
          }
        }
        if (item.frameId !== undefined && item.frameId !== '') {
          const idx = list.findIndex((k) => String(k.frame_idx) === String(item.frameId));
          if (idx >= 0) return idx;
        }
        return 0;
      };

      // Load keyframes for this video once (cached client-side)
      React.useEffect(() => {
        let isMounted = true;
        if (window.__videoKeyframesCache[videoId]) {
          const list = window.__videoKeyframesCache[videoId];
          setKeyframes(list);
          setLoadingList(false);
          const startIdx = resolveStartIdx(list);
          setCurrentIndex(startIdx);
          preloadNeighbors(list, startIdx);
        } else {
          setLoadingList(true);
          fetch(`${BACKEND_BASE}/api/video/${videoId}/keyframes`)
            .then((res) => {
              if (!res.ok) throw new Error(`HTTP ${res.status}`);
              return res.json();
            })
            .then((data) => {
              if (!isMounted) return;
              const list = data.keyframes || [];
              window.__videoKeyframesCache[videoId] = list;
              setKeyframes(list);
              setLoadingList(false);
              const startIdx = resolveStartIdx(list);
              setCurrentIndex(startIdx);
              preloadNeighbors(list, startIdx);
            })
            .catch((err) => {
              if (!isMounted) return;
              console.warn('Could not fetch video keyframes list:', err);
              setLoadingList(false);
            });
        }
        return () => { isMounted = false; };
      }, [videoId, item.id, item.keyframe_id, item.thumbnailUrl, preloadNeighbors, BACKEND_BASE]);

      // Determine active keyframe values from keyframes[currentIndex]
      const activeKf = (keyframes.length > 0 && currentIndex >= 0 && currentIndex < keyframes.length)
        ? keyframes[currentIndex]
        : null;

      const activeFrameId = activeKf ? activeKf.frame_idx : item.frameId;
      const activeKeyframeId = activeKf ? activeKf.keyframe_id : (item.keyframe_id || item.id || '');
      const activeTimestamp = activeKf
        ? activeKf.timestamp
        : (item.timestamp !== '' && item.timestamp !== undefined ? item.timestamp : 0);
      const activePts = activeKf
        ? activeKf.pts_time
        : (item.pts_time !== undefined ? item.pts_time : (activeTimestamp / 1000.0));

      const activeImageSrc = React.useMemo(() => {
        if (activeKf && activeKf.image_url) {
          const u = activeKf.image_url;
          return u.startsWith('http') ? u : u.startsWith('/') ? `${window.location.origin}${u}` : `${window.location.origin}/${u}`;
        }
        const u = item.thumbnailUrl || '';
        return u.startsWith('http') || u === ''
          ? u
          : u.startsWith('/')
            ? `${window.location.origin}${u}`
            : `${window.location.origin}/${u}`;
      }, [activeKf, item.thumbnailUrl]);

      // When active image changes, update curSrc & preload
      React.useEffect(() => {
        setImgState('loading');
        setRetryCount(0);
        setCurSrc(activeImageSrc);
        if (keyframes.length > 0) {
          preloadNeighbors(keyframes, currentIndex);
        }
      }, [activeImageSrc, currentIndex, keyframes, preloadNeighbors]);

      React.useEffect(() => {
        if (!showAsr) {
          setAsrText('');
          setAsrFullText('');
          return;
        }

        const setBoth = (asr6s, full) => {
          const a6s = asr6s || '';
          const af = full || asr6s || '';
          setAsrText(a6s || af || 'Không có dữ liệu ASR cho keyframe này.');
          setAsrFullText(af || a6s || 'Không có dữ liệu ASR cho keyframe này.');
        };

        const useMetadataAsr = (source) => {
          if (!source) return;
          const asr6s = source.asr_6s || source.asr_text || '';
          const fullText = source.full_text || source.asr_text || asr6s;
          setBoth(asr6s, fullText);
        };

        if (activeKf && (activeKf.asr_6s || activeKf.asr_text || activeKf.full_text)) {
          useMetadataAsr(activeKf);
          return;
        }
        if (item && (item.keyframe_id === activeKeyframeId || item.id === activeKeyframeId) && (item.asr_6s || item.asr_text || item.full_text)) {
          useMetadataAsr(item);
          return;
        }

        setAsrLoading(true);
        setAsrText('');
        setAsrFullText('');

        const params = new URLSearchParams({
          video_id: String(videoId),
          frame_idx: String(activeFrameId),
        });
        if (activeKeyframeId) {
          params.append('keyframe_id', String(activeKeyframeId));
        }

        fetch(`${BACKEND_BASE}/api/keyframe/asr?${params.toString()}`)
          .then((res) => {
            if (!res.ok) throw new Error(`HTTP ${res.status}`);
            return res.json();
          })
          .then((data) => {
            const asr6s = data.asr_6s || data.asr_text || '';
            const fullText = data.full_text || data.asr_text || asr6s;
            setBoth(asr6s, fullText);
          })
          .catch((err) => {
            console.error('Error fetching ASR:', err);
            setAsrText('Không tìm thấy dữ liệu phụ đề ASR.');
            setAsrFullText('');
          })
          .finally(() => {
            setAsrLoading(false);
          });
      }, [showAsr, videoId, activeFrameId, activeKeyframeId, activeKf, item, BACKEND_BASE]);

      // Navigation helpers
      const goPrev = React.useCallback(() => {
        if (currentIndex > 0) {
          setCurrentIndex((prev) => prev - 1);
        }
      }, [currentIndex]);

      const goNext = React.useCallback(() => {
        if (currentIndex < keyframes.length - 1) {
          setCurrentIndex((prev) => prev + 1);
        }
      }, [currentIndex, keyframes.length]);

      const goPrev5 = React.useCallback(() => {
        if (currentIndex > 0) {
          setCurrentIndex((prev) => Math.max(0, prev - 5));
        }
      }, [currentIndex]);

      const goNext5 = React.useCallback(() => {
        if (currentIndex < keyframes.length - 1) {
          setCurrentIndex((prev) => Math.min(keyframes.length - 1, prev + 5));
        }
      }, [currentIndex, keyframes.length]);

      // Duplicate submission key
      const submissionKey = `${videoId}_${activeFrameId}_${activeTimestamp}`;
      const isAlreadySubmitted = window.__dresSubmittedSet.has(submissionKey);
      const isNoted = notedKeyframeIds && notedKeyframeIds.has(activeKeyframeId);
      const isKisRanked = kisKeyframeIds && kisKeyframeIds.has(activeKeyframeId);
      const isQaRanked = qaKeyframeIds && qaKeyframeIds.has(activeKeyframeId);

      const handleNote = React.useCallback(() => {
        if (!onNote || isNoted) return;
        const imageUrl = activeImageSrc || item.thumbnailUrl;
        onNote({
          id: activeKeyframeId || item.id,
          keyframe_id: activeKeyframeId,
          videoId,
          videoTitle: item.videoTitle || videoId,
          frameId: activeFrameId,
          timestamp: activeTimestamp,
          pts_time: activePts,
          thumbnailUrl: imageUrl,
          score: item.score ?? 0,
          rank: item.rank ?? 1,
          matchedSources: item.matchedSources || [],
          caption: activeKeyframeId || item.caption,
        });
      }, [onNote, isNoted, activeImageSrc, activeKeyframeId, activeFrameId, activeTimestamp, activePts, videoId, item]);

      const handleAddToKisRankingAction = React.useCallback(() => {
        if (!onAddToKisRanking || isKisRanked) return;
        const imageUrl = activeImageSrc || item.thumbnailUrl;
        onAddToKisRanking({
          id: activeKeyframeId || item.id,
          keyframe_id: activeKeyframeId,
          videoId,
          videoTitle: item.videoTitle || videoId,
          frameId: activeFrameId,
          timestamp: activeTimestamp,
          pts_time: activePts,
          thumbnailUrl: imageUrl,
          score: item.score ?? 0,
          rank: item.rank ?? 1,
          matchedSources: item.matchedSources || [],
          caption: activeKeyframeId || item.caption,
        });
      }, [onAddToKisRanking, isKisRanked, activeImageSrc, activeKeyframeId, activeFrameId, activeTimestamp, activePts, videoId, item]);

      const handleAddToQaRankingAction = React.useCallback(() => {
        if (!onAddToQaRanking) return;
        const imageUrl = activeImageSrc || item.thumbnailUrl;
        onAddToQaRanking({
          id: activeKeyframeId || item.id,
          keyframe_id: activeKeyframeId,
          videoId,
          videoTitle: item.videoTitle || videoId,
          frameId: activeFrameId,
          timestamp: activeTimestamp,
          pts_time: activePts,
          thumbnailUrl: imageUrl,
          score: item.score ?? 0,
          rank: item.rank ?? 1,
          matchedSources: item.matchedSources || [],
          caption: activeKeyframeId || item.caption,
          answer: vqaAnswer ? vqaAnswer.trim() : undefined,
        });
      }, [onAddToQaRanking, activeImageSrc, activeKeyframeId, activeFrameId, activeTimestamp, activePts, videoId, item, vqaAnswer]);

      // Direct DRES Submit (Semantic / KIS)
      const handleSubmit = React.useCallback(async () => {
        if (submitStatus === 'submitting') return;
        setSubmitStatus('submitting');
        setSubmitResult(null);

        const payload = {
          video_id: String(videoId),
          timestamp: parseInt(activeTimestamp, 10) || 0,
          timestamp_ms: parseInt(activeTimestamp, 10) || 0,
          start: parseInt(activeTimestamp, 10) || 0,
          end: parseInt(activeTimestamp, 10) || 0,
          mode: 'search',
        };

        try {
          const res = await fetch(`${BACKEND_BASE}/api/dres/submit`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });

          const data = await res.json();

          if (!res.ok || data.status === false) {
            setSubmitStatus('error');
            setSubmitResult({
              status: false,
              description: data.detail || data.description || 'Submission failed',
            });
          } else {
            setSubmitStatus('success');
            window.__dresSubmittedSet.add(submissionKey);
            setSubmitResult({
              status: true,
              description: data.description || 'Submitted',
            });
          }
        } catch (err) {
          console.error('DRES submit error:', err);
          setSubmitStatus('error');
          setSubmitResult({
            status: false,
            description: `Submission failed: ${err.message}`,
          });
        }
      }, [submitStatus, videoId, activeTimestamp, submissionKey, BACKEND_BASE]);

      // Direct DRES Submit (VQA)
      const handleVqaSubmit = React.useCallback(async () => {
        if (vqaSubmitStatus === 'submitting' || !vqaAnswer.trim()) return;
        setVqaSubmitStatus('submitting');
        setVqaSubmitResult(null);

        const payload = {
          video_id: String(videoId),
          timestamp_ms: parseInt(activeTimestamp, 10) || 0,
          timestamp: parseInt(activeTimestamp, 10) || 0,
          answer: vqaAnswer.trim(),
          mode: 'vqa',
        };

        try {
          const res = await fetch(`${BACKEND_BASE}/api/dres/submit`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });

          const data = await res.json();

          if (!res.ok || data.status === false) {
            setVqaSubmitStatus('error');
            setVqaSubmitResult({
              status: false,
              description: data.detail || data.description || 'Submission failed',
            });
          } else {
            setVqaSubmitStatus('success');
            setVqaSubmitResult({
              status: true,
              description: data.description || 'Submitted',
            });
          }
        } catch (err) {
          console.error('VQA submit error:', err);
          setVqaSubmitStatus('error');
          setVqaSubmitResult({
            status: false,
            description: `Submission failed: ${err.message}`,
          });
        }
      }, [vqaSubmitStatus, vqaAnswer, videoId, activeTimestamp, BACKEND_BASE]);

      // Keyboard shortcuts
      React.useEffect(() => {
        const handleKeyDown = (e) => {
          const isInput = e.target && (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA');
          if (isInput) {
            if (e.key === 'Escape') {
              e.preventDefault();
              onClose();
            }
            return;
          }

          if ((e.key === 'ArrowLeft' || e.key === 'a' || e.key === 'A') && e.shiftKey) {
            e.preventDefault();
            goPrev5();
          } else if ((e.key === 'ArrowRight' || e.key === 'd' || e.key === 'D') && e.shiftKey) {
            e.preventDefault();
            goNext5();
          } else if (e.key === 'ArrowLeft' || e.key === 'a' || e.key === 'A') {
            e.preventDefault();
            goPrev();
          } else if (e.key === 'ArrowRight' || e.key === 'd' || e.key === 'D') {
            e.preventDefault();
            goNext();
          } else if (e.key === 'v' || e.key === 'V' || e.key === 'Tab') {
            e.preventDefault();
            setMode(mode === 'semantic' ? 'vqa' : 'semantic');
