              )}

              {/* Completeness Badge */}
              {missingCount === 0 ? (
                <span className="text-[10px] font-bold text-emerald-700 bg-emerald-100/90 border border-emerald-300 px-2 py-0.5 rounded-md flex items-center gap-1">
                  <Icon name="check" className="w-3 h-3 text-emerald-600" />
                  <span>Khớp đủ {matchedCount}/{frameChain.length} Stage</span>
                </span>
              ) : (
                <span className="text-[10px] font-bold text-amber-800 bg-amber-100 border border-amber-300 px-2 py-0.5 rounded-md flex items-center gap-1">
                  <Icon name="alert-triangle" className="w-3 h-3 text-amber-600" />
                  <span>Khớp {matchedCount}/{frameChain.length} Stage (Thiếu {missingCount})</span>
                </span>
              )}
            </div>

            {/* Video Timeline Scrubber Modal Button */}
            <button
              type="button"
              onClick={() => onSelectVideo(vidResult)}
              className="hidden text-xs font-bold text-white bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-700 hover:to-teal-700 px-3 py-1.5 rounded-xl flex items-center gap-1.5 transition-all shadow-xs active:scale-95 ml-auto"
            >
              <Icon name="sliders" className="w-3.5 h-3.5" />
              <span>Mở Timeline Scrubber</span>
              <Icon name="arrow-right" className="w-3 h-3" />
            </button>
          </div>

          {/* 3.1. Dãy N ảnh nằm ngang theo đúng thứ tự stage_index tăng dần */}
          <div className="flex items-center gap-2 overflow-x-auto pb-1 scrollbar-thin pt-0.5">
            {frameChain.map((frame, sIdx) => {
              const nextFrame = frameChain[sIdx + 1];
              let gapSec = null;
              if (
                frame.timestamp !== null && frame.timestamp !== undefined &&
                nextFrame && nextFrame.timestamp !== null && nextFrame.timestamp !== undefined
              ) {
                gapSec = Math.max(0, nextFrame.timestamp - frame.timestamp);
              }

              return (
                <React.Fragment key={sIdx}>
                  <FrameChainThumbnail
                    frame={frame}
                    stageIndex={sIdx}
                    onSelectFrame={(frame) => onSelectVideo(vidResult, frame.frame_idx, frame.keyframe_id)}
                    rankingKeyframeIds={rankingKeyframeIds}
                    notedKeyframeIds={notedKeyframeIds}
                    kisKeyframeIds={kisKeyframeIds}
                    qaKeyframeIds={qaKeyframeIds}
                    onAddToKisRanking={onAddToKisRanking}
                    onAddToQaRanking={onAddToQaRanking}
                    showToast={showToast}
                  />

                  {/* Connector Arrow with Gap Duration */}
                  {sIdx < frameChain.length - 1 && (
                    <div className="shrink-0 flex flex-col items-center justify-center text-slate-400 px-1">
                      <Icon name="arrow-right" className="w-4 h-4 text-slate-300" />
                      {gapSec !== null ? (
                        <span className="text-[9px] font-mono text-slate-500 font-semibold mt-0.5">
                          +{gapSec.toFixed(1)}s
                        </span>
                      ) : (
                        <span className="text-[9px] font-mono text-slate-300 mt-0.5">---</span>
                      )}
                    </div>
                  )}
                </React.Fragment>
              );
            })}
          </div>
        </div>
      );
    }

    /**
