              handleVqaSubmit();
            }
          } else if (e.key === 'Escape') {
            e.preventDefault();
            onClose();
          }
        };

        window.addEventListener('keydown', handleKeyDown);
        return () => window.removeEventListener('keydown', handleKeyDown);
      }, [goPrev, goNext, goPrev5, goNext5, handleSubmit, handleVqaSubmit, mode, onClose]);

