    // =========================================================================
    // TRAKE VIDEO INSPECTOR & TIMELINE SCRUBBER MODAL
    // =========================================================================
    function TrakeVideoInspectorModal({
      videoResult,
      events,
      initialFrameIdx,
      initialKeyframeId,
      onClose,
      onNote,
      notedKeyframeIds,
      onAddToRanking,
      onAddToKisRanking,
      onAddToQaRanking,
      rankingKeyframeIds,
      kisKeyframeIds = new Set(),
      qaKeyframeIds = new Set(),
      showToast,
      enableStageActions = false
    }) {
      if (!videoResult) return null;

      const videoId = videoResult.video_id;
      const [keyframes, setKeyframes] = React.useState(window.__videoKeyframesCache[videoId] || []);
      const [loadingList, setLoadingList] = React.useState(!window.__videoKeyframesCache[videoId]);

      // Map of chosen event frames: { E1: frameObj, E2: frameObj, ... }
      const [assignedEvents, setAssignedEvents] = React.useState(() => {
        const initial = {};
        (videoResult.timeline || []).forEach((item) => {
          initial[item.event_id] = {
            event_id: item.event_id,
            keyframe_id: item.keyframe_id,
            frame_idx: item.frame_idx,
            timestamp: item.timestamp,
            pts_time: item.pts_time !== undefined ? item.pts_time : (item.timestamp / 1000.0),
            image_path: item.image_path,
            score: item.score,
            isAi: true,
          };
        });
        return initial;
      });
      const [stageVqaOpen, setStageVqaOpen] = React.useState({});
      const [stageVqaAnswers, setStageVqaAnswers] = React.useState({});
      const [stageVqaStatus, setStageVqaStatus] = React.useState({});

      // AI original picks for quick reference / reset
      const aiOriginalPicks = React.useMemo(() => {
        const orig = {};
        (videoResult.timeline || []).forEach((item) => {
          orig[item.event_id] = { ...item, isAi: true };
        });
        return orig;
      }, [videoResult]);

      const [currentIndex, setCurrentIndex] = React.useState(0);
      const [imgState, setImgState] = React.useState('loading');
      const [curSrc, setCurSrc] = React.useState('');
      const [retryCount, setRetryCount] = React.useState(0);

      const [showAsr, setShowAsr] = React.useState(false);
      const [asrText, setAsrText] = React.useState('');
      const [asrLoading, setAsrLoading] = React.useState(false);
      const [mode, setMode] = React.useState('semantic');
      const [vqaAnswer, setVqaAnswer] = React.useState('');
      const [vqaSubmitStatus, setVqaSubmitStatus] = React.useState('idle');
      const [vqaSubmitResult, setVqaSubmitResult] = React.useState(null);

      const [submittingEventId, setSubmittingEventId] = React.useState(null);

      const BACKEND_BASE = `${window.location.protocol}//${window.location.hostname}:8888`;

      // Helper to preload neighbor frames
      const preloadNeighbors = React.useCallback((list, activeIdx) => {
        if (!list || list.length === 0) return;
        const offsets = [-3, -2, -1, 1, 2, 3];
        offsets.forEach((offset) => {
          const targetIdx = activeIdx + offset;
          if (targetIdx >= 0 && targetIdx < list.length) {
            const kf = list[targetIdx];
            const rawUrl = kf.thumbnail_url || kf.image_url || '';
            const fullUrl = rawUrl.startsWith('http')
              ? rawUrl
              : rawUrl.startsWith('/')
                ? `${window.location.origin}${rawUrl}`
                : `${window.location.origin}/${rawUrl}`;
            const img = new Image();
            img.src = fullUrl;
          }
        });
      }, []);

      // Helper to accurately locate starting index in keyframes list
      const resolveStartIdx = React.useCallback((list) => {
        if (!list || list.length === 0) return 0;
        if (initialKeyframeId) {
          const idx = list.findIndex(k => k.keyframe_id === initialKeyframeId);
          if (idx >= 0) return idx;
        }
        if (initialFrameIdx !== undefined && initialFrameIdx !== null && initialFrameIdx !== '') {
          const idx = list.findIndex(k => String(k.frame_idx) === String(initialFrameIdx) || k.keyframe_id === initialFrameIdx);
          if (idx >= 0) return idx;
        }
        if (videoResult.timeline && videoResult.timeline.length > 0) {
          const targetKid = videoResult.timeline[0].keyframe_id;
          const targetFidx = videoResult.timeline[0].frame_idx;
          const idx = list.findIndex(k => (targetKid && k.keyframe_id === targetKid) || (targetFidx !== undefined && String(k.frame_idx) === String(targetFidx)));
          if (idx >= 0) return idx;
        }
        return 0;
      }, [initialKeyframeId, initialFrameIdx, videoResult]);

      // Load all keyframes for this video
      React.useEffect(() => {
        let isMounted = true;
        if (window.__videoKeyframesCache[videoId]) {
          const list = window.__videoKeyframesCache[videoId];
          setKeyframes(list);
          setLoadingList(false);

          const startIdx = resolveStartIdx(list);
          setCurrentIndex(startIdx);
          preloadNeighbors(list, startIdx);
        } else {
          setLoadingList(true);
          fetch(`${BACKEND_BASE}/api/video/${videoId}/keyframes`)
            .then((res) => {
              if (!res.ok) throw new Error(`HTTP ${res.status}`);
              return res.json();
            })
            .then((data) => {
              if (!isMounted) return;
              const list = data.keyframes || [];
              window.__videoKeyframesCache[videoId] = list;
              setKeyframes(list);
              setLoadingList(false);

              const startIdx = resolveStartIdx(list);
              setCurrentIndex(startIdx);
              preloadNeighbors(list, startIdx);
            })
            .catch((err) => {
              if (!isMounted) return;
              console.warn('Could not fetch video keyframes:', err);
              setLoadingList(false);
            });
        }
        return () => { isMounted = false; };
      }, [videoId, resolveStartIdx, preloadNeighbors, BACKEND_BASE]);

      // Active keyframe currently viewed
      const activeKf = (keyframes.length > 0 && currentIndex >= 0 && currentIndex < keyframes.length)
        ? keyframes[currentIndex]
        : null;

      const handleVqaSubmit = React.useCallback(async () => {
        if (!activeKf || !vqaAnswer.trim() || vqaSubmitStatus === 'submitting') return;
        setVqaSubmitStatus('submitting');
        setVqaSubmitResult(null);
        try {
          const res = await fetch(`${BACKEND_BASE}/api/dres/submit`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              video_id: String(videoId),
              timestamp_ms: Number(activeKf.timestamp) || 0,
              timestamp: Number(activeKf.timestamp) || 0,
              answer: vqaAnswer.trim(),
              mode: 'vqa',
            }),
          });
          const data = await res.json();
          if (!res.ok || data.status === false) throw new Error(data.detail || data.description || 'Submission failed');
          setVqaSubmitStatus('success');
          setVqaSubmitResult({ status: true, description: data.description || 'Submitted' });
        } catch (err) {
          setVqaSubmitStatus('error');
          setVqaSubmitResult({ status: false, description: err.message });
        }
      }, [activeKf, BACKEND_BASE, videoId, vqaAnswer, vqaSubmitStatus]);

      const activeImageSrc = React.useMemo(() => {
        if (activeKf && activeKf.image_url) {
          const u = activeKf.image_url;
          return u.startsWith('http') ? u : u.startsWith('/') ? `${window.location.origin}${u}` : `${window.location.origin}/${u}`;
        }
        return '';
      }, [activeKf]);

      React.useEffect(() => {
        setImgState('loading');
        setRetryCount(0);
        setCurSrc(activeImageSrc);
        if (keyframes.length > 0) {
          preloadNeighbors(keyframes, currentIndex);
        }
      }, [activeImageSrc, currentIndex, keyframes, preloadNeighbors]);

      // ASR Loader for active keyframe
      React.useEffect(() => {
        if (!showAsr || !activeKf) {
          setAsrText('');
          return;
        }

        if (activeKf.asr_6s || activeKf.asr_text || activeKf.full_text) {
          setAsrText(activeKf.asr_6s || activeKf.full_text || activeKf.asr_text);
          return;
        }

        setAsrLoading(true);
        setAsrText('');

        const params = new URLSearchParams({
          video_id: String(videoId),
          frame_idx: String(activeKf.frame_idx),
        });
        if (activeKf.keyframe_id) {
          params.append('keyframe_id', String(activeKf.keyframe_id));
        }

        fetch(`${BACKEND_BASE}/api/keyframe/asr?${params.toString()}`)
          .then((res) => {
            if (!res.ok) throw new Error(`HTTP ${res.status}`);
            return res.json();
          })
          .then((data) => {
            const txt = data.asr_6s || data.asr_text || data.full_text || 'Không có dữ liệu ASR cho frame này.';
            setAsrText(txt);
          })
          .catch(() => {
            setAsrText('Không tìm thấy dữ liệu ASR.');
          })
          .finally(() => {
            setAsrLoading(false);
          });
      }, [showAsr, activeKf, videoId, BACKEND_BASE]);

      // Navigation helpers
      const goPrev = React.useCallback(() => {
        if (currentIndex > 0) setCurrentIndex(prev => prev - 1);
      }, [currentIndex]);

      const goNext = React.useCallback(() => {
        if (currentIndex < keyframes.length - 1) setCurrentIndex(prev => prev + 1);
      }, [currentIndex, keyframes.length]);

      const goPrev5 = React.useCallback(() => {
        if (currentIndex > 0) setCurrentIndex(prev => Math.max(0, prev - 5));
      }, [currentIndex]);

      const goNext5 = React.useCallback(() => {
        if (currentIndex < keyframes.length - 1) setCurrentIndex(prev => Math.min(keyframes.length - 1, prev + 5));
      }, [currentIndex, keyframes.length]);

      // Assign current frame to an Event (E1, E2, E3...)
      const handleAssignCurrentToEvent = (eventId) => {
        if (!activeKf) return;
        setAssignedEvents(prev => ({
          ...prev,
          [eventId]: {
            event_id: eventId,
            keyframe_id: activeKf.keyframe_id,
            frame_idx: activeKf.frame_idx,
            timestamp: activeKf.timestamp,
            pts_time: activeKf.pts_time,
            image_path: activeKf.image_path,
            score: 1.0,
            isAi: false,
          }
        }));
        if (showToast) showToast(`Đã gán frame ${activeKf.keyframe_id} cho ${eventId}`, 'success');
      };

      // Reset event back to AI choice
      const handleResetEventToAi = (eventId) => {
        if (!aiOriginalPicks[eventId]) return;
        setAssignedEvents(prev => ({
          ...prev,
          [eventId]: { ...aiOriginalPicks[eventId], isAi: true }
        }));
        if (showToast) showToast(`Đã đặt lại ${eventId} về gợi ý AI`, 'info');
      };

      const getAssignedStageItem = (eventId) => {
        const item = assignedEvents[eventId] || aiOriginalPicks[eventId];
        if (!item) return null;
        const kf = keyframes.find(k => k.keyframe_id === item.keyframe_id || String(k.frame_idx) === String(item.frame_idx)) || item;
        const timestamp = Number(kf.timestamp ?? item.timestamp) || 0;
        return {
          id: kf.keyframe_id || item.keyframe_id || `${videoId}_${kf.frame_idx}`,
          keyframe_id: kf.keyframe_id || item.keyframe_id,
          videoId,
          videoTitle: videoId,
          frameId: kf.frame_idx ?? item.frame_idx,
          timestamp,
          pts_time: Number(kf.pts_time ?? item.pts_time ?? timestamp / 1000),
          thumbnailUrl: kf.image_url || kf.thumbnail_url || `http://${window.location.hostname}:8888/images/${kf.image_path || item.image_path}`,
          score: kf.score || item.score || 1,
          rank: 1,
          matchedSources: ['temporal', eventId],
          caption: `${eventId}: ${videoId} (F#${kf.frame_idx ?? item.frame_idx})`,
        };
      };

      const handleAddAssignedStageToKis = (eventId) => {
        const item = getAssignedStageItem(eventId);
        if (item && onAddToKisRanking) onAddToKisRanking(item);
      };

      const handleAddAssignedStageToQa = (eventId) => {
        const item = getAssignedStageItem(eventId);
        const answer = (stageVqaAnswers[eventId] || '').trim();
        if (item && answer && onAddToQaRanking) onAddToQaRanking({ ...item, answer });
      };

      const handleSubmitAssignedStageVqa = async (eventId) => {
        const item = getAssignedStageItem(eventId);
        const answer = (stageVqaAnswers[eventId] || '').trim();
        if (!item || !answer || stageVqaStatus[eventId] === 'submitting') return;
        setStageVqaStatus(prev => ({ ...prev, [eventId]: 'submitting' }));
        try {
          const res = await fetch(`${BACKEND_BASE}/api/dres/submit`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ video_id: videoId, timestamp: item.timestamp, timestamp_ms: item.timestamp, answer, mode: 'vqa' }),
          });
          const data = await res.json();
          if (!res.ok || data.status === false) throw new Error(data.detail || data.description || 'VQA submit failed');
          setStageVqaStatus(prev => ({ ...prev, [eventId]: 'success' }));
          if (showToast) showToast(`ÄÃ£ submit VQA cho ${eventId}`, 'success');
        } catch (err) {
          setStageVqaStatus(prev => ({ ...prev, [eventId]: 'error' }));
          if (showToast) showToast(err.message || 'VQA submit failed', 'error');
        }
      };

      // Jump scrubber to an event's chosen keyframe
      const handleJumpToEvent = (eventId) => {
        const item = assignedEvents[eventId] || aiOriginalPicks[eventId];
        if (!item || keyframes.length === 0) return;
        const idx = keyframes.findIndex(k =>
          (item.keyframe_id && k.keyframe_id === item.keyframe_id) ||
          (item.frame_idx !== undefined && String(k.frame_idx) === String(item.frame_idx))
        );
        if (idx >= 0) setCurrentIndex(idx);
      };

      // Chronological sequence validation: t1 < t2 < t3...
      const eventKeys = React.useMemo(() => {
        return Object.keys(assignedEvents).sort((a, b) => {
          const na = parseInt(a.replace(/\D/g, '') || '0', 10);
          const nb = parseInt(b.replace(/\D/g, '') || '0', 10);
          return na - nb;
        });
      }, [assignedEvents]);

      const orderValidation = React.useMemo(() => {
        if (eventKeys.length <= 1) return { isValid: true, errorMsg: null };
        for (let i = 0; i < eventKeys.length - 1; i++) {
          const e1 = assignedEvents[eventKeys[i]];
          const e2 = assignedEvents[eventKeys[i + 1]];
          if (e1 && e2 && e1.timestamp >= e2.timestamp) {
            return {
              isValid: false,
              errorMsg: `Thứ tự thời gian chưa tăng dần: ${eventKeys[i + 1]} (${formatMilliseconds(e2.timestamp)}) đang xảy ra trước hoặc cùng lúc với ${eventKeys[i]} (${formatMilliseconds(e1.timestamp)}). Hãy chọn lại frame phù hợp!`
            };
          }
        }
        return { isValid: true, errorMsg: null };
      }, [assignedEvents, eventKeys]);

      // Submit specific event frame to DRES
      const handleSubmitEventToDres = async (eventId) => {
        const item = assignedEvents[eventId];
        if (!item) return;

        setSubmittingEventId(eventId);
        const payload = {
          video_id: String(videoId),
          timestamp: parseInt(item.timestamp, 10) || 0,
          timestamp_ms: parseInt(item.timestamp, 10) || 0,
          start: parseInt(item.timestamp, 10) || 0,
          end: parseInt(item.timestamp, 10) || 0,
          mode: 'search',
        };

        try {
          const res = await fetch(`${BACKEND_BASE}/api/dres/submit`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });
          const data = await res.json();
          if (!res.ok || data.status === false) {
            if (showToast) showToast(`Nộp ${eventId} thất bại: ${data.detail || data.description || 'Lỗi'}`, 'error');
          } else {
            const subKey = `${videoId}_${item.frame_idx}_${item.timestamp}`;
            window.__dresSubmittedSet.add(subKey);
            if (showToast) showToast(`Đã nộp ${eventId} (${item.keyframe_id}) lên DRES thành công!`, 'success');
          }
        } catch (err) {
          if (showToast) showToast(`Lỗi nộp DRES: ${err.message}`, 'error');
        } finally {
          setSubmittingEventId(null);
        }
      };

      const [isBatchSubmitting, setIsBatchSubmitting] = React.useState(false);

      const handleCopySequence = () => {
        const lines = eventKeys.map(eid => {
          const ev = assignedEvents[eid];
          return `${eid}: ${videoId} | ${ev ? ev.keyframe_id : 'N/A'} | Frame: ${ev ? ev.frame_idx : 0} | Timestamp: ${ev ? ev.timestamp : 0}ms (${ev ? formatMilliseconds(ev.timestamp) : ''})`;
        });
        const text = `[TRAKE Sequence for ${videoId}]\n` + lines.join('\n');
        navigator.clipboard.writeText(text).then(() => {
          if (showToast) showToast('Đã sao chép chuỗi mốc TRAKE vào clipboard', 'success');
        }).catch(() => {
          if (showToast) showToast('Không thể sao chép vào clipboard', 'error');
        });
      };

      const handleSubmitAllToDres = async () => {
        if (isBatchSubmitting) return;
        setIsBatchSubmitting(true);
        let successCount = 0;
        for (const eid of eventKeys) {
          const item = assignedEvents[eid];
          if (!item) continue;
          const payload = {
            video_id: String(videoId),
            timestamp: parseInt(item.timestamp, 10) || 0,
            timestamp_ms: parseInt(item.timestamp, 10) || 0,
            start: parseInt(item.timestamp, 10) || 0,
            end: parseInt(item.timestamp, 10) || 0,
            mode: 'search',
          };
          try {
            const res = await fetch(`${BACKEND_BASE}/api/dres/submit`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(payload),
            });
            const data = await res.json();
            if (res.ok && data.status !== false) {
              successCount++;
              const subKey = `${videoId}_${item.frame_idx}_${item.timestamp}`;
              window.__dresSubmittedSet.add(subKey);
            }
          } catch (e) {
            console.error('Batch submit error for', eid, e);
          }
        }
        setIsBatchSubmitting(false);
        if (showToast) showToast(`Đã nộp thành công ${successCount}/${eventKeys.length} mốc lên DRES!`, successCount > 0 ? 'success' : 'error');
      };

      const handleAddAllToRanking = () => {
        if (!onAddToRanking) return;
        const timeline = eventKeys.map(eid => {
          const item = assignedEvents[eid] || (aiOriginalPicks ? aiOriginalPicks[eid] : null);
          const kf = (keyframes || []).find(k => (item && k.keyframe_id === item.keyframe_id) || (item && k.frame_idx === item.frame_idx)) || item;
          return {
            event_id: eid,
            keyframe_id: kf ? (kf.keyframe_id || (item ? item.keyframe_id : undefined)) : (item ? item.keyframe_id : undefined),
            frame_idx: kf && kf.frame_idx !== undefined ? kf.frame_idx : (item ? item.frame_idx : 0),
            timestamp: kf && kf.timestamp !== undefined ? kf.timestamp : (item ? item.timestamp : 0),
            image_path: item ? item.image_path : `${videoId}/${kf ? (kf.keyframe_id || '') : ''}.jpg`,
            score: item ? item.score : 1.0,
          };
        });
        const trakeVideoEntry = {
          video_id: videoId,
          global_score: videoResult.global_score || 1.0,
          timeline: timeline,
        };
        onAddToRanking(trakeVideoEntry);
        if (showToast) showToast(`Đã lưu toàn bộ chuỗi ${timeline.length} mốc của video ${videoId} vào TRAKE Ranking!`, 'success');
      };

      // Keyboard navigation
      React.useEffect(() => {
        const handleKeyDown = (e) => {
          const isInput = e.target && (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA');
          if (isInput) {
            if (e.key === 'Escape') {
              e.preventDefault();
              onClose();
            }
            return;
          }
          if ((e.key === 'ArrowLeft' || e.key === 'a' || e.key === 'A') && e.shiftKey) {
            e.preventDefault();
            goPrev5();
          } else if ((e.key === 'ArrowRight' || e.key === 'd' || e.key === 'D') && e.shiftKey) {
            e.preventDefault();
            goNext5();
          } else if (e.key === 'ArrowLeft' || e.key === 'a' || e.key === 'A') {
            e.preventDefault();
            goPrev();
          } else if (e.key === 'ArrowRight' || e.key === 'd' || e.key === 'D') {
            e.preventDefault();
            goNext();
          } else if (e.key === 'Escape') {
            e.preventDefault();
            onClose();
          }
        };
        window.addEventListener('keydown', handleKeyDown);
        return () => window.removeEventListener('keydown', handleKeyDown);
      }, [goPrev, goNext, goPrev5, goNext5, onClose]);

      const handleNoteCurrent = () => {
        if (!activeKf || !onNote) return;
        onNote({
          id: activeKf.keyframe_id,
          keyframe_id: activeKf.keyframe_id,
          videoId,
          videoTitle: videoId,
          frameId: activeKf.frame_idx,
          timestamp: activeKf.timestamp,
          pts_time: activeKf.pts_time,
          thumbnailUrl: activeKf.image_url || activeKf.thumbnail_url,
          score: 1.0,
          rank: 1,
          matchedSources: ['trake'],
          caption: `TRAKE ${videoId} - Frame ${activeKf.frame_idx}`,
        });
      };

      const handleAddToRankingCurrent = () => {
        handleAddAllToRanking();
      };

      const isCurrentNoted = activeKf && notedKeyframeIds && notedKeyframeIds.has(activeKf.keyframe_id);
      const isCurrentRanked = activeKf && rankingKeyframeIds && rankingKeyframeIds.has(activeKf.keyframe_id);

      return (
        <div
          id="trake-video-inspector-modal"
          className="fixed inset-0 z-50 flex items-center justify-center p-2 sm:p-4 bg-black/80 backdrop-blur-md animate-fade-in overflow-y-auto"
          onClick={(e) => { if (e.target === e.currentTarget) onClose(); }}
        >
          <div className="w-full max-w-6xl flex flex-col gap-2.5 my-auto max-h-[96vh]">

            {/* SEPARATE TOP WIDE BAR: Dải Keyframe Ngữ Cảnh (~11 frames full width) */}
            {keyframes.length > 0 && (
              <div className="fixed top-1 left-4 right-4 z-[60] pointer-events-none">
                <div className="pointer-events-auto w-full">
                  <KeyframeContextStrip
                    keyframes={keyframes}
                    currentIndex={currentIndex}
                    onSelectIndex={(newIdx) => setCurrentIndex(newIdx)}
                    radius={5}
                  />
                </div>
              </div>
            )}

            {/* MAIN INSPECTOR CARD */}
            <div className="bg-white rounded-2xl shadow-2xl overflow-hidden border border-slate-700/30 flex flex-col flex-1 min-h-0">

              {/* Modal Header */}
              <div className="bg-slate-900 px-4 py-3 flex items-center justify-between text-white border-b border-slate-800">
                <div className="flex items-center space-x-3 flex-wrap gap-y-1">
                  <span className="bg-indigo-500/20 text-indigo-400 border border-indigo-500/30 px-2.5 py-0.5 rounded-lg text-xs font-mono font-bold flex items-center gap-1.5">
                    <Icon name="film" className="w-3.5 h-3.5 text-indigo-400" />
                    {videoId}
                  </span>
                  <span className="text-xs text-slate-300 font-semibold bg-slate-800 px-2 py-0.5 rounded-md border border-slate-700">
                    Điểm DP: <strong className="text-emerald-400">{videoResult.global_score.toFixed(3)}</strong>
                  </span>
                  {keyframes.length > 0 && (
                    <span className="text-[11px] text-slate-400 font-mono">
                      Tổng {keyframes.length} keyframes
                    </span>
                  )}
                  <div className="flex items-center bg-slate-800 p-0.5 rounded-lg border border-slate-700">
                    <button type="button" onClick={() => setMode('semantic')} className={`px-3 py-1 rounded-md text-xs font-semibold transition-all ${mode === 'semantic' ? 'bg-sky-600 text-white shadow-sm' : 'text-slate-400 hover:text-slate-200'}`}>Semantic</button>
                    <button type="button" onClick={() => setMode('vqa')} className={`px-3 py-1 rounded-md text-xs font-semibold transition-all ${mode === 'vqa' ? 'bg-purple-600 text-white shadow-sm' : 'text-slate-400 hover:text-slate-200'}`}>VQA</button>
                  </div>
                </div>

                {/* Quick Jump Buttons to Events in Header */}
                <div className="hidden md:flex items-center gap-1.5">
                  <span className="text-[11px] text-slate-400 mr-1">Nhảy nhanh:</span>
                  {eventKeys.map(eid => {
                    const ev = assignedEvents[eid];
                    const color = getEventColor(eid);
                    return (
                      <button
                        key={eid}
                        onClick={() => handleJumpToEvent(eid)}
                        className={`${color.badge} text-[10px] font-bold px-2 py-0.5 rounded-md hover:opacity-90 transition-all flex items-center gap-1 shadow-xs`}
                        title={`Nhảy đến ${eid} (${ev ? formatMilliseconds(ev.timestamp) : ''})`}
                      >
                        <span>{eid}</span>
                        {ev && <span className="opacity-80 text-[9px] font-mono">({(ev.timestamp / 1000).toFixed(1)}s)</span>}
                      </button>
                    );
                  })}
                </div>

                <div className="flex items-center space-x-3">
                  <span className="text-[11px] text-slate-400 hidden sm:inline-block font-mono">
                    Phím tắt: <kbd className="bg-slate-800 px-1.5 py-0.5 rounded border border-slate-700">←/A</kbd> <kbd className="bg-slate-800 px-1.5 py-0.5 rounded border border-slate-700">→/D</kbd> <kbd className="bg-slate-800 px-1.5 py-0.5 rounded border border-slate-700">Esc</kbd>
                  </span>
                  <button
                    onClick={onClose}
                    className="w-7 h-7 bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white rounded-full flex items-center justify-center transition-colors"
                    title="Đóng (Esc)"
                  >
                    <Icon name="x" className="w-4 h-4" />
                  </button>
                </div>
              </div>

              {/* Scrollable Content Body */}
              <div className="overflow-y-auto p-4 sm:p-5 space-y-4">

                {/* Order Validation Banner */}
                {!orderValidation.isValid && (
                  <div className="bg-rose-50 border-2 border-rose-400 text-rose-800 px-4 py-2.5 rounded-xl text-xs font-semibold flex items-center gap-2 animate-pulse">
                    <Icon name="alert-triangle" className="w-4 h-4 text-rose-600 shrink-0" />
                    <span>{orderValidation.errorMsg}</span>
                  </div>
                )}

                {/* 1. Large HD Keyframe Preview */}
                <div className="aspect-video bg-slate-950 rounded-2xl overflow-hidden relative border border-slate-800 shadow-inner flex items-center justify-center">
                  {activeKf && (
                    <img
                      src={`http://${window.location.hostname}:8888/images/${activeKf.image_path}`}
                      alt="preview"
                      className="absolute inset-0 w-full h-full object-contain filter blur-[2px] opacity-75 transition-opacity duration-300"
                    />
                  )}
                  {imgState === 'loaded' && (
                    <img
                      src={curSrc}
                      alt={activeKf ? activeKf.keyframe_id : ''}
                      className="relative z-10 w-full h-full object-contain select-none transition-opacity duration-300"
                      onLoad={() => setImgState('loaded')}
                      onError={() => {
                        if (retryCount < 2) {
                          setRetryCount(r => r + 1);
                          setCurSrc(activeImageSrc + '?retry=' + Date.now());
                        } else {
                          setImgState('error');
                        }
                      }}
                    />
                  )}
                  {imgState === 'loading' && (
                    <>
                      <img
                        src={curSrc}
                        alt=""
                        className="w-0 h-0 opacity-0"
                        onLoad={() => setImgState('loaded')}
                        onError={() => {
                          if (retryCount < 2) {
                            setRetryCount(r => r + 1);
                            setCurSrc(activeImageSrc + '?retry=' + Date.now());
                          } else {
                            setImgState('error');
                          }
                        }}
                      />
                      <div className="absolute top-3 right-3 z-20 bg-slate-900/80 text-indigo-400 px-2.5 py-1 rounded-full text-xs font-mono backdrop-blur flex items-center gap-1.5 border border-slate-700/50 shadow">
                        <div className="w-3 h-3 border-2 border-indigo-400 border-t-transparent rounded-full animate-spin"></div>
                        <span>Đang tải HD...</span>
                      </div>
                    </>
                  )}

                  {/* Overlaid Badges for currently assigned events on this frame */}
                  <div className="absolute top-3 left-3 z-20 flex items-center gap-1.5 flex-wrap">
                    {eventKeys.map(eid => {
                      const assigned = assignedEvents[eid];
                      if (activeKf && assigned && (assigned.keyframe_id === activeKf.keyframe_id || assigned.frame_idx === activeKf.frame_idx)) {
                        const color = getEventColor(eid);
                        return (
                          <span key={eid} className={`${color.badge} px-2.5 py-1 rounded-lg text-xs font-bold shadow-md flex items-center gap-1 animate-bounce-short`}>
                            <Icon name="check" className="w-3 h-3" />
                            <span>Đang gán cho {eid}</span>
                            {assigned.isAi ? <span className="opacity-80 text-[9px]">(AI)</span> : <span className="opacity-80 text-[9px]">(User)</span>}
                          </span>
                        );
                      }
                      return null;
                    })}
                  </div>

                  {/* Overlaid Current Frame Info */}
                  {activeKf && (
                    <div className="absolute bottom-3 left-3 right-3 z-20 flex items-center justify-between pointer-events-none">
                      <div className="bg-black/75 backdrop-blur text-white px-3 py-1.5 rounded-xl text-xs font-mono flex items-center gap-2 border border-white/10 shadow">
                        <span className="text-indigo-400 font-bold">{activeKf.keyframe_id}</span>
                        <span className="text-slate-400">|</span>
                        <span>Frame #{activeKf.frame_idx}</span>
                      </div>
                      <div className="bg-black/75 backdrop-blur text-white px-3 py-1.5 rounded-xl text-xs font-mono font-bold flex items-center gap-1.5 border border-white/10 shadow">
                        <Icon name="clock" className="w-3.5 h-3.5 text-sky-400" />
                        <span>{formatMilliseconds(activeKf.timestamp)}</span>
                      </div>
                    </div>
                  )}
                </div>

                {mode === 'vqa' && !enableStageActions && (
                  <div className="bg-purple-50/70 border border-purple-200 rounded-2xl p-4 space-y-3">
                    <label className="text-xs font-bold text-purple-900 flex items-center gap-1.5">
                      <Icon name="message-square" className="w-4 h-4 text-purple-600" />
                      Câu trả lời VQA cho frame hiện tại
                    </label>
                    <input
                      type="text"
                      value={vqaAnswer}
                      onChange={(e) => setVqaAnswer(e.target.value)}
                      onKeyDown={(e) => { if (e.key === 'Enter') { e.preventDefault(); handleVqaSubmit(); } }}
                      placeholder="Nhập câu trả lời..."
                      className="w-full px-3 py-2.5 bg-white border border-purple-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-purple-500/20"
                    />
                    <button type="button" onClick={handleVqaSubmit} disabled={!vqaAnswer.trim() || vqaSubmitStatus === 'submitting'} className="w-full py-2.5 rounded-xl bg-gradient-to-r from-purple-600 to-indigo-700 text-white text-xs font-bold disabled:opacity-50">
                      {vqaSubmitStatus === 'submitting' ? 'Đang nộp VQA...' : 'Submit VQA lên DRES'}
                    </button>
                    {vqaSubmitResult && <div className={`text-xs font-bold p-2.5 rounded-lg ${vqaSubmitResult.status ? 'bg-emerald-100 text-emerald-800' : 'bg-rose-100 text-rose-800'}`}>{vqaSubmitResult.status ? '✓ Submitted' : vqaSubmitResult.description}</div>}
                  </div>
                )}

                {/* 2. INTERACTIVE TIMELINE SCRUBBER WITH AI PINS */}
                <div className="bg-slate-900 text-white rounded-2xl p-4 space-y-3 border border-slate-800 shadow-md">
                  <div className="flex items-center justify-between">
                    <div className="flex items-center gap-2">
                      <Icon name="sliders" className="w-4 h-4 text-indigo-400" />
                      <span className="text-xs font-bold uppercase tracking-wider text-slate-200">Timeline Scrubber (Toàn bộ video)</span>
                    </div>
                    <div className="text-xs font-mono text-slate-300 flex items-center gap-2">
                      <span>Keyframe <strong className="text-white">{currentIndex + 1}</strong> / {keyframes.length || 0}</span>
                      {activeKf && (
