    // =========================================================================
    // 7. CHECK VIDEO VIEW COMPONENT (Direct Video/Frame Lookup & Verification)
    // =========================================================================
    function CheckVideoView({
      onSelectResult,
      onNoteImage,
      notedKeyframeIds = new Set(),
      onAddToKisRanking,
      onAddToQaRanking,
      kisKeyframeIds = new Set(),
      qaKeyframeIds = new Set(),
      showToast,
    }) {
      // Saved input states (persisted across tab switches via window state)
      window.__checkVideoState = window.__checkVideoState || {
        videoId: 'L23_V018',
        frameId: '46',
      };

      const [videoIdInput, setVideoIdInput] = React.useState(window.__checkVideoState.videoId || '');
      const [frameIdInput, setFrameIdInput] = React.useState(window.__checkVideoState.frameId || '');
      const [inputErrors, setInputErrors] = React.useState({ videoId: '', frameId: '' });

      const [isLoading, setIsLoading] = React.useState(false);
      const [error, setError] = React.useState(null);

      const [currentFrameData, setCurrentFrameData] = React.useState(null);
      const [keyframes, setKeyframes] = React.useState([]);
      const [currentIndex, setCurrentIndex] = React.useState(0);
      const [videoStreamFailed, setVideoStreamFailed] = React.useState(false);

      const [isSubmittingDres, setIsSubmittingDres] = React.useState(false);

      const videoRef = React.useRef(null);
      const BACKEND_BASE = `${window.location.protocol}//${window.location.hostname}:8888`;

      // Keep window.__checkVideoState updated
      React.useEffect(() => {
        window.__checkVideoState.videoId = videoIdInput;
        window.__checkVideoState.frameId = frameIdInput;
      }, [videoIdInput, frameIdInput]);

      // Seek video when currentFrameData or pts_time changes
      React.useEffect(() => {
        if (currentFrameData && videoRef.current) {
          const targetPts = currentFrameData.pts_time !== undefined ? currentFrameData.pts_time : (currentFrameData.timestamp / 1000.0);
          try {
            videoRef.current.currentTime = targetPts;
            videoRef.current.play().catch(() => {});
          } catch (e) {
            console.warn('Video seek error:', e);
          }
        }
      }, [currentFrameData]);

      // Auto-seek on loadedmetadata
      const handleVideoLoadedMetadata = () => {
        if (videoRef.current && currentFrameData) {
          const targetPts = currentFrameData.pts_time !== undefined ? currentFrameData.pts_time : (currentFrameData.timestamp / 1000.0);
          videoRef.current.currentTime = targetPts;
          videoRef.current.play().catch(() => {});
        }
      };

      // Jump relative seconds in video
      const handleSeekRelative = (deltaSeconds) => {
        if (videoRef.current) {
          videoRef.current.currentTime = Math.max(0, videoRef.current.currentTime + deltaSeconds);
        }
      };

      // Jump back to initial frame
      const handleResetToTargetFrame = () => {
        if (videoRef.current && currentFrameData) {
          const targetPts = currentFrameData.pts_time !== undefined ? currentFrameData.pts_time : (currentFrameData.timestamp / 1000.0);
          videoRef.current.currentTime = targetPts;
          videoRef.current.play().catch(() => {});
        }
      };

      // Switch to a keyframe from the Context Strip
      const handleSelectKeyframeFromStrip = (idx) => {
        if (!keyframes || idx < 0 || idx >= keyframes.length) return;
        const kf = keyframes[idx];
        setCurrentIndex(idx);
        const updated = {
          ...currentFrameData,
          video_id: kf.video_id,
          keyframe_id: kf.keyframe_id,
          frame_idx: kf.frame_idx,
          pts_time: kf.pts_time,
          timestamp: kf.timestamp,
          image_url: kf.image_url,
          image_path: kf.image_path,
        };
        setCurrentFrameData(updated);
        setFrameIdInput(String(kf.frame_idx));

        if (videoRef.current) {
          const targetPts = kf.pts_time !== undefined ? kf.pts_time : (kf.timestamp / 1000.0);
          videoRef.current.currentTime = targetPts;
          videoRef.current.play().catch(() => {});
        }
      };

      // Main submit logic
      const handleCheckVideo = async (targetVid = videoIdInput, targetFid = frameIdInput) => {
        const vid = String(targetVid || '').trim().replace(/\.mp4$/i, '');
        const fid = String(targetFid || '').trim();

        const errors = { videoId: '', frameId: '' };
        if (!vid) errors.videoId = 'Vui lòng nhập tên video (ví dụ: L23_V018)';
        if (!fid) errors.frameId = 'Vui lòng nhập Frame ID (ví dụ: 46 hoặc L23_V018_kf_0046)';

        setInputErrors(errors);
        if (errors.videoId || errors.frameId) return;

        setIsLoading(true);
        setError(null);
        setVideoStreamFailed(false);

        try {
          // Determine if fid is numeric or keyframe_id
          const isNumeric = /^\d+$/.test(fid);
          const queryParams = isNumeric
            ? `video_id=${encodeURIComponent(vid)}&frame_idx=${encodeURIComponent(fid)}`
            : `video_id=${encodeURIComponent(vid)}&keyframe_id=${encodeURIComponent(fid)}`;

          let frameData = null;

          // 1. First attempt: Dedicated Backend Endpoint
          try {
            const res = await fetch(`${BACKEND_BASE}/api/v1/frame/timestamp?${queryParams}`);
            if (res.ok) {
              frameData = await res.json();
            } else if (res.status === 404) {
              const errData = await res.json().catch(() => ({}));
              throw new Error(errData.detail || 'Không tìm thấy video/frame này trong dataset');
            }
          } catch (apiErr) {
            if (apiErr.message && apiErr.message.includes('Không tìm thấy')) {
              throw apiErr;
            }
            console.warn('API call failed, falling back to keyframes list:', apiErr);
          }

          // 2. Load keyframes list directly for Context Strip
          let videoKeyframes = window.__videoKeyframesCache[vid] || [];
          if (!videoKeyframes || videoKeyframes.length === 0) {
            const kfRes = await fetch(`${BACKEND_BASE}/api/video/${vid}/keyframes`);
            if (!kfRes.ok) {
              throw new Error(`Không tìm thấy video '${vid}' trong dataset`);
            }
            const kfData = await kfRes.json();
            videoKeyframes = kfData.keyframes || [];
            window.__videoKeyframesCache[vid] = videoKeyframes;
          }
          setKeyframes(videoKeyframes);

          if (!frameData) {
            // Find in keyframes list
            let matched = null;
            if (isNumeric) {
              const targetIdx = parseInt(fid, 10);
              matched = videoKeyframes.find(k => k.frame_idx === targetIdx);
            } else {
              matched = videoKeyframes.find(k => k.keyframe_id === fid || String(k.frame_idx) === fid);
            }

            if (!matched) {
              throw new Error(`Không tìm thấy frame '${fid}' trong video '${vid}' (video có ${videoKeyframes.length} frames)`);
            }

            frameData = {
              video_id: vid,
              keyframe_id: matched.keyframe_id,
              frame_idx: matched.frame_idx,
              pts_time: matched.pts_time,
              timestamp: matched.timestamp,
              image_url: matched.image_url,
              image_path: matched.image_path,
              total_keyframes: videoKeyframes.length,
              video_stream_url: `/api/video/${vid}/stream`,
            };
          }

          // Locate current index in keyframes list
          const foundIdx = videoKeyframes.findIndex(
            k => k.keyframe_id === frameData.keyframe_id || k.frame_idx === frameData.frame_idx
          );
          setCurrentIndex(foundIdx >= 0 ? foundIdx : 0);
          setCurrentFrameData(frameData);

          if (showToast) {
            showToast(`Đã tìm thấy ${frameData.video_id} • Frame #${frameData.frame_idx} (${frameData.pts_time}s)!`, 'success');
          }
        } catch (err) {
          console.error('Check video error:', err);
          setError(err.message || 'Không tìm thấy video/frame này');
          if (showToast) {
            showToast(`Lỗi: ${err.message || 'Không tìm thấy video/frame này'}`, 'error');
          }
        } finally {
          setIsLoading(false);
        }
      };

      // Quick Preset Loader
      const handleLoadPreset = (presetVid, presetFid) => {
        setVideoIdInput(presetVid);
        setFrameIdInput(presetFid);
        handleCheckVideo(presetVid, presetFid);
      };

      // Submit to DRES handler
      const handleSubmitToDres = async () => {
        if (!currentFrameData) return;
        setIsSubmittingDres(true);
        try {
          const payload = {
            item_id: currentFrameData.video_id,
            timestamp_ms: currentFrameData.timestamp,
          };
          const res = await fetch(`${BACKEND_BASE}/api/v1/dres/submit`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });
          const data = await res.json();
          if (!res.ok) throw new Error(data.detail || 'Lỗi khi nộp lên DRES');
          if (showToast) showToast('Đã nộp bài lên DRES thành công!', 'success');
        } catch (err) {
          if (showToast) showToast(`Nộp DRES thất bại: ${err.message}`, 'error');
        } finally {
          setIsSubmittingDres(false);
        }
      };

      const currentKfId = currentFrameData ? (currentFrameData.keyframe_id || `${currentFrameData.video_id}_kf_${String(currentFrameData.frame_idx).padStart(4, '0')}`) : '';
      const isNoted = currentKfId ? notedKeyframeIds.has(currentKfId) : false;
      const isKisRanked = currentKfId ? kisKeyframeIds.has(currentKfId) : false;
      const isQaRanked = currentKfId ? qaKeyframeIds.has(currentKfId) : false;

      return (
        <div className="flex-1 flex flex-col min-w-0 bg-slate-50 overflow-y-auto">
          {/* Top Form Banner */}
          <div className="bg-white border-b border-slate-200 px-6 py-4 shadow-xs sticky top-0 z-10">
            <div className="max-w-6xl mx-auto flex flex-col md:flex-row md:items-center justify-between gap-4">
              
              {/* Form Input Group */}
              <div className="flex flex-col sm:flex-row items-start sm:items-center gap-3 flex-1">
                {/* Video ID Input */}
                <div className="w-full sm:w-56">
                  <label className="block text-[11px] font-bold uppercase tracking-wider text-slate-500 mb-1">
                    Tên Video (video_id)
                  </label>
                  <div className="relative">
                    <input
                      type="text"
                      value={videoIdInput}
                      onChange={(e) => {
                        setVideoIdInput(e.target.value);
                        if (inputErrors.videoId) setInputErrors(prev => ({ ...prev, videoId: '' }));
                      }}
                      onKeyDown={(e) => { if (e.key === 'Enter') handleCheckVideo(); }}
                      placeholder="Ví dụ: L23_V018"
                      className={`w-full px-3 py-2 text-xs font-mono font-bold rounded-xl border bg-slate-50 focus:bg-white focus:outline-none transition-all ${
                        inputErrors.videoId
                          ? 'border-rose-400 focus:ring-2 focus:ring-rose-200 text-rose-900 bg-rose-50/50'
                          : 'border-slate-300 focus:border-purple-500 focus:ring-2 focus:ring-purple-200 text-slate-800'
                      }`}
                    />
                    <Icon name="film" className="w-3.5 h-3.5 absolute right-2.5 top-2.5 text-slate-400 pointer-events-none" />
                  </div>
                  {inputErrors.videoId && (
                    <p className="text-[11px] font-medium text-rose-500 mt-1 flex items-center gap-1">
                      <Icon name="alert-triangle" className="w-3 h-3 shrink-0" />
                      <span>{inputErrors.videoId}</span>
                    </p>
                  )}
                </div>

                {/* Frame ID Input */}
                <div className="w-full sm:w-56">
                  <label className="block text-[11px] font-bold uppercase tracking-wider text-slate-500 mb-1">
                    Frame ID (frame_idx / keyframe_id)
                  </label>
                  <div className="relative">
                    <input
                      type="text"
                      value={frameIdInput}
                      onChange={(e) => {
                        setFrameIdInput(e.target.value);
                        if (inputErrors.frameId) setInputErrors(prev => ({ ...prev, frameId: '' }));
                      }}
                      onKeyDown={(e) => { if (e.key === 'Enter') handleCheckVideo(); }}
                      placeholder="Ví dụ: 46 hoặc L23_V018_kf_0046"
                      className={`w-full px-3 py-2 text-xs font-mono font-bold rounded-xl border bg-slate-50 focus:bg-white focus:outline-none transition-all ${
                        inputErrors.frameId
                          ? 'border-rose-400 focus:ring-2 focus:ring-rose-200 text-rose-900 bg-rose-50/50'
                          : 'border-slate-300 focus:border-purple-500 focus:ring-2 focus:ring-purple-200 text-slate-800'
                      }`}
                    />
                    <Icon name="hash" className="w-3.5 h-3.5 absolute right-2.5 top-2.5 text-slate-400 pointer-events-none" />
                  </div>
                  {inputErrors.frameId && (
                    <p className="text-[11px] font-medium text-rose-500 mt-1 flex items-center gap-1">
                      <Icon name="alert-triangle" className="w-3 h-3 shrink-0" />
                      <span>{inputErrors.frameId}</span>
                    </p>
                  )}
                </div>

                {/* Submit "Xem" Button */}
                <div className="pt-0 sm:pt-5 w-full sm:w-auto">
                  <button
                    type="button"
                    onClick={() => handleCheckVideo()}
                    disabled={isLoading}
                    className="w-full sm:w-auto px-5 py-2 bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-700 hover:to-indigo-700 disabled:opacity-50 text-white font-bold text-xs rounded-xl flex items-center justify-center gap-2 shadow-md shadow-purple-500/20 active:scale-95 transition-all cursor-pointer"
                  >
                    {isLoading ? (
                      <>
                        <div className="w-3.5 h-3.5 border-2 border-white border-t-transparent rounded-full animate-spin"></div>
                        <span>Đang tìm...</span>
                      </>
                    ) : (
                      <>
                        <Icon name="play" className="w-3.5 h-3.5" />
                        <span>Xem Video</span>
                        <kbd className="bg-purple-800/60 px-1.5 py-0.5 rounded text-[10px] font-mono text-purple-200">Enter</kbd>
                      </>
                    )}
                  </button>
                </div>
              </div>

              {/* Sample Preset Badges */}
              <div className="flex items-center gap-1.5 flex-wrap">
                <span className="text-[10px] font-bold uppercase tracking-wider text-slate-400 mr-1">Mẫu nhanh:</span>
                <button
                  type="button"
                  onClick={() => handleLoadPreset('L23_V018', '46')}
                  className="px-2.5 py-1 rounded-lg text-[11px] font-mono font-semibold bg-purple-50 text-purple-700 hover:bg-purple-100 border border-purple-200 transition-colors cursor-pointer"
                >
                  L23_V018 #46
                </button>
                <button
                  type="button"
                  onClick={() => handleLoadPreset('L21_V001', '0')}
                  className="px-2.5 py-1 rounded-lg text-[11px] font-mono font-semibold bg-sky-50 text-sky-700 hover:bg-sky-100 border border-sky-200 transition-colors cursor-pointer"
                >
                  L21_V001 #0
                </button>
                <button
                  type="button"
                  onClick={() => handleLoadPreset('L24_V005', '187')}
                  className="px-2.5 py-1 rounded-lg text-[11px] font-mono font-semibold bg-emerald-50 text-emerald-700 hover:bg-emerald-100 border border-emerald-200 transition-colors cursor-pointer"
                >
                  L24_V005 #187
                </button>
              </div>

            </div>
          </div>

          {/* Main Content Area */}
          <div className="max-w-6xl w-full mx-auto p-4 sm:p-6 space-y-4 flex-1">

            {/* Error Message Box */}
            {error && (
              <div className="bg-rose-50 border border-rose-200 rounded-2xl p-4 flex items-start gap-3 text-rose-800 animate-fade-in shadow-xs">
                <div className="w-8 h-8 rounded-xl bg-rose-100 flex items-center justify-center text-rose-600 shrink-0 mt-0.5">
                  <Icon name="alert-triangle" className="w-4 h-4" />
                </div>
                <div className="flex-1 min-w-0">
                  <h4 className="text-xs font-bold text-rose-900 mb-0.5">Không thể xem video</h4>
                  <p className="text-xs text-rose-700 leading-relaxed">{error}</p>
                </div>
                <button
                  type="button"
                  onClick={() => setError(null)}
                  className="text-rose-400 hover:text-rose-600 p-1 cursor-pointer"
                >
                  <Icon name="x" className="w-4 h-4" />
                </button>
              </div>
            )}

            {/* Video Player Display Container */}
            {currentFrameData ? (
              <div className="space-y-4 animate-fade-in">

                {/* Info Header Bar */}
                <div className="bg-slate-900 rounded-2xl px-4 py-3 flex flex-wrap items-center justify-between gap-3 text-white border border-slate-800 shadow-md">
                  <div className="flex items-center flex-wrap gap-2">
                    <span className="bg-purple-500/20 text-purple-300 border border-purple-500/30 px-2.5 py-1 rounded-lg text-xs font-mono font-bold flex items-center gap-1.5">
                      <Icon name="film" className="w-3.5 h-3.5 text-purple-400" />
                      {currentFrameData.video_id}
                    </span>
                    <span className="bg-sky-500/20 text-sky-300 border border-sky-500/30 px-2.5 py-1 rounded-lg text-xs font-mono font-bold flex items-center gap-1.5">
                      <Icon name="hash" className="w-3.5 h-3.5 text-sky-400" />
                      Frame #{currentFrameData.frame_idx}
                    </span>
                    <span className="text-slate-400 text-xs font-mono hidden sm:inline">
                      {currentFrameData.keyframe_id}
                    </span>
                    <span className="bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 px-2.5 py-1 rounded-lg text-xs font-mono font-bold flex items-center gap-1.5">
                      <Icon name="clock" className="w-3.5 h-3.5 text-emerald-400" />
                      {currentFrameData.pts_time}s ({formatMilliseconds(currentFrameData.timestamp)})
                    </span>
                  </div>

                  <div className="flex items-center gap-2">
                    <span className="text-xs text-slate-400 font-mono hidden md:inline">
                      Tổng: <strong className="text-white">{currentFrameData.total_keyframes || keyframes.length}</strong> frames
                    </span>
                    <button
                      type="button"
                      onClick={() => onSelectResult({
                        id: currentFrameData.keyframe_id || `${currentFrameData.video_id}_${currentFrameData.frame_idx}`,
                        keyframe_id: currentFrameData.keyframe_id,
                        videoId: currentFrameData.video_id,
                        videoTitle: currentFrameData.video_id,
                        frameId: currentFrameData.frame_idx,
                        timestamp: currentFrameData.timestamp,
                        pts_time: currentFrameData.pts_time,
                        thumbnailUrl: currentFrameData.image_url.startsWith('http')
                          ? currentFrameData.image_url
                          : `${window.location.origin}${currentFrameData.image_url.startsWith('/') ? '' : '/'}${currentFrameData.image_url}`,
                        score: 1.0,
                        matchedSources: ['check_video'],
                        caption: `${currentFrameData.video_id} - Frame ${currentFrameData.frame_idx}`,
                      })}
                      className="px-3 py-1.5 bg-slate-800 hover:bg-slate-700 text-slate-200 hover:text-white rounded-lg text-xs font-semibold flex items-center gap-1.5 transition-colors border border-slate-700 cursor-pointer"
                      title="Mở trong Modal chi tiết (Semantic / VQA / DRES)"
                    >
                      <Icon name="external-link" className="w-3.5 h-3.5" />
                      <span>Chi tiết Modal</span>
                    </button>
                  </div>
                </div>

                {/* Video / Keyframe Player Container */}
                <div className="bg-slate-950 rounded-2xl overflow-hidden shadow-2xl relative border border-slate-800 flex flex-col items-center justify-center">
                  {!videoStreamFailed ? (
                    <video
                      ref={videoRef}
                      src={`${BACKEND_BASE}/api/video/${currentFrameData.video_id}/stream`}
                      controls
                      autoPlay
                      playsInline
                      preload="auto"
                      onLoadedMetadata={handleVideoLoadedMetadata}
                      onError={() => {
                        console.warn('MP4 video stream not available, falling back to Keyframe Image View');
                        setVideoStreamFailed(true);
                      }}
                      className="w-full max-h-[65vh] aspect-video bg-black object-contain"
                    />
                  ) : (
                    /* Fallback High-Res Keyframe Image View */
                    <div className="w-full aspect-video bg-slate-950 flex flex-col items-center justify-center relative group p-2">
                      <img
                        src={currentFrameData.image_url.startsWith('http')
                          ? currentFrameData.image_url
                          : `${window.location.origin}${currentFrameData.image_url.startsWith('/') ? '' : '/'}${currentFrameData.image_url}`}
                        alt={currentFrameData.keyframe_id}
                        className="w-full h-full object-contain select-none rounded-xl"
                      />
                      <div className="absolute top-3 left-3 bg-amber-500/90 backdrop-blur text-slate-950 text-xs font-bold px-2.5 py-1 rounded-lg shadow-md flex items-center gap-1.5">
                        <Icon name="alert-triangle" className="w-3.5 h-3.5" />
                        <span>Chế độ Keyframe Viewer (MP4 chưa có trên phân vùng)</span>
                      </div>
                    </div>
                  )}
                </div>

                {/* Player Quick Controls Toolbar */}
                <div className="bg-white rounded-2xl p-3 border border-slate-200 shadow-xs flex flex-wrap items-center justify-between gap-3">
                  {/* Left: Playback seek controls */}
                  <div className="flex items-center gap-1.5 flex-wrap">
                    <button
                      type="button"
                      onClick={() => handleSeekRelative(-5)}
                      className="px-2.5 py-1.5 bg-slate-100 hover:bg-slate-200 text-slate-700 font-mono font-bold text-xs rounded-xl border border-slate-200 transition-colors active:scale-95 cursor-pointer"
                      title="Lùi 5 giây (-5s)"
                    >
                      -5s
                    </button>
                    <button
                      type="button"
                      onClick={() => handleSeekRelative(-1)}
                      className="px-2.5 py-1.5 bg-slate-100 hover:bg-slate-200 text-slate-700 font-mono font-bold text-xs rounded-xl border border-slate-200 transition-colors active:scale-95 cursor-pointer"
                      title="Lùi 1 giây (-1s)"
                    >
                      -1s
                    </button>
                    <button
                      type="button"
                      onClick={handleResetToTargetFrame}
                      className="px-3 py-1.5 bg-purple-50 hover:bg-purple-100 text-purple-700 font-bold text-xs rounded-xl border border-purple-200 transition-colors active:scale-95 flex items-center gap-1 cursor-pointer"
                      title="Quay lại đúng timestamp của Frame ban đầu"
                    >
                      <Icon name="rotate-ccw" className="w-3.5 h-3.5" />
                      <span>Về mốc Frame</span>
                    </button>
                    <button
                      type="button"
                      onClick={() => handleSeekRelative(1)}
                      className="px-2.5 py-1.5 bg-slate-100 hover:bg-slate-200 text-slate-700 font-mono font-bold text-xs rounded-xl border border-slate-200 transition-colors active:scale-95 cursor-pointer"
                      title="Tiến 1 giây (+1s)"
                    >
                      +1s
                    </button>
                    <button
                      type="button"
                      onClick={() => handleSeekRelative(5)}
                      className="px-2.5 py-1.5 bg-slate-100 hover:bg-slate-200 text-slate-700 font-mono font-bold text-xs rounded-xl border border-slate-200 transition-colors active:scale-95 cursor-pointer"
                      title="Tiến 5 giây (+5s)"
                    >
                      +5s
                    </button>
                  </div>

                  {/* Right: Ranking & Note Actions */}
                  <div className="flex items-center gap-2 flex-wrap">
                    <button
                      type="button"
                      onClick={() => {
                        onNoteImage({
                          id: currentKfId,
                          keyframe_id: currentKfId,
                          videoId: currentFrameData.video_id,
                          videoTitle: currentFrameData.video_id,
                          frameId: currentFrameData.frame_idx,
                          timestamp: currentFrameData.timestamp,
                          pts_time: currentFrameData.pts_time,
                          thumbnailUrl: currentFrameData.image_url.startsWith('http')
                            ? currentFrameData.image_url
                            : `${window.location.origin}${currentFrameData.image_url.startsWith('/') ? '' : '/'}${currentFrameData.image_url}`,
                        });
                        if (showToast) showToast(`Đã note frame ${currentKfId}!`, 'success');
                      }}
                      className={`px-3 py-1.5 rounded-xl font-bold text-xs flex items-center gap-1.5 border transition-all cursor-pointer ${
                        isNoted
                          ? 'bg-amber-50 text-amber-700 border-amber-300'
                          : 'bg-white hover:bg-amber-50 text-amber-700 border-amber-300'
                      }`}
                    >
                      <Icon name="bookmark" className="w-3.5 h-3.5" />
                      <span>{isNoted ? 'Đã note ✓' : 'Note'}</span>
                    </button>

                    <button
                      type="button"
                      onClick={() => {
                        onAddToKisRanking({
                          id: currentKfId,
                          keyframe_id: currentKfId,
                          videoId: currentFrameData.video_id,
                          videoTitle: currentFrameData.video_id,
                          frameId: currentFrameData.frame_idx,
                          timestamp: currentFrameData.timestamp,
                          pts_time: currentFrameData.pts_time,
                          thumbnailUrl: currentFrameData.image_url.startsWith('http')
                            ? currentFrameData.image_url
                            : `${window.location.origin}${currentFrameData.image_url.startsWith('/') ? '' : '/'}${currentFrameData.image_url}`,
                          score: 1.0,
                          matchedSources: ['check_video'],
                        });
                      }}
                      className={`px-3 py-1.5 rounded-xl font-bold text-xs flex items-center gap-1.5 border transition-all cursor-pointer ${
                        isKisRanked
                          ? 'bg-emerald-50 text-emerald-700 border-emerald-300'
                          : 'bg-white hover:bg-sky-50 text-sky-700 border-sky-300'
                      }`}
                    >
                      <Icon name={isKisRanked ? 'check-circle' : 'tag'} className="w-3.5 h-3.5" />
                      <span>{isKisRanked ? 'Đã thêm KIS ✓' : 'Add KIS'}</span>
                    </button>

                    <button
                      type="button"
                      onClick={handleSubmitToDres}
                      disabled={isSubmittingDres}
                      className="px-4 py-1.5 bg-gradient-to-r from-emerald-600 to-teal-700 hover:from-emerald-500 hover:to-teal-600 disabled:opacity-50 text-white font-bold text-xs rounded-xl flex items-center gap-1.5 shadow-md shadow-emerald-500/20 active:scale-95 transition-all cursor-pointer"
                    >
                      {isSubmittingDres ? (
                        <>
                          <div className="w-3.5 h-3.5 border-2 border-white border-t-transparent rounded-full animate-spin"></div>
                          <span>Đang nộp...</span>
                        </>
                      ) : (
                        <>
                          <Icon name="send" className="w-3.5 h-3.5" />
                          <span>Submit DRES</span>
                        </>
                      )}
                    </button>
                  </div>
                </div>

                {/* Keyframe Context Strip (Sliding Window ~11 frames) */}
                {keyframes.length > 0 && (
                  <div className="space-y-2">
                    <KeyframeContextStrip
                      keyframes={keyframes}
                      currentIndex={currentIndex}
                      onSelectIndex={handleSelectKeyframeFromStrip}
                      radius={5}
                    />
                  </div>
                )}

              </div>
            ) : (
              /* Empty Hero State */
              <div className="bg-white rounded-3xl border border-slate-200/80 p-8 sm:p-12 text-center shadow-xs flex flex-col items-center justify-center max-w-2xl mx-auto my-8">
                <div className="w-16 h-16 rounded-2xl bg-gradient-to-tr from-purple-500 to-indigo-600 flex items-center justify-center text-white shadow-lg shadow-purple-500/25 mb-4">
                  <Icon name="video" className="w-8 h-8" />
                </div>
                <h3 className="text-base font-bold text-slate-800 mb-1.5">
                  Kiểm tra Video Trực Tiếp từ Frame ID
                </h3>
                <p className="text-xs text-slate-500 max-w-md leading-relaxed mb-6">
                  Nhập <strong className="text-slate-700">Tên video</strong> (ví dụ: <code className="font-mono bg-slate-100 px-1 py-0.5 rounded">L23_V018</code>) và <strong className="text-slate-700">Frame ID</strong> (ví dụ: <code className="font-mono bg-slate-100 px-1 py-0.5 rounded">46</code>) ở thanh phía trên rồi bấm <strong className="text-purple-700">"Xem Video"</strong> để phát trực tiếp video từ đúng thời điểm đó.
                </p>

                <div className="flex items-center gap-2 flex-wrap justify-center">
                  <span className="text-xs text-slate-400 font-medium">Bấm thử mẫu nhanh:</span>
                  <button
                    type="button"
                    onClick={() => handleLoadPreset('L23_V018', '46')}
                    className="px-3 py-1.5 bg-purple-50 hover:bg-purple-100 text-purple-700 font-mono font-bold text-xs rounded-xl border border-purple-200 transition-all active:scale-95 shadow-xs cursor-pointer"
                  >
                    L23_V018 — Frame 46
                  </button>
                  <button
                    type="button"
                    onClick={() => handleLoadPreset('L21_V001', '0')}
                    className="px-3 py-1.5 bg-sky-50 hover:bg-sky-100 text-sky-700 font-mono font-bold text-xs rounded-xl border border-sky-200 transition-all active:scale-95 shadow-xs cursor-pointer"
                  >
                    L21_V001 — Frame 0
                  </button>
                  <button
                    type="button"
                    onClick={() => handleLoadPreset('L24_V005', '187')}
                    className="px-3 py-1.5 bg-emerald-50 hover:bg-emerald-100 text-emerald-700 font-mono font-bold text-xs rounded-xl border border-emerald-200 transition-all active:scale-95 shadow-xs cursor-pointer"
                  >
                    L24_V005 — Frame 187
                  </button>
                </div>
              </div>
            )}

          </div>
        </div>
      );
    }

    function App() {
      const createDefaultPanel = (idNum = 1) => ({
        id: `panel-${Date.now()}-${idNum}`,
        type: 'text',
        query: '',
        enabled: true,
      });

      const [panels, setPanels] = useState([createDefaultPanel(1)]);
      const [results, setResults] = useState([]);
      const [selectedResult, setSelectedResult] = useState(null);
      const [isSearching, setIsSearching] = useState(false);
      const [searchError, setSearchError] = useState(null);
      const [topK, setTopK] = useState(50);
      const [viewMode, setViewMode] = useState('search');
      const [queryTime, setQueryTime] = useState(null);
      const [startTime, setStartTime] = useState(null);
      const [clipboard, setClipboard] = useState(loadClipboard);
      const [toast, setToast] = useState(null);

      // Real-time Shared Clipboard WebSocket States
      const [wsStatus, setWsStatus] = useState('connecting'); // 'connected' | 'connecting' | 'offline'
      const [onlineUsers, setOnlineUsers] = useState(1);
      const wsRef = React.useRef(null);
      const isRemoteSyncRef = React.useRef(false);
      const noteDebounceRef = React.useRef(null);

      const [selectedTrakeVideo, setSelectedTrakeVideo] = useState(null);
      const [selectedTrakeIsTemporal, setSelectedTrakeIsTemporal] = useState(false);
      const [trakeInitialFrameIdx, setTrakeInitialFrameIdx] = useState(undefined);
      const [trakeInitialKeyframeId, setTrakeInitialKeyframeId] = useState(undefined);

      // === TRAKE STATES ===
      const createDefaultTrakeEvent = (num = 1) => ({
        id: `trake-ev-${Date.now()}-${Math.random().toString(36).substr(2, 5)}`,
        eventId: `E${num}`,
        description: '',
        text_query: '',
        ocr_query: '',
        asr_query: '',
        activeTab: 'text',
        weight_text: 1.0,
        weight_ocr: 1.0,
        weight_asr: 1.0,
      });

      const [trakeContext, setTrakeContext] = useState('');
      const [trakeEvents, setTrakeEvents] = useState([
        createDefaultTrakeEvent(1),
        createDefaultTrakeEvent(2)
      ]);
      const [trakeResults, setTrakeResults] = useState([]);
      const [isTrakeSearching, setIsTrakeSearching] = useState(false);
      const [trakeError, setTrakeError] = useState(null);
      const [trakeFilterSource, setTrakeFilterSource] = useState('none'); // 'none' | 'ranking' | 'note'

      const handleUpdateTrakeEvent = (idx, updatedEvent) => {
        setTrakeEvents(prev => prev.map((ev, i) => (i === idx ? updatedEvent : ev)));
      };

      const handleAddTrakeEvent = () => {
        setTrakeEvents(prev => [...prev, createDefaultTrakeEvent(prev.length + 1)]);
      };

      const handleRemoveTrakeEvent = (idx) => {
        setTrakeEvents(prev => {
          if (prev.length <= 1) {
            showToast('Cần giữ lại ít nhất 1 mốc sự kiện', 'info');
            return prev;
          }
          return prev.filter((_, i) => i !== idx);
        });
      };

      const handleResetTrake = () => {
        setTrakeEvents([createDefaultTrakeEvent(1), createDefaultTrakeEvent(2)]);
        setTrakeContext('');
        setTrakeResults([]);
        setTrakeError(null);
        showToast('Đã làm mới các mốc sự kiện TRAKE', 'info');
      };

      // === TEMPORAL STAGE-BASED SEARCH STATES ===
      const createDefaultStage = (num = 1) => ({
        id: makeStageId(),
        text_query: '',
        ocr_query: '',
        asr_query: '',
        weight_text: 1.0,
        weight_ocr: 1.0,
        weight_asr: 1.0,
        max_gap_seconds: null,
        activeTab: 'text',
        collapsed: false,
      });

      const [temporalStages, setTemporalStages] = useState([
        createDefaultStage(1),
        createDefaultStage(2)
      ]);
      const [temporalContext, setTemporalContext] = useState('');
      const [temporalBonusWeight, setTemporalBonusWeight] = useState(0.15);
      const [temporalResults, setTemporalResults] = useState([]);
      const [isTemporalSearching, setIsTemporalSearching] = useState(false);
      const [temporalError, setTemporalError] = useState(null);
      const [temporalFilterSource, setTemporalFilterSource] = useState('none');

      const handleUpdateTemporalStage = (id, updatedStage) => {
        setTemporalStages(prev => prev.map(s => (s.id === id ? updatedStage : s)));
      };

      const handleAddTemporalStage = () => {
        setTemporalStages(prev => [...prev, createDefaultStage(prev.length + 1)]);
      };

      const handleRemoveTemporalStage = (id) => {
        setTemporalStages(prev => {
          if (prev.length <= 1) {
            showToast('Cần giữ lại ít nhất 1 Stage', 'info');
            return prev;
          }
          return prev.filter(s => s.id !== id);
        });
      };

      const handleResetTemporal = () => {
        setTemporalStages([createDefaultStage(1), createDefaultStage(2)]);
        setTemporalContext('');
        setTemporalBonusWeight(0.15);
        setTemporalResults([]);
        setTemporalError(null);
        showToast('Đã làm mới toàn bộ Stage search', 'info');
      };

      const handleLoadMockTemporalDemo = () => {
        setTemporalContext('documentary về giao thông đô thị');
        setTemporalBonusWeight(0.15);
        setTemporalStages([
          {
            id: makeStageId(),
            text_query: 'red car driving along highway',
            ocr_query: '',
            asr_query: '',
            weight_text: 1.0,
            weight_ocr: 1.0,
            weight_asr: 1.0,
            max_gap_seconds: 120,
            activeTab: 'text',
            collapsed: false,
          },
          {
            id: makeStageId(),
            text_query: 'driver parking vehicle near building',
            ocr_query: 'PARKING',
            asr_query: '',
            weight_text: 1.0,
            weight_ocr: 1.5,
            weight_asr: 1.0,
            max_gap_seconds: null,
            activeTab: 'ocr',
            collapsed: false,
          }
        ]);
        setTemporalResults(MOCK_TEMPORAL_RESPONSE.videos);
        setTemporalError(null);
        showToast('Đã nạp dữ liệu mẫu Demo (kèm missing frame)', 'success');
      };

      const handleTemporalSearch = async () => {
        // 2.2. Validation: Filter stages that have at least 1 non-empty query
        const validStages = temporalStages.filter(s => {
          const hasT = Boolean(s.text_query && s.text_query.trim().length > 0);
          const hasO = Boolean(s.ocr_query && s.ocr_query.trim().length > 0);
          const hasA = Boolean(s.asr_query && s.asr_query.trim().length > 0);
          return hasT || hasO || hasA;
        });

        if (validStages.length === 0) {
          showToast('Vui lòng nhập ít nhất 1 stage', 'info');
          return;
        }

        setIsTemporalSearching(true);
        setTemporalError(null);

        try {
          const payload = {
            stages: validStages.map((s, idx) => ({
              stage_index: idx,
              text_query: s.text_query && s.text_query.trim() ? s.text_query.trim() : null,
              ocr_query: s.ocr_query && s.ocr_query.trim() ? s.ocr_query.trim() : null,
              asr_query: s.asr_query && s.asr_query.trim() ? s.asr_query.trim() : null,
              weight_text: Number(s.weight_text) || 1.0,
              weight_ocr: Number(s.weight_ocr) || 1.0,
              weight_asr: Number(s.weight_asr) || 1.0,
            })),
            global_context: temporalContext && temporalContext.trim() ? temporalContext.trim() : null,
            context_bonus_weight: Number(temporalBonusWeight) || 0.15,
            max_gap_seconds: validStages[0]?.max_gap_seconds || null,
            top_k_per_stage: 100,
            top_k_videos: Number(topK) || 10,
          };

          const backendHost = window.location.hostname || '127.0.0.1';
          const res = await fetch(`http://${backendHost}:8888/api/v1/temporal-search/solve`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });

          const data = await res.json();
          if (!res.ok) {
            throw new Error(data.detail || `Lỗi API (${res.status}): ${res.statusText}`);
          }

          setTemporalResults(data.videos || []);
          if (!data.videos || data.videos.length === 0) {
            showToast('Không tìm thấy chuỗi video nào thỏa mãn các stage đã tạo', 'info');
          } else {
            showToast(`Tìm thấy ${data.videos.length} chuỗi video phù hợp!`, 'success');
          }
        } catch (err) {
          console.error('Temporal search error:', err);
          setTemporalError(err.message || 'Lỗi không xác định khi gọi API');
          showToast(`Lỗi: ${err.message}`, 'error');
        } finally {
          setIsTemporalSearching(false);
        }
      };

      const handleSelectTemporalFrame = (frame) => {
        if (!frame || frame.frame_idx === null || frame.frame_idx === undefined) return;
        const rawUrl = frame.image_url || (frame.image_path ? `/images/${frame.image_path}` : '');
        const fullUrl = rawUrl.startsWith('http')
          ? rawUrl
          : `http://${window.location.hostname}:8888${rawUrl.startsWith('/') ? '' : '/'}${rawUrl}`;

        setSelectedResult({
          id: frame.keyframe_id || `${frame.video_id}_${frame.frame_idx}`,
          keyframe_id: frame.keyframe_id || `${frame.video_id}_kf_${String(frame.frame_idx).padStart(4, '0')}`,
          videoId: frame.video_id,
          videoTitle: frame.video_id,
          frameId: frame.frame_idx,
          timestamp: frame.timestamp !== null && frame.timestamp !== undefined ? `${frame.timestamp.toFixed(1)}s` : '0.0s',
          pts_time: frame.timestamp || 0,
          score: frame.score || 0,
          matchedSources: ['temporal', `Stage ${frame.stage_index + 1}`],
          caption: `${frame.video_id} - Frame ${frame.frame_idx} (Stage ${frame.stage_index + 1})`,
          thumbnailUrl: fullUrl,
          image_path: frame.image_path || `${frame.video_id}/${frame.keyframe_id}.jpg`,
        });
      };

      const handleSelectTemporalVideo = (vidResult, initialIdx, initialKeyframeId) => {
        setSelectedTrakeIsTemporal(true);
        const timeline = (vidResult.frame_chain || [])
          .filter(f => f.frame_idx !== null && f.frame_idx !== undefined)
          .map(f => ({
            event_id: `Stage ${f.stage_index + 1}`,
            keyframe_id: f.keyframe_id || `${f.video_id}_kf_${String(f.frame_idx).padStart(4, '0')}`,
            frame_idx: f.frame_idx,
            timestamp: (f.timestamp || 0) * 1000,
            image_path: f.image_path || `${f.video_id}/${f.keyframe_id}.jpg`,
            score: f.score || 0,
          }));

        setSelectedTrakeVideo({
          video_id: vidResult.video_id,
          global_score: vidResult.global_score,
          timeline: timeline
        });
        setTrakeInitialFrameIdx(initialIdx !== undefined ? initialIdx : (timeline[0] ? timeline[0].frame_idx : 0));
        setTrakeInitialKeyframeId(initialKeyframeId || (timeline[0] ? timeline[0].keyframe_id : undefined));
      };

      const handleTrakeSearch = async () => {
        setIsTrakeSearching(true);
        setTrakeError(null);
        try {
          let videoFilterList = null;
          if (trakeFilterSource === 'ranking') {
            const allRanked = [
              ...(clipboard.kisRanking || []),
              ...(clipboard.qaRanking || []),
              ...(clipboard.trakeRanking || [])
            ];
            const vids = Array.from(new Set(allRanked.map(r => r.videoId || r.video_id).filter(Boolean)));
            if (vids.length > 0) videoFilterList = vids;
          } else if (trakeFilterSource === 'note') {
            const vids = Array.from(new Set((clipboard.savedImages || []).map(r => r.videoId || r.video_id).filter(Boolean)));
            if (vids.length > 0) videoFilterList = vids;
          }

          const formattedEvents = trakeEvents.map((e, idx) => {
            const textVal = (e.text_query !== undefined ? e.text_query : (e.description || '')).trim();
            const ocrVal = (e.ocr_query || '').trim();
            const asrVal = (e.asr_query || '').trim();
            return {
              event_id: `E${idx + 1}`,
              description: textVal || ocrVal || asrVal || '',
              text_query: textVal || null,
              ocr_query: ocrVal || null,
              asr_query: asrVal || null,
              weight_text: Number(e.weight_text) || 1.0,
              weight_ocr: Number(e.weight_ocr) || 1.0,
              weight_asr: Number(e.weight_asr) || 1.0,
            };
          }).filter(e => e.text_query || e.ocr_query || e.asr_query || e.description);

          if (formattedEvents.length === 0) throw new Error("Vui lòng nhập mô tả hoặc chữ/âm thanh cho ít nhất 1 sự kiện!");

          const payload = {
            global_context: trakeContext.trim() || null,
            events: formattedEvents,
            top_k_videos: topK,
            video_list: videoFilterList,
            use_ocr: false,
            use_asr: false
          };

          const res = await fetch(`http://${window.location.hostname}:8888/api/v1/trake/solve`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });

          const data = await res.json();
          if (!res.ok) throw new Error(data.detail || "Lỗi gọi API TRAKE");
          setTrakeResults(data.data || []);
          if (!data.data || data.data.length === 0) {
            showToast('Không tìm thấy chuỗi sự kiện phù hợp', 'info');
          } else {
            showToast(`Tìm thấy ${data.data.length} video khớp với các mốc TRAKE!`, 'success');
          }
        } catch (err) {
          setTrakeError(err.message);
          showToast(`Lỗi: ${err.message}`, 'error');
        } finally {
          setIsTrakeSearching(false);
        }
      };

      const notedKeyframeIds = React.useMemo(
        () => new Set((clipboard.savedImages || []).map((img) => img.keyframe_id || img.id)),
        [clipboard.savedImages]
      );

      const kisKeyframeIds = React.useMemo(
        () => new Set((clipboard.kisRanking || []).map((r) => r.keyframe_id || r.id)),
        [clipboard.kisRanking]
      );

      const qaKeyframeIds = React.useMemo(
        () => new Set((clipboard.qaRanking || []).map((r) => r.keyframe_id || r.id)),
        [clipboard.qaRanking]
      );

      const trakeVideoIds = React.useMemo(
        () => new Set((clipboard.trakeRanking || []).map((r) => r.video_id || r.videoId)),
        [clipboard.trakeRanking]
      );

      const rankingKeyframeIds = React.useMemo(() => {
        const set = new Set();
        (clipboard.kisRanking || []).forEach(r => set.add(r.keyframe_id || r.id));
        (clipboard.qaRanking || []).forEach(r => set.add(r.keyframe_id || r.id));
        (clipboard.trakeRanking || []).forEach(r => (r.timeline || []).forEach(f => set.add(f.keyframe_id)));
        return set;
      }, [clipboard.kisRanking, clipboard.qaRanking, clipboard.trakeRanking]);

      // Real-time Shared Clipboard WebSocket Hook
      React.useEffect(() => {
        let ws = null;
        let reconnectTimer = null;
        let pingInterval = null;
        let isComponentMounted = true;

        const getWsUrl = () => {
          const isHttps = window.location.protocol === 'https:';
          const protocol = isHttps ? 'wss:' : 'ws:';
          const hostname = window.location.hostname || 'localhost';
          const port = window.location.port;
          const host = (port === '8888') ? window.location.host : `${hostname}:8888`;
          return `${protocol}//${host}/ws/clipboard`;
        };

        const connect = () => {
          if (!isComponentMounted) return;
          try {
            setWsStatus('connecting');
            const url = getWsUrl();
            ws = new WebSocket(url);
            wsRef.current = ws;

            ws.onopen = () => {
              if (!isComponentMounted) return;
              setWsStatus('connected');
              pingInterval = setInterval(() => {
                if (ws && ws.readyState === WebSocket.OPEN) {
                  ws.send(JSON.stringify({ type: 'PING' }));
                }
              }, 25000);
            };

            ws.onmessage = (event) => {
              if (!isComponentMounted) return;
              try {
                const msg = JSON.parse(event.data);
                if (msg.type === 'INIT') {
                  if (msg.data) {
                    isRemoteSyncRef.current = true;
                    setClipboard(msg.data);
                    persistClipboard(msg.data);
                    setTimeout(() => { isRemoteSyncRef.current = false; }, 50);
                  }
                  if (msg.onlineUsers !== undefined) setOnlineUsers(msg.onlineUsers);
                } else if (msg.type === 'SYNC') {
                  if (msg.data) {
                    isRemoteSyncRef.current = true;
                    setClipboard(msg.data);
                    persistClipboard(msg.data);
                    setTimeout(() => { isRemoteSyncRef.current = false; }, 50);
                    if (msg.action && msg.action !== 'UPDATE') {
                      showToast(`Đồng đội vừa cập nhật: ${msg.action}`, 'info');
                    }
                  }
                  if (msg.onlineUsers !== undefined) setOnlineUsers(msg.onlineUsers);
                } else if (msg.type === 'PRESENCE') {
                  if (msg.onlineUsers !== undefined) setOnlineUsers(msg.onlineUsers);
                }
              } catch (e) {
                console.error('Error parsing WS message:', e);
              }
            };

            ws.onerror = () => {
              if (isComponentMounted) setWsStatus('offline');
            };

            ws.onclose = () => {
              if (isComponentMounted) {
                setWsStatus('offline');
                if (pingInterval) clearInterval(pingInterval);
                reconnectTimer = setTimeout(connect, 2500);
              }
            };
          } catch (err) {
            if (isComponentMounted) {
              setWsStatus('offline');
              reconnectTimer = setTimeout(connect, 3000);
            }
          }
        };

        // Initial fetch via REST just in case, then connect WS
        fetch(`http://${window.location.hostname}:8888/api/clipboard`)
          .then(r => r.json())
          .then(res => {
            if (res && res.data && isComponentMounted) {
              isRemoteSyncRef.current = true;
              setClipboard(res.data);
              persistClipboard(res.data);
              if (res.onlineUsers) setOnlineUsers(res.onlineUsers);
              setTimeout(() => { isRemoteSyncRef.current = false; }, 50);
            }
          })
          .catch(() => {})
          .finally(() => {
            connect();
          });

        return () => {
          isComponentMounted = false;
          if (pingInterval) clearInterval(pingInterval);
          if (reconnectTimer) clearTimeout(reconnectTimer);
          if (ws) ws.close();
        };
      }, []);

      const updateClipboard = (next, actionName = 'Cập nhật Clipboard') => {
        setClipboard(next);
        persistClipboard(next);

        if (wsRef.current && wsRef.current.readyState === WebSocket.OPEN) {
          wsRef.current.send(JSON.stringify({
            type: 'UPDATE',
            data: next,
            action: actionName,
            sender: 'User',
          }));
        } else {
          fetch(`http://${window.location.hostname}:8888/api/clipboard`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ data: next, action: actionName }),
          }).catch(() => {});
        }
      };

      const showToast = (message, tone = 'success') => setToast({ message, tone, id: Date.now() });

      // Hook to handle real-time query execution timer
      const startTimeRef = React.useRef(0);
      React.useEffect(() => {
        let intervalId;
        const activeSearch = isSearching || isTrakeSearching || isTemporalSearching;

        if (activeSearch) {
          const start = performance.now();
          startTimeRef.current = start;
          setStartTime(start);
          setQueryTime('0.00');
          intervalId = setInterval(() => {
            const current = performance.now();
            setQueryTime(((current - start) / 1000).toFixed(2));
          }, 50);
        } else {
          if (startTimeRef.current > 0) {
            const end = performance.now();
            setQueryTime(((end - startTimeRef.current) / 1000).toFixed(2));
          }
        }
        return () => {
          if (intervalId) clearInterval(intervalId);
        };
      }, [isSearching, isTrakeSearching, isTemporalSearching]);

      const handleNoteImage = (imageData) => {
        const entry = { ...imageData, id: makeClipboardId(), savedAt: new Date().toISOString() };
        const { data, added } = pushSavedImage(clipboard, entry);
        if (added) {
          updateClipboard(data, 'Lưu ảnh vào Note');
          showToast('Đã lưu ảnh vào Note', 'success');
        } else {
          showToast('Ảnh đã có trong Note', 'info');
        }
      };

      const handleRestoreQuery = (entry) => {
        const restored = (entry.panels || []).map((p, i) => ({
          id: `panel-${Date.now()}-${i}`,
          type: p.type || 'text',
          query: p.query || '',
          enabled: p.enabled !== false,
        }));
        setPanels(restored.length > 0 ? restored : [createDefaultPanel(1)]);
        if (entry.topK) setTopK(entry.topK);
        setViewMode('search');
        showToast('Đã tải lại query — bấm Tìm kiếm để chạy', 'info');
      };

      const handleClearClipboard = () => {
        updateClipboard({ kisRanking: [], qaRanking: [], trakeRanking: [], savedImages: [], queryHistory: [], noteText: '' }, 'Xóa toàn bộ Clipboard');
        showToast('Đã xóa toàn bộ Clipboard', 'info');
      };

      const handleClearKis = () => {
        updateClipboard({ ...clipboard, kisRanking: [] }, 'Xóa danh sách KIS');
        showToast('Đã xóa danh sách KIS', 'info');
      };

      const handleClearQa = () => {
        updateClipboard({ ...clipboard, qaRanking: [] }, 'Xóa danh sách Q&A');
        showToast('Đã xóa danh sách Q&A', 'info');
      };

      const handleClearTrake = () => {
        updateClipboard({ ...clipboard, trakeRanking: [] }, 'Xóa danh sách TRAKE');
        showToast('Đã xóa danh sách TRAKE', 'info');
      };

      const handleRemoveSavedImage = (imageId) => {
        const next = {
          ...clipboard,
          savedImages: (clipboard.savedImages || []).filter((img) => img.id !== imageId),
        };
        updateClipboard(next, 'Xóa ảnh khỏi Note');
      };

      // 1. KIS Handlers
      const handleAddToKisRanking = (item) => {
        const entry = { ...item, id: makeClipboardId(), rankedAt: new Date().toISOString() };
        const { data, added } = pushKisRanking(clipboard, entry);
        if (added) {
          updateClipboard(data, `Thêm ${item.videoId || 'ảnh'} vào KIS Ranking`);
          showToast('Đã thêm vào KIS Ranking', 'success');
        } else {
          showToast('Frame đã có trong KIS Ranking', 'info');
        }
      };

      const handleMoveKisUp = (idx) => {
        if (idx <= 0) return;
        const next = [...(clipboard.kisRanking || [])];
        [next[idx - 1], next[idx]] = [next[idx], next[idx - 1]];
        const data = { ...clipboard, kisRanking: next };
        updateClipboard(data, 'Đổi thứ hạng KIS lên');
      };

      const handleMoveKisDown = (idx) => {
        if (idx >= (clipboard.kisRanking || []).length - 1) return;
        const next = [...(clipboard.kisRanking || [])];
        [next[idx + 1], next[idx]] = [next[idx], next[idx + 1]];
        const data = { ...clipboard, kisRanking: next };
        updateClipboard(data, 'Đổi thứ hạng KIS xuống');
      };

      const handleRemoveKisItem = (idx) => {
        const data = { ...clipboard, kisRanking: (clipboard.kisRanking || []).filter((_, i) => i !== idx) };
        updateClipboard(data, 'Xóa ảnh khỏi KIS');
      };

      const handleJumpKisRank = (fromIdx, targetIdx) => {
        const list = [...(clipboard.kisRanking || [])];
        if (fromIdx < 0 || fromIdx >= list.length) return;
        const clampedTarget = Math.max(0, Math.min(list.length - 1, targetIdx));
        if (fromIdx === clampedTarget) return;

        const [movedItem] = list.splice(fromIdx, 1);
        list.splice(clampedTarget, 0, movedItem);

        const updated = { ...clipboard, kisRanking: list };
        updateClipboard(updated, `Chuyển ${movedItem.videoId || 'ảnh'} đến hạng #${clampedTarget + 1}`);
        showToast(`Đã chuyển ${movedItem.videoId || 'ảnh'} đến hạng #${clampedTarget + 1}!`, 'success');
      };

      const handleAutoFillKisTop100 = () => {
        const currentKis = clipboard.kisRanking || [];
        if (currentKis.length >= 100) {
          showToast('Danh sách KIS đã đủ 100 kết quả!', 'info');
          return;
        }
        if (!results || results.length === 0) {
          showToast('Chưa có kết quả tìm kiếm nào trong tab Search để điền!', 'info');
          return;
        }
        const existingIds = new Set(currentKis.map(item => item.keyframe_id || item.id));
        const additions = [];

        for (const res of results) {
          const id = res.keyframe_id || res.id;
          if (!existingIds.has(id)) {
            additions.push({
              id: id,
              keyframe_id: id,
              videoId: res.videoId || res.video_id,
              videoTitle: res.videoTitle || res.video_id,
              frameId: res.frameId !== undefined ? res.frameId : res.frame_idx,
              timestamp: res.timestamp,
              pts_time: res.pts_time,
              thumbnailUrl: res.thumbnailUrl,
              score: res.score || 0,
              matchedSources: res.matchedSources || [],
              caption: res.caption || res.keyframe_id,
              rankedAt: new Date().toISOString(),
            });
            existingIds.add(id);
            if (currentKis.length + additions.length >= 100) break;
          }
        }

        if (additions.length === 0) {
          showToast('Tất cả kết quả tìm kiếm hiện tại đã có trong KIS Ranking!', 'info');
          return;
        }

        const updatedKis = [...currentKis, ...additions];
        const newClipboard = { ...clipboard, kisRanking: updatedKis };
        updateClipboard(newClipboard, `Auto-fill thêm ${additions.length} ảnh vào KIS`);
        showToast(`Đã tự động điền thêm ${additions.length} ảnh vào KIS Ranking (Tổng: ${updatedKis.length}/100)!`, 'success');
      };

      const handleJumpQaRank = (fromIdx, targetIdx) => {
        const list = [...(clipboard.qaRanking || [])];
        if (fromIdx < 0 || fromIdx >= list.length) return;
        const clampedTarget = Math.max(0, Math.min(list.length - 1, targetIdx));
        if (fromIdx === clampedTarget) return;

        const [movedItem] = list.splice(fromIdx, 1);
        list.splice(clampedTarget, 0, movedItem);

        const updated = { ...clipboard, qaRanking: list };
        updateClipboard(updated, `Chuyển ${movedItem.videoId || 'câu hỏi'} đến hạng #${clampedTarget + 1}`);
        showToast(`Đã chuyển ${movedItem.videoId || 'mục'} đến hạng #${clampedTarget + 1}!`, 'success');
      };

      const handleJumpTrakeRank = (fromIdx, targetIdx) => {
        const list = [...(clipboard.trakeRanking || [])];
        if (fromIdx < 0 || fromIdx >= list.length) return;
        const clampedTarget = Math.max(0, Math.min(list.length - 1, targetIdx));
        if (fromIdx === clampedTarget) return;

        const [movedItem] = list.splice(fromIdx, 1);
        list.splice(clampedTarget, 0, movedItem);

        const updated = { ...clipboard, trakeRanking: list };
        updateClipboard(updated, `Chuyển chuỗi ${movedItem.video_id || 'video'} đến hạng #${clampedTarget + 1}`);
        showToast(`Đã chuyển chuỗi ${movedItem.video_id || 'video'} đến hạng #${clampedTarget + 1}!`, 'success');
      };

      // 2. Q&A Handlers
      const handleAddToQaRanking = (item) => {
        const entry = { ...item, id: makeClipboardId(), rankedAt: new Date().toISOString() };
        const { data, added, updated } = pushQaRanking(clipboard, entry);
        if (added) {
          updateClipboard(data, `Thêm ${item.videoId || 'câu hỏi'} vào Q&A Ranking`);
          showToast(item.answer ? 'Đã thêm vào Q&A Ranking (kèm Answer)' : 'Đã thêm vào Q&A Ranking', 'success');
        } else if (updated) {
          updateClipboard(data, `Cập nhật đáp án "${item.answer}" trong Q&A`);
          showToast(`Đã cập nhật Answer: "${item.answer}" trong Q&A`, 'success');
        } else {
          showToast('Frame đã có trong Q&A Ranking', 'info');
        }
      };

      const handleMoveQaUp = (idx) => {
        if (idx <= 0) return;
        const next = [...(clipboard.qaRanking || [])];
        [next[idx - 1], next[idx]] = [next[idx], next[idx - 1]];
        const data = { ...clipboard, qaRanking: next };
        updateClipboard(data, 'Đổi thứ hạng Q&A lên');
      };

      const handleMoveQaDown = (idx) => {
        if (idx >= (clipboard.qaRanking || []).length - 1) return;
        const next = [...(clipboard.qaRanking || [])];
        [next[idx + 1], next[idx]] = [next[idx], next[idx + 1]];
        const data = { ...clipboard, qaRanking: next };
        updateClipboard(data, 'Đổi thứ hạng Q&A xuống');
      };

      const handleRemoveQaItem = (idx) => {
        const data = { ...clipboard, qaRanking: (clipboard.qaRanking || []).filter((_, i) => i !== idx) };
        updateClipboard(data, 'Xóa câu hỏi khỏi Q&A');
      };

      const handleUpdateQaAnswer = (idx, newAnswer) => {
        const next = [...(clipboard.qaRanking || [])];
        if (next[idx]) {
          next[idx] = { ...next[idx], answer: newAnswer };
        }
        const data = { ...clipboard, qaRanking: next };
        updateClipboard(data, 'Cập nhật đáp án Q&A');
      };

      const handleAutoFillQaTop100 = (defaultAnswer = '') => {
        const currentQa = clipboard.qaRanking || [];
        if (currentQa.length >= 100) {
          showToast('Danh sách Q&A đã đủ 100 kết quả!', 'info');
          return;
        }
        if (!results || results.length === 0) {
          showToast('Chưa có kết quả tìm kiếm nào trong tab Search để điền!', 'info');
          return;
        }
        const existingIds = new Set(currentQa.map(item => item.keyframe_id || item.id));
        const additions = [];

        for (const res of results) {
          const id = res.keyframe_id || res.id;
          if (!existingIds.has(id)) {
            additions.push({
              id: id,
              keyframe_id: id,
              videoId: res.videoId || res.video_id,
              videoTitle: res.videoTitle || res.video_id,
              frameId: res.frameId !== undefined ? res.frameId : res.frame_idx,
              timestamp: res.timestamp,
              pts_time: res.pts_time,
              thumbnailUrl: res.thumbnailUrl,
              answer: defaultAnswer ? defaultAnswer.trim() : '',
              score: res.score || 0,
              matchedSources: res.matchedSources || [],
              caption: res.caption || res.keyframe_id,
              rankedAt: new Date().toISOString(),
            });
            existingIds.add(id);
            if (currentQa.length + additions.length >= 100) break;
          }
        }

        if (additions.length === 0) {
          showToast('Tất cả kết quả tìm kiếm hiện tại đã có trong Q&A Ranking!', 'info');
          return;
        }

        const updatedQa = [...currentQa, ...additions];
        const newClipboard = { ...clipboard, qaRanking: updatedQa };
        updateClipboard(newClipboard, `Auto-fill thêm ${additions.length} frame vào Q&A`);
        showToast(`Đã tự động điền thêm ${additions.length} frame vào Q&A Ranking (Tổng: ${updatedQa.length}/100)!`, 'success');
      };

      // 3. TRAKE Handlers
      const handleAddToTrakeRanking = (vidResult) => {
        const entry = { ...vidResult, id: makeClipboardId(), rankedAt: new Date().toISOString() };
        const { data, added, updated } = pushTrakeRanking(clipboard, entry);
        if (added) {
          updateClipboard(data, `Thêm video ${vidResult.video_id} vào TRAKE`);
          showToast(`Đã thêm video ${vidResult.video_id} vào TRAKE Ranking!`, 'success');
        } else if (updated) {
          updateClipboard(data, `Cập nhật video ${vidResult.video_id} trong TRAKE`);
          showToast(`Đã cập nhật video ${vidResult.video_id} trong TRAKE Ranking!`, 'success');
        } else {
          showToast('Video đã có trong TRAKE Ranking', 'info');
        }
      };

      const handleMoveTrakeUp = (idx) => {
        if (idx <= 0) return;
        setClipboard((prev) => {
          const next = [...(prev.trakeRanking || [])];
          [next[idx - 1], next[idx]] = [next[idx], next[idx - 1]];
          const data = { ...prev, trakeRanking: next };
          persistClipboard(data);
          return data;
        });
      };

      const handleMoveTrakeDown = (idx) => {
        setClipboard((prev) => {
          if (idx >= (prev.trakeRanking || []).length - 1) return prev;
          const next = [...(prev.trakeRanking || [])];
          [next[idx + 1], next[idx]] = [next[idx], next[idx + 1]];
          const data = { ...prev, trakeRanking: next };
          persistClipboard(data);
          return data;
        });
      };

      const handleRemoveTrakeItem = (idx) => {
        setClipboard((prev) => {
          const data = { ...prev, trakeRanking: (prev.trakeRanking || []).filter((_, i) => i !== idx) };
          persistClipboard(data);
          return data;
        });
      };

      const handleAutoFillTrakeTop100 = () => {
        const currentTrake = clipboard.trakeRanking || [];
        if (currentTrake.length >= 100) {
          showToast('Danh sách TRAKE đã đủ 100 chuỗi video!', 'info');
          return;
        }
        const sourceResults = (trakeResults && trakeResults.length > 0) ? trakeResults : temporalResults;
        if (!sourceResults || sourceResults.length === 0) {
          showToast('Chưa có kết quả chuỗi video nào trong tab TRAKE để điền!', 'info');
          return;
        }

        const existingVids = new Set(currentTrake.map(item => item.video_id || item.videoId));
        const additions = [];

        for (const vidItem of sourceResults) {
          const vId = vidItem.video_id || vidItem.videoId;
          if (vId && !existingVids.has(vId)) {
            additions.push({
              ...vidItem,
              id: makeClipboardId(),
              video_id: vId,
              videoId: vId,
              rankedAt: new Date().toISOString(),
            });
            existingVids.add(vId);
            if (currentTrake.length + additions.length >= 100) break;
          }
        }

        if (additions.length === 0) {
          showToast('Tất cả chuỗi video tìm kiếm hiện tại đã có trong TRAKE Ranking!', 'info');
          return;
        }

        const updatedTrake = [...currentTrake, ...additions];
        const newClipboard = { ...clipboard, trakeRanking: updatedTrake };
        updateClipboard(newClipboard);
        showToast(`Đã tự động điền thêm ${additions.length} chuỗi video vào TRAKE Ranking (Tổng: ${updatedTrake.length}/100)!`, 'success');
      };

      const handleSetNoteText = (text) => {
        setClipboard((prev) => {
          const data = { ...prev, noteText: text };
          persistClipboard(data);
          return data;
        });
      };

      const handleSelectClipboardImage = (img) => {
        setSelectedResult({
          id: img.keyframe_id || img.id,
          keyframe_id: img.keyframe_id || img.id,
          rank: img.rank,
          videoId: img.videoId,
          videoTitle: img.videoTitle || img.videoId,
          frameId: img.frameId,
          timestamp: img.timestamp,
          pts_time: img.pts_time,
          score: img.score,
          matchedSources: img.matchedSources || [],
          caption: img.caption || img.keyframe_id,
          thumbnailUrl: img.thumbnailUrl,
        });
      };

      const saveSearchToClipboard = (activePanels, sourcesUsed, resultCount, elapsedTime) => {
        const entry = {
          id: makeClipboardId(),
          savedAt: new Date().toISOString(),
          panels: activePanels.map((p) => ({ type: p.type, query: p.query.trim(), enabled: true })),
          sourcesUsed: sourcesUsed || [],
          topK,
          resultCount,
          queryTime: elapsedTime,
        };
        setClipboard((prev) => {
          const next = pushQueryHistory(prev, entry);
          persistClipboard(next);
          return next;
        });
      };

      const handleReset = () => { setPanels([createDefaultPanel(1)]); setResults([]); setSelectedResult(null); setSearchError(null); setQueryTime(null); setStartTime(null); setViewMode('search'); };
      const handleUpdatePanel = (u) => setPanels((prev) => prev.map((p) => (p.id === u.id ? u : p)));
      const handleAddPanel = () => setPanels((prev) => [...prev, createDefaultPanel(prev.length + 1)]);
      const handleRemovePanel = () => setPanels((prev) => (prev.length <= 1 ? prev : prev.slice(0, prev.length - 1)));

      const BACKEND_PORT = '8888';
      const currentBackendUrl = `${window.location.protocol}//${window.location.hostname}:${BACKEND_PORT}/api/search`;

      const handleSearch = async () => {
        setIsSearching(true);
        setSearchError(null);
        const searchStart = performance.now();

        const activePanels = panels.filter((p) => p.enabled && p.query.trim() !== '');

        if (activePanels.length === 0) {
          setResults(MOCK_RESULTS.slice(0, topK));
          setIsSearching(false);
          return;
        }

        const payload = { top_k: topK, rrf_k: 60, video_list: [] };
        activePanels.forEach((p) => {
          const q = p.query.trim();
          if (!q) return;
          if (p.type === 'ocr') payload.ocr_query = q;
          else if (p.type === 'asr') payload.asr_query = q;
          else payload.semantic_query = q;
        });

        try {
          const res = await fetch(currentBackendUrl, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });

          let data;
          try { data = await res.json(); } catch { throw new Error(`Server (${currentBackendUrl}) trả về HTTP ${res.status} nhưng phản hồi không phải JSON.`); }
          if (!res.ok) throw new Error(data?.detail || `HTTP ${res.status}: ${res.statusText || 'request failed'}`);

          if (!data || !Array.isArray(data.results)) {
            throw new Error('Backend trả về định dạng dữ liệu không hợp lệ.');
          }

          if (data.results.length === 0) {
            // KHÔNG throw nữa: kết quả rỗng là bình thường (không tìm thấy), UI hiện 0 kết quả + toast
            const elapsed = ((performance.now() - searchStart) / 1000).toFixed(2);
            saveSearchToClipboard(activePanels, data.sources_used || [], 0, elapsed);
            setResults([]);
            setSearchError('');
            showToast('Không tìm thấy kết quả nào phù hợp với truy vấn.', 'info');
            return;
          }

          const elapsed = ((performance.now() - searchStart) / 1000).toFixed(2);
          saveSearchToClipboard(activePanels, data.sources_used || [], data.results.length, elapsed);

          const mapped = data.results.map((item, idx) => {
            const rawUrl = item.image_url || '';
            let fullUrl;
            if (rawUrl.startsWith('http')) {
              try {
                const u = new URL(rawUrl);
                fullUrl = `${window.location.origin}${u.pathname}`;
              } catch { fullUrl = rawUrl; }
            } else {
              fullUrl = rawUrl.startsWith('/') ? `${window.location.origin}${rawUrl}` : rawUrl;
            }
            return {
              id: item.keyframe_id || `res-${idx}`,
              keyframe_id: item.keyframe_id || '',
              rank: item.rank ?? (idx + 1),
              videoId: item.video_id || '',
              videoTitle: item.video_id || 'Keyframe result',
              frameId: item.frame_idx ?? '',
              timestamp: item.timestamp !== undefined && item.timestamp !== null ? item.timestamp : (item.pts_time !== undefined ? Math.round(item.pts_time * 1000) : ''),
              pts_time: item.pts_time,
              score: item.score ?? 0,
              matchedSources: item.matched_sources || [],
              caption: item.keyframe_id || item.video_id || 'Kết quả tìm kiếm',
              thumbnailUrl: fullUrl,
            };
          });
          setResults(mapped);
        } catch (err) {
          console.error('Search error:', err);
          let msg = err.message || 'Lỗi kết nối';
          if (msg === 'Failed to fetch' || err.name === 'TypeError') {
            msg = `Không thể gọi API tới ${currentBackendUrl}. Vui lòng kiểm tra lại Server Host/Port hoặc CORS network.`;
          }
          setSearchError(msg);
        } finally {
          setIsSearching(false);
        }
      };

      const totalClipboardCount = (clipboard.kisRanking || []).length +
        (clipboard.qaRanking || []).length +
        (clipboard.trakeRanking || []).length +
        (clipboard.savedImages || []).length;

      return (
        <ErrorBoundary>
          <div className="min-h-screen flex flex-col bg-slate-100">
            <Header
              onReset={handleReset}
              topK={topK}
              onChangeTopK={setTopK}
              queryTime={queryTime}
              isSearching={isSearching || isTrakeSearching || isTemporalSearching}
              viewMode={viewMode}
              onChangeViewMode={setViewMode}
              clipboardCount={totalClipboardCount}
            />
            <div className="flex flex-1 overflow-hidden">
              {viewMode === 'search' && (
                <>
                  <Sidebar panels={panels} onUpdatePanel={handleUpdatePanel} onAddPanel={handleAddPanel}
                    onRemovePanel={handleRemovePanel} onSearch={handleSearch} isSearching={isSearching} />
                  <main className="flex-1 flex flex-col min-w-0 bg-slate-100 overflow-y-auto">
                    <ResultGrid
                      results={results}
                      onSelectResult={(item) => setSelectedResult(item)}
                      isSearching={isSearching}
                      searchError={searchError}
                      onClearError={() => setSearchError(null)}
                      backendUrl={currentBackendUrl}
                      onAddToRanking={handleAddToKisRanking}
                      rankingKeyframeIds={kisKeyframeIds}
                      selectedKeyframeId={selectedResult ? (selectedResult.keyframe_id || selectedResult.id) : null}
                    />
                  </main>
                </>
              )}
              {viewMode === 'temporal' && (
                <>
                  <TemporalSidebar
                    stages={temporalStages}
                    globalContext={temporalContext}
                    contextBonusWeight={temporalBonusWeight}
                    onUpdateStage={handleUpdateTemporalStage}
                    onAddStage={handleAddTemporalStage}
                    onRemoveStage={handleRemoveTemporalStage}
                    onChangeContext={setTemporalContext}
                    onChangeBonusWeight={setTemporalBonusWeight}
                    onSearch={handleTemporalSearch}
                    isSearching={isTemporalSearching}
                    onReset={handleResetTemporal}
                    onLoadMockDemo={handleLoadMockTemporalDemo}
                    filterSource={temporalFilterSource}
                    onChangeFilterSource={setTemporalFilterSource}
                    rankingCount={(clipboard.kisRanking || []).length}
                    noteCount={(clipboard.savedImages || []).length}
                  />
                  <main className="flex-1 flex flex-col min-w-0 bg-slate-50 overflow-y-auto">
                    <TemporalResultGrid
                      results={temporalResults}
                      totalStages={temporalStages.length}
                      isSearching={isTemporalSearching}
                      error={temporalError}
                      onClearError={() => setTemporalError(null)}
                      onSelectFrame={handleSelectTemporalFrame}
                      onSelectVideo={handleSelectTemporalVideo}
                      onLoadMockDemo={handleLoadMockTemporalDemo}
                      rankingKeyframeIds={rankingKeyframeIds}
                      notedKeyframeIds={notedKeyframeIds}
                      kisKeyframeIds={kisKeyframeIds}
                      qaKeyframeIds={qaKeyframeIds}
                      onAddToKisRanking={handleAddToKisRanking}
                      onAddToQaRanking={handleAddToQaRanking}
                      showToast={showToast}
                    />
                  </main>
                </>
              )}
              {viewMode === 'trake' && (
                <>
                  <TrakeSidebar
                    context={trakeContext}
                    events={trakeEvents}
                    onChangeContext={setTrakeContext}
                    onUpdateEvent={handleUpdateTrakeEvent}
                    onAddEvent={handleAddTrakeEvent}
                    onRemoveEvent={handleRemoveTrakeEvent}
                    onReset={handleResetTrake}
                    onSearch={handleTrakeSearch}
                    isSearching={isTrakeSearching}
                    rankingCount={(clipboard.trakeRanking 