            {showVqa && (
              <div className="space-y-1">
                <input type="text" value={vqaAnswer} onChange={(e) => setVqaAnswer(e.target.value)} onKeyDown={(e) => { if (e.key === 'Enter') submitStageVqa(e); }} placeholder="Answer..." className="w-full px-1.5 py-1 rounded-md border border-purple-300 text-[9px] focus:outline-none focus:ring-1 focus:ring-purple-400" />
                <button type="button" onClick={() => onAddToQaRanking && onAddToQaRanking({ ...frameItem, answer: vqaAnswer.trim() || undefined })} disabled={isQaRanked || !vqaAnswer.trim()} className="w-full px-1.5 py-1 rounded-md text-[9px] font-bold bg-purple-50 text-purple-700 border border-purple-200 disabled:opacity-50 hover:bg-purple-600 hover:text-white">{isQaRanked ? 'Đã thêm VQA' : 'Add to VQA Rank'}</button>
                <button type="button" onClick={submitStageVqa} disabled={!vqaAnswer.trim() || vqaStatus === 'submitting'} className="w-full px-1.5 py-1 rounded-md text-[9px] font-bold bg-indigo-600 text-white disabled:opacity-50 hover:bg-indigo-700">{vqaStatus === 'submitting' ? 'Đang nộp...' : 'Submit VQA'}</button>
