                    {/* Video ID */}
                    <div className="p-3 bg-slate-50 rounded-xl border border-slate-200">
                      <div className="text-[11px] font-medium text-slate-500 mb-1 flex items-center gap-1">
                        <Icon name="film" className="w-3.5 h-3.5 text-slate-400" />
                        <span>Video ID</span>
                      </div>
                      <div className="font-mono font-bold text-slate-900 text-sm truncate" title={videoId}>
                        {videoId}
                      </div>
                    </div>

                    {/* Frame ID */}
                    <div className="p-3 bg-slate-50 rounded-xl border border-slate-200">
                      <div className="text-[11px] font-medium text-slate-500 mb-1 flex items-center gap-1">
                        <Icon name="hash" className="w-3.5 h-3.5 text-slate-400" />
                        <span>Frame ID</span>
                      </div>
                      <div className="font-mono font-bold text-sky-700 text-sm">
                        {activeFrameId}
                      </div>
                    </div>

                    {/* Timestamp (Milliseconds) */}
                    <div className="p-3 bg-sky-50/70 rounded-xl border border-sky-200/80">
                      <div className="text-[11px] font-semibold text-sky-800 mb-1 flex items-center gap-1">
                        <Icon name="clock" className="w-3.5 h-3.5 text-sky-600" />
                        <span>Timestamp (ms)</span>
                      </div>
                      <div className="font-mono font-bold text-sky-950 text-sm">
                        {activeTimestamp} ms
                      </div>
                      <div className="text-[10px] font-mono text-sky-600 font-medium truncate">
                        {formatMilliseconds(activeTimestamp)}
                      </div>
                    </div>

                    {/* Rank */}
                    <div className="p-3 bg-slate-50 rounded-xl border border-slate-200">
                      <div className="text-[11px] font-medium text-slate-500 mb-1 flex items-center gap-1">
                        <Icon name="tag" className="w-3.5 h-3.5 text-slate-400" />
                        <span>Thứ hạng (Rank)</span>
                      </div>
                      <div className="font-mono font-bold text-slate-900 text-sm">
                        #{item.rank ?? 1}
                      </div>
                    </div>
                  </div>

                  <div className="bg-purple-50/40 p-4 rounded-xl border border-purple-200/70 space-y-3">
                    <label className="block text-xs font-bold text-purple-900 flex items-center gap-1.5">
                      <Icon name="message-square" className="w-3.5 h-3.5 text-purple-600" />
                      <span>Câu trả lời (Answer) cho truy vấn Q&A:</span>
                    </label>

                    <input
                      type="text"
                      value={vqaAnswer}
                      onChange={(e) => setVqaAnswer(e.target.value)}
                      onKeyDown={(e) => {
                        if (e.key === 'Enter') {
                          e.preventDefault();
                          handleVqaSubmit();
                        }
                      }}
                      placeholder="Nhập đáp án (ví dụ: xedap, TikTok, Nike, 5, Màu đỏ)..."
                      className="w-full px-3.5 py-2.5 bg-white border border-purple-300 rounded-xl text-sm text-slate-900 font-medium placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-purple-500/20 focus:border-purple-500 shadow-sm"
                      autoFocus
                    />

                    {/* Note + Add to Ranking for VQA */}
                    <div className="grid grid-cols-2 gap-2.5 pt-1">
                      <button
                        type="button"
                        onClick={handleNote}
                        disabled={isNoted}
                        className={`py-2.5 px-4 rounded-xl font-bold text-xs flex items-center justify-center gap-2 border-2 transition-all active:scale-[0.99] ${isNoted
                          ? 'bg-amber-50 text-amber-700 border-amber-300 cursor-default'
                          : 'bg-white text-amber-700 border-amber-300 hover:bg-amber-50 hover:border-amber-400 shadow-sm'
                          }`}
                      >
                        <Icon name="bookmark" className="w-3.5 h-3.5" />
                        {isNoted ? 'Đã note ✓' : 'Note ảnh'}
                      </button>

                      <button
                        type="button"
                        onClick={handleAddToQaRankingAction}
                        className={`py-2.5 px-4 rounded-xl font-bold text-xs flex items-center justify-center gap-2 border-2 transition-all active:scale-[0.99] ${isQaRanked && !vqaAnswer.trim()
                          ? 'bg-emerald-50 text-emerald-700 border-emerald-300 cursor-default'
                          : 'bg-white text-purple-700 border-purple-300 hover:bg-purple-50 hover:border-purple-400 shadow-sm'
                          }`}
                      >
                        <Icon name={isQaRanked ? 'check-circle' : 'tag'} className="w-3.5 h-3.5" />
                        {isQaRanked ? (vqaAnswer.trim() ? 'Cập nhật Q&A Ranking (kèm Answer) ✓' : 'Đã có trong Q&A Ranking ✓') : 'Add to Q&A Ranking (kèm Answer)'}
                      </button>
                    </div>

                    <button
                      onClick={handleVqaSubmit}
                      disabled={vqaSubmitStatus === 'submitting' || !vqaAnswer.trim()}
                      className={`w-full py-3 px-6 rounded-xl font-bold text-sm text-white flex items-center justify-center gap-2 shadow-md transition-all active:scale-[0.99] ${vqaSubmitStatus === 'submitting'
                        ? 'bg-purple-800 cursor-wait'
                        : !vqaAnswer.trim()
                          ? 'bg-slate-300 text-slate-500 cursor-not-allowed shadow-none'
                          : 'bg-gradient-to-r from-purple-600 to-indigo-700 hover:from-purple-500 hover:to-indigo-600 shadow-purple-500/25 ring-2 ring-purple-400/30'
                        }`}
                    >
                      {vqaSubmitStatus === 'submitting' ? (
                        <>
                          <div className="w-4 h-4 border-2 border-white border-t-transparent rounded-full animate-spin"></div>
                          <span>Đang nộp VQA...</span>
                        </>
                      ) : (
                        <>
                          <Icon name="send" className="w-4 h-4" />
                          <span>Submit VQA lên DRES</span>
                          <kbd className="bg-black/25 text-white/90 px-2 py-0.5 rounded text-xs font-mono font-semibold">
                            Enter
                          </kbd>
                        </>
                      )}
                    </button>
                  </div>

                  {/* VQA Feedback Result */}
                  {vqaSubmitResult && (
                    <div
                      className={`p-3 rounded-xl border flex items-center gap-2.5 transition-all animate-fade-in ${vqaSubmitResult.status
                        ? 'bg-emerald-50 border-emerald-300 text-emerald-900 font-bold text-xs'
                        : 'bg-rose-50 border-rose-300 text-rose-900 font-bold text-xs'
                        }`}
                    >
                      {vqaSubmitResult.status ? (
                        <span className="text-base">✅</span>
                      ) : (
                        <span className="text-base">❌</span>
                      )}
                      <span>{vqaSubmitResult.status ? '✓ Submitted' : `Submission failed: ${vqaSubmitResult.description}`}</span>
                    </div>
                  )}
                </div>
              )}

            </div>

            {/* Bottom Footer Close */}
            <div className="bg-slate-50 px-4 py-3 border-t border-slate-200 flex items-center justify-between">
              <div className="text-[11px] text-slate-500 font-mono">
                {mode === 'semantic' ? `${activeKeyframeId} • ${activeTimestamp} ms` : 'VQA Mode'}
              </div>
              <button
                onClick={onClose}
                className="py-1.5 px-4 bg-slate-800 hover:bg-slate-700 text-white font-semibold text-xs rounded-lg shadow transition-colors"
              >
                Đóng lại (Esc)
              </button>
            </div>

          </div>
        </div>
      );
    }

    function ClipboardPanel({
      clipboard,
      onRestoreQuery,
      onSelectImage,
      onRemoveImage,
      onClearAll,
      onClearKis,
      onClearQa,
      onClearTrake,
      onSelectRankingItem,
      onMoveKisUp,
      onMoveKisDown,
      onRemoveKisItem,
      onJumpKisRank,
      onAutoFillKisTop100,
      searchResultsCount = 0,
      onMoveQaUp,
      onMoveQaDown,
      onRemoveQaItem,
      onJumpQaRank,
      onAutoFillQaTop100,
      onUpdateQaAnswer,
      onMoveTrakeUp,
      onMoveTrakeDown,
      onRemoveTrakeItem,
      onJumpTrakeRank,
      onAutoFillTrakeTop100,
      trakeResultsCount = 0,
      onSetNoteText,
      onSwitchToTrakeWithRanking,
      onOpenTrakeForVideo,
      onOpenTrakeForVidResult,
      showToast,
      wsStatus = 'connected',
      onlineUsers = 1,
    }) {
      const [confirmClear, setConfirmClear] = useState(false);
      const [activeTab, setActiveTab] = useState('kis'); // 'kis' | 'qa' | 'trake' | 'note' | 'history'
      const [bulkQaAnswer, setBulkQaAnswer] = useState('');

      const [jumpingKisIdx, setJumpingKisIdx] = useState(null);
      const [targetKisRank, setTargetKisRank] = useState('');
      const [jumpingQaIdx, setJumpingQaIdx] = useState(null);
      const [targetQaRank, setTargetQaRank] = useState('');
      const [jumpingTrakeIdx, setJumpingTrakeIdx] = useState(null);
      const [targetTrakeRank, setTargetTrakeRank] = useState('');

      const kisList = clipboard.kisRanking || [];
      const qaList = clipboard.qaRanking || [];
      const trakeList = clipboard.trakeRanking || [];
      const noteList = clipboard.savedImages || [];
      const historyList = clipboard.queryHistory || [];

      const totalItems = kisList.length + qaList.length + trakeList.length + noteList.length + historyList.length;
      const hasItems = totalItems > 0;

      const handleClear = () => {
        if (!confirmClear) {
          setConfirmClear(true);
          return;
        }
        onClearAll();
        setConfirmClear(false);
      };

      const copyText = (txt, msg) => {
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(txt).then(() => {
            if (showToast) showToast(msg || 'Đã sao chép vào bộ nhớ tạm!', 'success');
          }).catch(() => {
            if (showToast) showToast('Không thể sao chép!', 'error');
          });
        }
      };

      const handleConfirmKisJump = (fromIdx) => {
        const target = parseInt(targetKisRank, 10);
        if (isNaN(target) || target < 1) {
          if (showToast) showToast('Vui lòng nhập thứ hạng từ 1 trở lên', 'info');
          return;
        }
        if (onJumpKisRank) onJumpKisRank(fromIdx, target - 1);
        setJumpingKisIdx(null);
      };

      const handleConfirmQaJump = (fromIdx) => {
        const target = parseInt(targetQaRank, 10);
        if (isNaN(target) || target < 1) {
          if (showToast) showToast('Vui lòng nhập thứ hạng từ 1 trở lên', 'info');
          return;
        }
        if (onJumpQaRank) onJumpQaRank(fromIdx, target - 1);
        setJumpingQaIdx(null);
      };

      const handleConfirmTrakeJump = (fromIdx) => {
        const target = parseInt(targetTrakeRank, 10);
        if (isNaN(target) || target < 1) {
          if (showToast) showToast('Vui lòng nhập thứ hạng từ 1 trở lên', 'info');
          return;
        }
        if (onJumpTrakeRank) onJumpTrakeRank(fromIdx, target - 1);
        setJumpingTrakeIdx(null);
      };

      const handleExportKisCsv = () => {
        if (kisList.length === 0) {
          if (showToast) showToast('Danh sách KIS đang trống!', 'info');
          return;
        }
        const csv = buildKisCsv(kisList);
        downloadCsvFile(csv, 'query-1-kis.csv');
        if (showToast) showToast(`Đã xuất file query-1-kis.csv (${kisList.length} dòng)`, 'success');
      };

      const handleCopyKisCsv = () => {
        if (kisList.length === 0) {
          if (showToast) showToast('Danh sách KIS đang trống!', 'info');
          return;
        }
        const csv = buildKisCsv(kisList);
        copyText(csv, `Đã sao chép ${kisList.length} dòng CSV KIS!`);
      };

      const handleExportQaCsv = () => {
        if (qaList.length === 0) {
          if (showToast) showToast('Danh sách Q&A đang trống!', 'info');
          return;
        }
        const csv = buildQaCsv(qaList);
        downloadCsvFile(csv, 'query-2-qa.csv');
        if (showToast) showToast(`Đã xuất file query-2-qa.csv (${qaList.length} dòng)`, 'success');
      };

      const handleCopyQaCsv = () => {
        if (qaList.length === 0) {
          if (showToast) showToast('Danh sách Q&A đang trống!', 'info');
          return;
        }
        const csv = buildQaCsv(qaList);
        copyText(csv, `Đã sao chép ${qaList.length} dòng CSV Q&A!`);
      };

      const handleApplyBulkQaAnswer = () => {
        if (!bulkQaAnswer.trim()) {
          if (showToast) showToast('Vui lòng nhập câu trả lời cần gán!', 'info');
          return;
        }
        if (qaList.length === 0) {
          if (showToast) showToast('Danh sách Q&A đang trống!', 'info');
          return;
        }
        qaList.forEach((_, idx) => {
          if (onUpdateQaAnswer) onUpdateQaAnswer(idx, bulkQaAnswer.trim());
        });
        if (showToast) showToast(`Đã gán đáp án "${bulkQaAnswer.trim()}" cho toàn bộ ${qaList.length} kết quả Q&A!`, 'success');
        setBulkQaAnswer('');
      };

      const handleExportTrakeCsv = () => {
        if (trakeList.length === 0) {
          if (showToast) showToast('Danh sách TRAKE đang trống!', 'info');
          return;
        }
        const csv = buildTrakeCsv(trakeList);
        downloadCsvFile(csv, 'query-3-trake.csv');
        if (showToast) showToast(`Đã xuất file query-3-trake.csv (${trakeList.length} dòng)`, 'success');
      };

      const handleCopyTrakeCsv = () => {
        if (trakeList.length === 0) {
          if (showToast) showToast('Danh sách TRAKE đang trống!', 'info');
          return;
        }
        const csv = buildTrakeCsv(trakeList);
        copyText(csv, `Đã sao chép ${trakeList.length} dòng CSV TRAKE!`);
      };

      const tabs = [
        { key: 'kis', label: '1. Textual KIS', icon: 'search', count: kisList.length, color: 'sky' },
        { key: 'qa', label: '2. Q&A (VQA)', icon: 'message-square', count: qaList.length, color: 'purple' },
        { key: 'trake', label: '3. TRAKE', icon: 'sparkles', count: trakeList.length, color: 'indigo' },
        { key: 'note', label: 'Note ảnh', icon: 'bookmark', count: noteList.length, color: 'amber' },
        { key: 'history', label: 'Lịch sử Query', icon: 'history', count: historyList.length, color: 'slate' },
      ];

      const buildRankingBadgeCls = (rank) => {
        if (rank === 1) return 'bg-gradient-to-br from-amber-400 to-amber-500 text-white border-amber-500 shadow-sm shadow-amber-200';
        if (rank === 2) return 'bg-gradient-to-br from-slate-300 to-slate-400 text-white border-slate-400';
        if (rank === 3) return 'bg-gradient-to-br from-orange-300 to-orange-400 text-white border-orange-400';
        return 'bg-slate-100 text-slate-600 border-slate-200';
      };

      const arrowUp = (
        <svg className="w-3.5 h-3.5" fill="none" stroke="currentColor" strokeWidth="2.5" viewBox="0 0 24 24"><polyline points="18 15 12 9 6 15" strokeLinecap="round" strokeLinejoin="round" /></svg>
      );
      const arrowDown = (
        <svg className="w-3.5 h-3.5" fill="none" stroke="currentColor" strokeWidth="2.5" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9" strokeLinecap="round" strokeLinejoin="round" /></svg>
      );

      return (
        <div className="flex-1 overflow-y-auto bg-gradient-to-b from-slate-50 to-slate-100">
          <div className="max-w-6xl mx-auto p-6 space-y-5">
            <div className="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4">
              <div>
                <h2 className="text-xl font-bold text-slate-900 flex items-center gap-2">
                  <span className="w-9 h-9 rounded-xl bg-gradient-to-br from-indigo-500 to-sky-600 flex items-center justify-center shadow-md shadow-indigo-500/20">
                    <Icon name="clipboard" className="w-4 h-4 text-white" />
                  </span>
                  Quản lý Nộp bài & Clipboard Dùng chung
                </h2>
                <p className="text-sm text-slate-500 mt-1.5 flex items-center gap-2 flex-wrap">
                  {wsStatus === 'connected' ? (
                    <span className="inline-flex items-center gap-1.5 bg-emerald-50 text-emerald-700 px-2.5 py-0.5 rounded-md font-bold text-xs border border-emerald-200 shadow-2xs">
                      <span className="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                      Real-time Live ({onlineUsers} online)
                    </span>
                  ) : wsStatus === 'connecting' ? (
                    <span className="inline-flex items-center gap-1.5 bg-amber-50 text-amber-700 px-2.5 py-0.5 rounded-md font-bold text-xs border border-amber-200">
                      <span className="w-2 h-2 rounded-full bg-amber-500 animate-spin"></span>
                      Đang kết nối lại...
                    </span>
                  ) : (
                    <span className="inline-flex items-center gap-1.5 bg-rose-50 text-rose-700 px-2.5 py-0.5 rounded-md font-bold text-xs border border-rose-200">
                      <span className="w-2 h-2 rounded-full bg-rose-500"></span>
                      Offline (Lưu tạm máy)
                    </span>
                  )}
                  <span className="bg-sky-50 text-sky-700 px-2 py-0.5 rounded-md font-bold text-xs border border-sky-200">KIS: {kisList.length}/100</span>
                  <span className="bg-purple-50 text-purple-700 px-2 py-0.5 rounded-md font-bold text-xs border border-purple-200">Q&A: {qaList.length}/100</span>
                  <span className="bg-indigo-50 text-indigo-700 px-2 py-0.5 rounded-md font-bold text-xs border border-indigo-200">TRAKE: {trakeList.length}/100</span>
                  <span className="bg-amber-50 text-amber-700 px-2 py-0.5 rounded-md font-bold text-xs border border-amber-200">Note: {noteList.length}</span>
                </p>
              </div>
              {hasItems && (
                <button
                  type="button"
                  onClick={handleClear}
                  onBlur={() => setTimeout(() => setConfirmClear(false), 150)}
                  className={`flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-bold border transition-all shadow-sm ${confirmClear
                    ? 'bg-rose-600 text-white border-rose-500 hover:bg-rose-700'
                    : 'bg-white text-rose-600 border-rose-200 hover:bg-rose-50'
                    }`}
                >
                  <Icon name="trash-2" className="w-4 h-4" />
                  {confirmClear ? 'Xác nhận xóa toàn bộ Clipboard' : 'Xóa toàn bộ Clipboard'}
                </button>
              )}
            </div>

            {/* Tabs Header */}
            <div className="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
              <div className="flex items-stretch border-b border-slate-200 bg-slate-50/70 px-2 pt-2 gap-1 overflow-x-auto">
                {tabs.map(({ key, label, icon, count, color }, tabIdx) => {
                  const isActive = activeTab === key;
                  const borderActiveCls = isActive
                    ? (color === 'sky' ? 'border-sky-600 text-sky-700 bg-sky-50/70' :
                      color === 'purple' ? 'border-purple-600 text-purple-700 bg-purple-50/70' :
                        color === 'indigo' ? 'border-indigo-600 text-indigo-700 bg-indigo-50/70' :
                          color === 'amber' ? 'border-amber-500 text-amber-700 bg-amber-50/70' :
                            'border-slate-600 text-slate-700 bg-slate-100')
                    : 'border-transparent text-slate-500 hover:text-slate-700';

                  const badgeActiveCls = isActive
                    ? (color === 'sky' ? 'bg-sky-600 text-white' :
                      color === 'purple' ? 'bg-purple-600 text-white' :
                        color === 'indigo' ? 'bg-indigo-600 text-white' :
                          color === 'amber' ? 'bg-amber-500 text-white' :
                            'bg-slate-600 text-white')
                    : 'bg-slate-200 text-slate-600';

                  return (
                    <button
                      key={key}
                      type="button"
                      onClick={() => setActiveTab(key)}
                      className={`relative shrink-0 flex items-center justify-center gap-1.5 px-4 py-2.5 text-xs font-bold rounded-t-xl border-b-2 -mb-px transition-all ${borderActiveCls} ${isActive ? 'shadow-[inset_0_1px_0_0_rgba(255,255,255,0.6)]' : ''}`}
                    >
                      <Icon name={icon} className="w-3.5 h-3.5 shrink-0" />
                      <span>{label}</span>
                      {(count !== undefined && count > 0) && (
                        <span className={`min-w-[18px] h-[18px] px-1.5 rounded-full text-[10px] font-bold flex items-center justify-center ${badgeActiveCls}`}>
                          {count}
                        </span>
                      )}
                    </button>
                  );
                })}
              </div>

              {/* ========================================================= */}
              {/* TAB 1: 1. Textual KIS (query-X-kis.csv) */}
              {/* ========================================================= */}
              {activeTab === 'kis' && (
                <div className="p-5 space-y-4">
                  {/* Task Specification Info Box */}
                  <div className="bg-sky-50/80 border border-sky-200 rounded-xl p-3.5 flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs">
                    <div className="space-y-1">
                      <div className="font-bold text-sky-900 flex items-center gap-1.5">
                        <Icon name="search" className="w-4 h-4 text-sky-600" />
                        <span>Nhiệm vụ 1: Textual Known Item Search (Textual KIS)</span>
                      </div>
                      <p className="text-sky-700">
                        Quy chuẩn file: <strong className="font-mono bg-white/80 px-1.5 py-0.5 rounded text-sky-900 border border-sky-200">query-X-kis.csv</strong> · Cú pháp: <code className="font-mono bg-white/80 px-1.5 py-0.5 rounded text-sky-900 border border-sky-200">{'<video_id>,<frame_idx>'}</code> · Tối đa 100 dòng, không header.
                      </p>
                    </div>
                    <div className="flex items-center gap-2 shrink-0 flex-wrap">
                      <button
                        type="button"
                        onClick={onAutoFillKisTop100}
                        disabled={kisList.length >= 100 || !searchResultsCount}
                        className="px-3 py-1.5 bg-gradient-to-r from-sky-600 to-indigo-600 hover:from-sky-700 hover:to-indigo-700 disabled:from-slate-200 disabled:to-slate-300 disabled:text-slate-400 text-white font-bold rounded-lg shadow-sm flex items-center gap-1.5 transition-all active:scale-95 text-xs"
                        title={searchResultsCount ? "Tự động điền các kết quả từ trang tìm kiếm cho đủ 100 ảnh" : "Chưa có kết quả tìm kiếm để điền"}
                      >
                        <Icon name="zap" className="w-3.5 h-3.5 text-amber-300" />
                        <span>{kisList.length >= 100 ? 'Đã đủ 100/100' : `Auto-fill Top 100 (${kisList.length}/100)`}</span>
                      </button>
                      <button
                        type="button"
                        onClick={handleCopyKisCsv}
                        disabled={kisList.length === 0}
                        className="px-3 py-1.5 bg-white hover:bg-sky-100 disabled:opacity-50 text-sky-700 font-bold rounded-lg border border-sky-300 flex items-center gap-1 shadow-xs transition-all active:scale-95"
                        title="Sao chép nội dung CSV KIS vào Clipboard"
                      >
                        <Icon name="clipboard" className="w-3.5 h-3.5" />
                        <span>Sao chép CSV</span>
                      </button>
                      <button
                        type="button"
                        onClick={handleExportKisCsv}
