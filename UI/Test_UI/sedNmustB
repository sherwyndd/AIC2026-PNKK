                <p className="text-sm text-slate-600 mb-4">Có lỗi nội bộ khi render giao diện: <span className="font-mono text-xs break-all">{String(this.state.error)}</span></p>
                <div className="flex items-center justify-center gap-2">
                  <button onClick={() => location.reload()} className="py-2 px-4 bg-sky-600 text-white rounded">Tải lại</button>
                  <button onClick={this.reset} className="py-2 px-4 bg-slate-100 border rounded">Đóng thông báo</button>
                </div>
              </div>
            </div>
          );
        }
        return this.props.children;
      }
    }

