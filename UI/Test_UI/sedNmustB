    function ResultGridImage({ src, alt, lazy }) {
      const MAX_RETRY = 2;
      const [state, setState] = React.useState('loading'); // loading | loaded | error
      const [retryCount, setRetryCount] = React.useState(0);
      const [curSrc, setCurSrc] = React.useState(src);

      React.useEffect(() => { setState('loading'); setRetryCount(0); setCurSrc(src); }, [src]);

      const handleLoad = () => setState('loaded');
      const handleError = () => {
        if (retryCount < MAX_RETRY) {
          const next = retryCount + 1;
          setRetryCount(next);
          const sep = src.includes('?') ? '&' : '?';
          setCurSrc(src + sep + '__retry=' + next + '_' + Date.now());
          setState('loading');
