                        Vào tab TRAKE → Chạy giải Dynamic Programming → Nhấn <span className="font-semibold text-indigo-600">"Add to Ranking"</span> hoặc bấm nút <span className="font-semibold text-indigo-600">"Auto-fill Top 100"</span> ở trên để nạp nhanh.
                      </p>
                    </div>
                  ) : (
                    <>
                      <div className="flex items-center justify-between text-xs text-slate-500 px-1">
                        <span>Đang có <strong className="text-slate-800">{trakeList.length}</strong> / 100 chuỗi video TRAKE</span>
                        {onClearTrake && (
                          <button
                            type="button"
                            onClick={onClearTrake}
                            className="text-rose-600 hover:text-rose-800 font-semibold hover:underline"
                          >
                            Xóa danh sách TRAKE
                          </button>
                        )}
                      </div>
                      <div className="border border-slate-200 rounded-xl overflow-hidden divide-y divide-slate-100 bg-white shadow-xs">
                        {trakeList.map((item, idx) => {
                          const isFirst = idx === 0;
                          const isLast = idx === trakeList.length - 1;
                          const rank = idx + 1;
                          const rankBadgeCls = buildRankingBadgeCls(rank);
                          const vidId = item.video_id || item.videoId || 'Unknown';
                          const timeline = item.timeline || [];

                          return (
                            <div key={vidId + '_' + idx} className="group flex flex-col sm:flex-row sm:items-center justify-between gap-3 px-3 py-3 hover:bg-indigo-50/40 transition-colors">
                              <div className="flex items-center gap-3 min-w-0">
                                <div
                                  onClick={() => { setJumpingTrakeIdx(idx); setTargetTrakeRank(String(idx + 1)); }}
                                  title="Click để chuyển nhanh thứ hạng"
                                  className={`shrink-0 w-8 h-8 rounded-lg border flex items-center justify-center text-xs font-bold font-mono cursor-pointer hover:scale-105 transition-transform ${rankBadgeCls}`}
                                >
                                  {rank}
                                </div>
                                <div className="min-w-0">
                                  <div className="text-xs font-mono font-bold text-slate-800 flex items-center gap-2">
                                    <span>{vidId}</span>
                                    {item.global_score !== undefined && (
                                      <span className="text-[10px] bg-slate-100 text-slate-600 px-1.5 py-0.2 rounded font-normal font-sans">
                                        Score: {Number(item.global_score).toFixed(3)}
                                      </span>
                                    )}
                                  </div>
                                  {/* Event Sequence Chips */}
                                  <div className="flex items-center gap-1.5 mt-1.5 flex-wrap">
                                    {timeline.map((f, fIdx) => (
                                      <span key={fIdx} className="inline-flex items-center gap-1 bg-indigo-100/70 border border-indigo-200 text-indigo-900 text-[10px] font-mono px-2 py-0.5 rounded-md">
                                        <span className="font-bold text-indigo-700">{f.event_id || `E${fIdx + 1}`}:</span>
                                        <span>F#{f.frame_idx !== undefined ? f.frame_idx : f.frameId}</span>
                                      </span>
                                    ))}
                                  </div>
                                </div>
                              </div>

                              <div className="shrink-0 flex items-center gap-1 self-end sm:self-center">
                                {jumpingTrakeIdx === idx ? (
                                  <div className="flex items-center gap-1 bg-indigo-50 border border-indigo-300 rounded-lg p-0.5 shadow-sm">
                                    <span className="text-[10px] font-bold text-indigo-900 ml-1">#</span>
                                    <input
                                      type="number"
                                      min="1"
                                      max={trakeList.length}
                                      value={targetTrakeRank}
                                      onChange={(e) => setTargetTrakeRank(e.target.value)}
                                      onKeyDown={(e) => {
                                        if (e.key === 'Enter') handleConfirmTrakeJump(idx);
                                        if (e.key === 'Escape') setJumpingTrakeIdx(null);
                                      }}
                                      autoFocus
                                      className="w-12 h-6 text-xs font-mono font-bold px-1 rounded border border-indigo-300 bg-white text-center focus:outline-none focus:ring-1 focus:ring-indigo-500"
                                      placeholder="1-100"
                                    />
                                    <button
                                      type="button"
                                      onClick={() => handleConfirmTrakeJump(idx)}
                                      className="w-6 h-6 rounded bg-indigo-600 hover:bg-indigo-700 text-white flex items-center justify-center text-[10px] font-bold"
                                      title="Chuyển đến hạng này"
                                    >
                                      ✓
                                    </button>
                                    <button
                                      type="button"
                                      onClick={() => setJumpingTrakeIdx(null)}
                                      className="w-6 h-6 rounded bg-slate-200 hover:bg-slate-300 text-slate-700 flex items-center justify-center text-[10px]"
                                      title="Hủy"
                                    >
                                      ✕
                                    </button>
                                  </div>
                                ) : (
                                  <button
                                    type="button"
                                    onClick={() => { setJumpingTrakeIdx(idx); setTargetTrakeRank(String(idx + 1)); }}
                                    title={`Chuyển nhanh thứ hạng cho chuỗi video này (Hiện tại: #${rank})`}
                                    className="w-7 h-7 rounded-md flex items-center justify-center bg-indigo-50 hover:bg-indigo-600 text-indigo-700 hover:text-white font-mono text-[11px] font-bold transition-all shadow-2xs"
                                  >
                                    #
                                  </button>
                                )}
                                <button
                                  type="button"
                                  onClick={() => onOpenTrakeForVidResult && onOpenTrakeForVidResult(item)}
                                  className="px-2.5 py-1.5 bg-indigo-50 hover:bg-indigo-600 text-indigo-700 hover:text-white font-bold text-xs rounded-lg flex items-center gap-1 transition-all"
                                  title="Mở toàn bộ chuỗi sự kiện trong Scrubber"
                                >
                                  <Icon name="sliders" className="w-3.5 h-3.5" />
                                  <span>Scrubber</span>
                                </button>
                                <button
                                  type="button"
                                  onClick={() => onMoveTrakeUp && onMoveTrakeUp(idx)}
                                  disabled={isFirst}
                                  title="Đổi thứ hạng lên"
                                  className={`w-7 h-7 rounded-md flex items-center justify-center transition-all ${isFirst ? 'bg-slate-100 text-slate-300' : 'bg-indigo-50 hover:bg-indigo-600 text-indigo-700 hover:text-white'}`}
                                >
                                  {arrowUp}
                                </button>
                                <button
                                  type="button"
                                  onClick={() => onMoveTrakeDown && onMoveTrakeDown(idx)}
                                  disabled={isLast}
                                  title="Đổi thứ hạng xuống"
                                  className={`w-7 h-7 rounded-md flex items-center justify-center transition-all ${isLast ? 'bg-slate-100 text-slate-300' : 'bg-indigo-50 hover:bg-indigo-600 text-indigo-700 hover:text-white'}`}
                                >
                                  {arrowDown}
                                </button>
                                <button
                                  type="button"
                                  onClick={() => onRemoveTrakeItem && onRemoveTrakeItem(idx)}
                                  title="Xóa khỏi TRAKE"
                                  className="w-7 h-7 rounded-md flex items-center justify-center bg-rose-50 hover:bg-rose-600 text-rose-600 hover:text-white transition-all ml-0.5"
                                >
                                  <Icon name="trash-2" className="w-3.5 h-3.5" />
                                </button>
                              </div>
                            </div>
                          );
                        })}
                      </div>
                    </>
                  )}
                </div>
              )}

              {/* ========================================================= */}
              {/* TAB 4: Note — Ảnh đã Note (grid ảnh thumbnail) */}
              {/* ========================================================= */}
              {activeTab === 'note' && (
                <div className="p-5 space-y-4">
                  <div className="flex items-start justify-between gap-3">
                    <div className="flex-1">
                      <label className="block text-[11px] font-bold text-slate-600 mb-1.5 flex items-center gap-1">
                        <Icon name="bookmark" className="w-3.5 h-3.5 text-amber-600" />
                        Ghi chú cá nhân (được lưu tự động)
                      </label>
                      <textarea
                        value={clipboard.noteText || ''}
                        onChange={(e) => onSetNoteText && onSetNoteText(e.target.value)}
                        placeholder="Ghi chú suy nghĩ, mốc thời gian, checklist nộp bài..."
                        rows={3}
                        className="w-full resize-y rounded-xl border border-slate-200 bg-amber-50/40 px-3 py-2 text-xs font-mono leading-relaxed text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-amber-400/30 focus:border-amber-400 shadow-xs"
                      />
                    </div>
                  </div>
                  <div className="flex items-center justify-between px-1">
                    <h3 className="text-sm font-bold text-slate-800 flex items-center gap-2">
                      <Icon name="bookmark" className="w-4 h-4 text-amber-600" />
                      Ảnh đã Note
                      <span className="text-[10px] font-semibold text-slate-400 uppercase tracking-wider">
                        {noteList.length}/{MAX_SAVED_IMAGES}
                      </span>
                    </h3>
                  </div>
                  {noteList.length === 0 ? (
                    <div className="text-center py-14 text-slate-400">
                      <Icon name="bookmark" className="w-10 h-10 mx-auto mb-3 opacity-30" />
                      <p className="text-sm font-semibold text-slate-500">Chưa có ảnh nào được Note</p>
                      <p className="text-xs mt-1">Mở ảnh kết quả → bấm <strong className="text-amber-600">Note</strong> để lưu</p>
                    </div>
                  ) : (
                    <div className="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-3">
                      {[...noteList].reverse().map((img) => (
                        <div key={img.id} className="group relative rounded-xl overflow-hidden bg-slate-100 border border-slate-200 hover:border-amber-400 hover:shadow-lg transition-all cursor-pointer"
                          onClick={() => onSelectImage(img)}>
                          <div className="aspect-video relative">
                            <img src={img.thumbnailUrl} alt={img.keyframe_id} className="w-full h-full object-cover"
                              onError={(e) => { e.target.style.display = 'none'; }} />
                            <div className="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent opacity-80" />
                            <button
                              type="button"
                              onClick={(e) => { e.stopPropagation(); onRemoveImage(img.id); }}
                              className="absolute top-1.5 right-1.5 w-6 h-6 rounded-full bg-black/40 hover:bg-rose-600 text-white flex items-center justify-center opacity-0 group-hover:opacity-100 transition-all"
                              title="Xóa"
                            >
                              <Icon name="x" className="w-3.5 h-3.5" />
                            </button>
                            <div className="absolute bottom-0 left-0 right-0 p-2">
                              <p className="text-[10px] font-bold text-white truncate">{img.videoId}</p>
                              <p className="text-[9px] text-white/70 font-mono truncate">{img.keyframe_id || `Frame #${img.frameId}`}</p>
                            </div>
                          </div>
                          <div className="px-2 py-1.5 bg-white flex items-center justify-between text-[10px] text-slate-400">
                            <span>{formatRelativeTime(img.savedAt)}</span>
                          </div>
                        </div>
                      ))}
                    </div>
                  )}
                </div>
              )}

              {/* ========================================================= */}
              {/* TAB 5: Query History */}
              {/* ========================================================= */}
              {activeTab === 'history' && (
                <div className="p-5 space-y-3">
                  <div className="px-1 mb-2 flex items-center justify-between">
                    <h3 className="text-sm font-bold text-slate-800 flex items-center gap-2">
                      <Icon name="history" className="w-4 h-4 text-indigo-600" />
                      Query History
                      <span className="text-[10px] font-semibold text-slate-400 uppercase tracking-wider">max {MAX_QUERY_HISTORY}</span>
                    </h3>
                  </div>
                  {historyList.length === 0 ? (
                    <div className="text-center py-14 text-slate-400">
                      <Icon name="search" className="w-10 h-10 mx-auto mb-3 opacity-30" />
                      <p className="text-sm font-semibold text-slate-500">Chưa có truy vấn nào được lưu</p>
                      <p className="text-xs mt-1">Search thành công sẽ tự lưu vào đây</p>
                    </div>
                  ) : (
                    historyList.map((entry) => (
                      <div key={entry.id} className="group rounded-xl border border-slate-200 hover:border-indigo-300 hover:shadow-md transition-all p-4 bg-white">
                        <div className="flex items-start justify-between gap-3 mb-3">
                          <div className="flex flex-wrap gap-1.5">
                            {(entry.sourcesUsed || []).map((src) => {
                              const meta = SOURCE_META[src] || { label: src.toUpperCase(), color: 'bg-slate-500 text-white' };
                              return (
                                <span key={src} className={`text-[10px] font-bold px-2 py-0.5 rounded-md ${meta.color}`}>
                                  {meta.label}
                                </span>
                              );
                            })}
                            <span className="text-[10px] font-mono text-slate-400 bg-slate-100 px-2 py-0.5 rounded-md">
                              Top-{entry.topK} · {entry.resultCount} kết quả
                            </span>
                          </div>
                          <span className="text-[11px] text-slate-400 shrink-0">{formatRelativeTime(entry.savedAt)}</span>
                        </div>
                        <div className="space-y-2 mb-3">
                          {entry.panels.map((p, i) => {
                            const meta = PANEL_TYPE_META[p.type] || PANEL_TYPE_META.text;
                            return (
                              <div key={i} className="flex items-start gap-2 text-sm">
                                <span className={`text-[10px] font-bold px-1.5 py-0.5 rounded border shrink-0 ${meta.color}`}>{meta.label}</span>
                                <span className="text-slate-700 line-clamp-2 leading-snug">{p.query}</span>
                              </div>
                            );
                          })}
                        </div>
                        <div className="flex items-center justify-between">
                          {entry.queryTime && (
                            <span className="text-[11px] text-slate-400 font-mono">{entry.queryTime}s</span>
                          )}
                          <button
                            type="button"
                            onClick={() => onRestoreQuery(entry)}
                            className="ml-auto text-xs font-bold text-indigo-700 bg-indigo-50 hover:bg-indigo-100 border border-indigo-200 px-3 py-1.5 rounded-lg transition-colors"
                          >
                            Tải lại query →
                          </button>
                        </div>
                      </div>
                    ))
                  )}
                </div>
              )}

            </div>
          </div>
        </div>
      );
    }

    /**
     * TrakeSidebar:
     * Cột bên trái quản lý Stage/Event của TRAKE, hỗ trợ đa modality (Text, OCR, ASR)
     * per-stage giống temporal_search.py, có thể bật/tắt hoặc nhập query theo từng stage.
     */
    function TrakeSidebar({
      context,
      events,
      onChangeContext,
      onUpdateEvent,
      onAddEvent,
      onRemoveEvent,
      onReset,
      onSearch,
      isSearching,
      rankingCount = 0,
      noteCount = 0,
      trakeFilterSource = 'none',
      onChangeFilterSource
    }) {
      const eventListRef = React.useRef(null);

      const handleAddAndScroll = () => {
        onAddEvent();
        setTimeout(() => {
          if (eventListRef.current) {
            eventListRef.current.scrollTop = eventListRef.current.scrollHeight;
          }
        }, 80);
      };

      return (
        <aside className="w-80 md:w-96 bg-slate-50 border-r border-slate-200 flex flex-col h-[calc(100vh-3.5rem)] sticky top-14 shrink-0">
          {/* Top Panel Header */}
          <div className="p-3 border-b border-slate-200 bg-white flex items-center justify-between">
            <div className="flex items-center gap-2">
              <div className="w-6 h-6 rounded-lg bg-indigo-600 text-white flex items-center justify-center shadow-xs">
                <Icon name="clock" className="w-3.5 h-3.5" />
              </div>
              <h2 className="font-bold text-xs tracking-wide text-slate-800 uppercase">
                TRAKE Stage Search
              </h2>
              <span className="bg-indigo-100 text-indigo-800 text-[10px] font-bold px-1.5 py-0.5 rounded-full">
                {events.length} Mốc
              </span>
            </div>

            <button
              type="button"
              onClick={onReset}
              className="text-slate-400 hover:text-rose-600 p-1 rounded-lg hover:bg-slate-100 transition-all"
              title="Đặt lại các mốc sự kiện"
            >
              <Icon name="rotate-ccw" className="w-3.5 h-3.5" />
            </button>
          </div>

          {/* Scrollable Event List */}
          <div ref={eventListRef} className="flex-1 overflow-y-auto p-3 space-y-3">
            {/* Filter Sources (Ranking / Note) */}
            {(rankingCount > 0 || noteCount > 0) && (
              <div className="bg-indigo-50/70 border border-indigo-200/80 rounded-xl p-2 space-y-1.5">
                <div className="flex items-center justify-between text-[10px] font-bold uppercase text-indigo-950">
                  <span className="flex items-center gap-1">
                    <Icon name="tag" className="w-3 h-3 text-indigo-600" /> Giới hạn Video
                  </span>
                  {trakeFilterSource !== 'none' && (
                    <span className="text-[9px] bg-indigo-600 text-white px-1.5 py-0.2 rounded font-bold">
                      Đang lọc
                    </span>
                  )}
                </div>
                <div className="flex items-center gap-1.5">
                  <button
                    type="button"
                    onClick={() => onChangeFilterSource && onChangeFilterSource('none')}
                    className={`flex-1 py-1 px-1.5 rounded-lg text-[10px] font-bold border transition-all ${trakeFilterSource === 'none'
                      ? 'bg-white text-slate-800 border-slate-300 shadow-xs'
                      : 'bg-transparent text-slate-500 border-transparent hover:bg-white/60'
                      }`}
                  >
                    Tất cả
                  </button>
                  {rankingCount > 0 && (
                    <button
                      type="button"
                      onClick={() => onChangeFilterSource && onChangeFilterSource(trakeFilterSource === 'ranking' ? 'none' : 'ranking')}
                      className={`flex-1 py-1 px-1.5 rounded-lg text-[10px] font-bold border transition-all ${trakeFilterSource === 'ranking'
                        ? 'bg-sky-600 text-white border-sky-700 shadow-xs'
                        : 'bg-white text-sky-700 border-sky-200 hover:bg-sky-50'
                        }`}
                    >
                      Ranking ({rankingCount})
                    </button>
                  )}
                  {noteCount > 0 && (
                    <button
                      type="button"
                      onClick={() => onChangeFilterSource && onChangeFilterSource(trakeFilterSource === 'note' ? 'none' : 'note')}
                      className={`flex-1 py-1 px-1.5 rounded-lg text-[10px] font-bold border transition-all ${trakeFilterSource === 'note'
                        ? 'bg-amber-600 text-white border-amber-700 shadow-xs'
                        : 'bg-white text-amber-700 border-amber-200 hover:bg-amber-50'
                        }`}
                    >
                      Note ({noteCount})
                    </button>
                  )}
                </div>
              </div>
            )}

            {/* Global Context */}
            <div className="bg-white border border-slate-200 rounded-xl p-2.5 space-y-1.5 shadow-xs">
              <label className="text-[10px] font-bold text-slate-600 uppercase tracking-wider flex items-center justify-between">
                <span>Bối cảnh chung (Context)</span>
                <span className="text-[9px] text-slate-400 normal-case">Tùy chọn</span>
              </label>
              <textarea
                value={context}
                onChange={(e) => onChangeContext(e.target.value)}
                onKeyDown={(e) => {
                  if (e.key === 'Enter' && !e.shiftKey) {
                    e.preventDefault();
                    if (onSearch) onSearch();
                  }
                }}
                placeholder="Mô tả bối cảnh chung xuyên suốt video..."
                rows={2}
                className="w-full text-xs bg-slate-50 border border-slate-200 rounded-lg p-2 focus:ring-1 focus:ring-indigo-400 focus:bg-white focus:outline-none transition-all resize-none text-slate-800 placeholder:text-slate-400"
              />
            </div>

            {/* List of Stage/Event Cards */}
            <div className="space-y-2.5">
              {events.map((ev, idx) => {
                const color = getEventColor(idx + 1);
                const activeTab = ev.activeTab || 'text';
                const hasText = Boolean(ev.text_query && ev.text_query.trim());
                const hasOcr = Boolean(ev.ocr_query && ev.ocr_query.trim());
                const hasAsr = Boolean(ev.asr_query && ev.asr_query.trim());

                const currentVal = activeTab === 'text'
                  ? (ev.text_query !== undefined ? ev.text_query : (ev.description || ''))
                  : activeTab === 'ocr'
                    ? (ev.ocr_query || '')
                    : (ev.asr_query || '');

                const tabs = [
                  { id: 'text', label: 'Text', field: 'text_query', placeholder: `Mô tả hình ảnh mốc E${idx + 1}...`, color: 'sky', icon: 'type', has: hasText },
                  { id: 'ocr', label: 'OCR', field: 'ocr_query', placeholder: `Chữ / text xuất hiện tại E${idx + 1}...`, color: 'amber', icon: 'scan-text', has: hasOcr },
                  { id: 'asr', label: 'ASR', field: 'asr_query', placeholder: `Lời thoại / âm thanh tại E${idx + 1}...`, color: 'purple', icon: 'mic', has: hasAsr },
                ];

                return (
                  <div
                    key={ev.id || idx}
                    className="bg-white border border-slate-200 rounded-2xl p-3 shadow-xs hover:border-indigo-300 transition-all space-y-2"
                  >
                    {/* Stage Card Header */}
                    <div className="flex items-center justify-between">
                      <div className="flex items-center gap-2">
                        <span className={`w-5 h-5 rounded-md ${color.badge} text-[10px] font-bold flex items-center justify-center shadow-xs`}>
                          E{idx + 1}
                        </span>
                        <span className="font-bold text-xs text-slate-800">
                          Mốc sự kiện {idx + 1}
                        </span>
                        <div className="flex items-center gap-1">
                          {hasText && (
                            <span className="px-1.5 py-0.2 rounded text-[9px] font-bold bg-sky-100 text-sky-800 border border-sky-200">
                              Text
                            </span>
                          )}
                          {hasOcr && (
                            <span className="px-1.5 py-0.2 rounded text-[9px] font-bold bg-amber-100 text-amber-800 border border-amber-200">
                              OCR
                            </span>
                          )}
                          {hasAsr && (
                            <span className="px-1.5 py-0.2 rounded text-[9px] font-bold bg-purple-100 text-purple-800 border border-purple-200">
                              ASR
                            </span>
                          )}
                        </div>
                      </div>

                      {events.length > 1 && (
                        <button
                          type="button"
                          onClick={() => onRemoveEvent(idx)}
                          className="p-1 text-slate-400 hover:text-rose-600 hover:bg-rose-50 rounded-lg transition-colors"
                          title={`Xóa mốc E${idx + 1}`}
                        >
                          <Icon name="x" className="w-3.5 h-3.5" />
                        </button>
                      )}
                    </div>

                    {/* Modality Tabs */}
                    <div className="flex items-center gap-1 bg-slate-100/90 p-1 rounded-xl border border-slate-200/80">
                      {tabs.map((tab) => {
                        const isActive = activeTab === tab.id;
                        let activeClasses = 'text-slate-500 hover:text-slate-700 hover:bg-slate-200/60';
                        if (isActive) {
                          if (tab.id === 'text') activeClasses = 'bg-white text-sky-700 border-sky-200 shadow-xs font-bold ring-1 ring-sky-300';
                          else if (tab.id === 'ocr') activeClasses = 'bg-white text-amber-700 border-amber-200 shadow-xs font-bold ring-1 ring-amber-300';
                          else if (tab.id === 'asr') activeClasses = 'bg-white text-purple-700 border-purple-200 shadow-xs font-bold ring-1 ring-purple-300';
                        }

                        return (
                          <button
                            key={tab.id}
                            type="button"
                            onClick={() => onUpdateEvent(idx, { ...ev, activeTab: tab.id })}
                            className={`flex-1 flex items-center justify-center gap-1 py-1 px-1 rounded-lg text-[10px] font-semibold transition-all relative border border-transparent ${activeClasses}`}
                          >
                            <Icon name={tab.icon} className="w-3 h-3 shrink-0" />
                            <span>{tab.label}</span>
                            {tab.has && (
                              <span
                                className={`w-1.5 h-1.5 rounded-full shrink-0 ${tab.id === 'text' ? 'bg-sky-500' : tab.id === 'ocr' ? 'bg-amber-500' : 'bg-purple-500'
                                  }`}
                              />
                            )}
                          </button>
                        );
                      })}
                    </div>

                    {/* Active Input */}
                    <div className="relative">
                      <textarea
                        value={currentVal}
                        onChange={(e) => {
                          const val = e.target.value;
                          const currentTabObj = tabs.find(t => t.id === activeTab) || tabs[0];
                          const updated = { ...ev, [currentTabObj.field]: val };
                          if (activeTab === 'text') {
                            updated.description = val;
                          }
                          onUpdateEvent(idx, updated);
                        }}
                        onKeyDown={(e) => {
                          if (e.key === 'Enter' && !e.shiftKey) {
                            e.preventDefault();
                            if (onSearch) onSearch();
                          }
                        }}
                        placeholder={tabs.find(t => t.id === activeTab)?.placeholder}
                        rows={2}
                        className="w-full text-xs font-medium text-slate-800 bg-white border border-slate-200 rounded-xl p-2 outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-200 transition-all resize-none placeholder:text-slate-400 placeholder:font-normal leading-relaxed"
                      />
                    </div>
                  </div>
                );
              })}
            </div>

            {/* "+ Thêm mốc sự kiện" Button */}
            <button
              type="button"
              onClick={handleAddAndScroll}
              className="w-full py-2.5 px-4 rounded-xl border-2 border-dashed border-slate-300 hover:border-indigo-500 hover:bg-indigo-50/50 text-slate-600 hover:text-indigo-800 font-bold text-xs flex items-center justify-center gap-1.5 transition-all shadow-xs"
            >
              <Icon name="plus" className="w-3.5 h-3.5 text-indigo-600" />
              <span>+ Thêm mốc E{events.length + 1}</span>
            </button>
          </div>

          {/* Sticky Bottom Search Action */}
          <div className="p-3 bg-white border-t border-slate-200 shadow-lg">
            <button
              type="button"
              onClick={onSearch}
              disabled={isSearching}
              className={`w-full py-2.5 px-4 text-white font-bold text-xs rounded-xl flex items-center justify-center gap-2 shadow-md transition-all ${isSearching
                ? 'bg-slate-600 cursor-wait'
                : 'bg-gradient-to-r from-indigo-600 to-violet-600 hover:shadow-lg active:scale-95'
                }`}
            >
              {isSearching ? (
                <>
                  <div className="w-3.5 h-3.5 border-2 border-white border-t-transparent rounded-full animate-spin" />
