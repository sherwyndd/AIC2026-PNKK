                  <span>Đang giải chuỗi sự kiện...</span>
                </>
              ) : (
                <>
                  <Icon name="search" className="w-4 h-4" />
                  <span>Tìm kiếm chuỗi Stage</span>
                  <span className="text-[10px] bg-white/20 px-1.5 py-0.5 rounded font-mono font-normal">Enter</span>
