          const task = this.queue.shift();
          if (!task) break;

          if (task.controller.signal.aborted) continue;

          const { key, url, controller } = task;
          this.activeRequests.set(key, controller);
          window.__keyframeLRUCache.set(key, { status: 'loading', url });
