              <span className="text-xs font-bold uppercase tracking-wider text-slate-700">
                Top Video chuỗi sự kiện khớp nhất
              </span>
              <span className="bg-emerald-100 text-emerald-800 font-bold text-[11px] px-2 py-0.5 rounded-full">
